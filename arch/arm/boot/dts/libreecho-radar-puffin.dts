		/* Devinfo efuse: factory CPU thermal calibration lives at
		 * 0x10206180 (3 u32 words). Exposed as an nvmem cell so the
		 * mtk_thermal driver can load per-chip calibration instead of
		 * falling back to generic defaults (which mis-read CPU temp). */
		efuse@10206000 {
			compatible = "mediatek,mt8163-efuse", "mediatek,efuse";
			reg = <0x00 0x10206000 0x00 0x1000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			thermal_calibration: calib@180 {
				reg = <0x180 0x0c>;
			};
		};

