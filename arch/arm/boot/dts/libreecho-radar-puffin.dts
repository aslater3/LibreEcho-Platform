			compatible = "mediatek,lcd-backlight";
			led_mode = <0x05>;
			data;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
			gpios = <0x09 0x2b 0x00>;
			status = "disabled";
		};

		mtkfb@0 {
			compatible = "mediatek,MTKFB";
			clocks = <0x0a 0x09 0x0a 0x0a 0x0a 0x0b 0x0a 0x0c 0x0a 0x0d 0x0a 0x0e 0x0a 0x17 0x0a 0x0f 0x0a 0x10 0x0a 0x11 0x0a 0x12 0x0a 0x13 0x0a 0x14 0x0a 0x20 0x0a 0x21 0x0a 0x22 0x0a 0x23 0x0a 0x24 0x0a 0x25 0x0a 0x26 0x0a 0x27 0x0a 0x28 0x0a 0x29 0x0a 0x2e 0x0a 0x2f 0x06 0x55 0x2d 0x0a 0x06 0x14 0x06 0x15 0x06 0x16 0x06 0x59 0x2d 0x06 0x06 0x2d 0x06 0x2e 0x06 0x2f 0x06 0x30 0x06 0x44>;
			clock-names = "MMSYS_CLK_FAKE_ENG\0MMSYS_CLK_DISP_OVL0\0MMSYS_CLK_DISP_OVL1\0MMSYS_CLK_DISP_RDMA0\0MMSYS_CLK_DISP_RDMA1\0MMSYS_CLK_DISP_WDMA0\0MMSYS_CLK_DISP_WDMA1\0MMSYS_CLK_DISP_COLOR\0MMSYS_CLK_DISP_CCORR\0MMSYS_CLK_DISP_AAL\0MMSYS_CLK_DISP_GAMMA\0MMSYS_CLK_DISP_DITHER\0MMSYS_CLK_DISP_UFOE\0MMSYS_CLK_DISP_PWM\0MMSYS_CLK_DISP_PWM26M\0MMSYS_CLK_DSI_ENGINE\0MMSYS_CLK_DSI_DIGITAL\0MMSYS_CLK_DPI0_PIXEL\0MMSYS_CLK_DPI0_ENGINE\0MMSYS_CLK_LVDS_PIXEL\0MMSYS_CLK_LVDS_CTS\0MMSYS_CLK_DPI1_PIXEL\0MMSYS_CLK_DPI1_ENGINE\0MMSYS_CLK_DISP_DSC_ENGINE\0MMSYS_CLK_DISP_DSC_MEM\0MMSYS_CLK_MUX_DPI0_SEL\0MMSYS_APMIXED_LVDSPLL\0MMSYS_CLK_MUX_LVDSPLL_D2\0MMSYS_CLK_MUX_LVDSPLL_D4\0MMSYS_CLK_MUX_LVDSPLL_D8\0MMSYS_CLK_MUX_DPI1_SEL\0MMSYS_APMIXED_TVDPLL\0MMSYS_CLK_MUX_TVDPLL_D2\0MMSYS_CLK_MUX_TVDPLL_D4\0MMSYS_CLK_MUX_TVDPLL_D8\0MMSYS_CLK_MUX_TVDPLL_D16\0MMSYS_CLK_PWM_SEL";
			status = "disabled";
		};

		ice_debug {
			compatible = "mediatek,mt8163-ice_debug\0mediatek,mt8173-ice_debug";
			clocks = <0x05 0x2f>;
			clock-names = "ice_dbg";
			status = "disabled";
		};

		bat_meter {
			compatible = "mediatek,bat_meter";
			vbat_channel_number = <0x07>;
			isense_channel_number = <0x06>;
			vbattemp_channel_number = <0x05>;
			vcharger_channel_number = <0x04>;
			swchr_power_path = <0x00>;
			external_swchr_support = <0x00>;
			r_bat_sense = <0x04>;
			r_i_sense = <0x04>;
			r_charger_1 = <0x14a>;
			r_charger_2 = <0x27>;
			temperature_t0 = <0x6e>;
			temperature_t1 = <0x00>;
			temperature_t1_5 = <0x0a>;
			temperature_t2 = <0x19>;
			temperature_t3 = <0x32>;
			temperature_t = <0xff>;
			fg_meter_resistance = <0x00>;
			q_max_pos_50 = <0x5f3>;
			q_max_pos_25 = <0x5d1>;
			q_max_pos_10 = <0x5d1>;
			q_max_pos_0 = <0x4f8>;
			q_max_neg_10 = <0x4a5>;
			q_max_pos_50_h_current = <0x5e7>;
			q_max_pos_25_h_current = <0x5b6>;
			q_max_pos_10_h_current = <0x5b6>;
			q_max_pos_0_h_current = <0x332>;
			q_max_neg_10_h_current = <0x95>;
			oam_d5 = <0x01>;
			change_tracking_point = <0x01>;
			cust_tracking_point = <0x01>;
			cust_r_sense = <0x44>;
			cust_hw_cc = <0x00>;
			aging_tuning_value = <0x64>;
			cust_r_fg_offset = <0x00>;
			ocv_board_compesate = <0x00>;
			r_fg_board_base = <0x3e8>;
			r_fg_board_slope = <0x3e8>;
			car_tune_value = <0x64>;
			current_detect_r_fg = <0x0a>;
			minerroroffset = <0x3e8>;
			fg_vbat_average_size = <0x12>;
			r_fg_value = <0x0a>;
			cust_poweron_delta_capacity_tolrance = <0x1e>;
			cust_poweron_low_capacity_tolrance = <0x05>;
			cust_poweron_max_vbat_tolrance = <0x5a>;
			cust_poweron_delta_vbat_tolrance = <0x1e>;
			cust_poweron_delta_hw_sw_ocv_capacity_tolrance = <0x0a>;
			fixed_tbat_25 = <0x00>;
			vbat_normal_wakeup = <0xe10>;
			vbat_low_power_wakeup = <0xdac>;
			normal_wakeup_period = <0x1518>;
			low_power_wakeup_period = <0x12c>;
			close_poweroff_wakeup_period = <0x1e>;
			rbat_pull_up_r = <0x4204>;
			rbat_pull_down_r = <0x6978>;
			rbat_pull_up_volt = <0x708>;
			step_of_qmax = <0x64>;
			std_loading_current = <0x1770>;
			status = "disabled";
		};

		BAT_NOTIFY {
			compatible = "mediatek,bat_notify";
			status = "disabled";
		};

		bat_comm {
			compatible = "mediatek,battery";
			stop_charging_in_takling = <0x01>;
			talking_recharge_voltage = <0xed8>;
			talking_sync_time = <0x3c>;
			mtk_temperature_recharge_support = <0x01>;
			max_charge_temperature = <0x32>;
			max_charge_temperature_minus_x_degree = <0x2f>;
			min_charge_temperature = <0x00>;
			min_charge_temperature_plus_x_degree = <0x06>;
			err_charge_temperature = <0xff>;
			v_pre2cc_thres = <0xd48>;
			v_cc2topoff_thres = <0xfd2>;
			recharging_voltage = <0x100e>;
			charging_full_current = <0x64>;
			config_usb_if = <0x00>;
			usb_charger_current_suspend = <0x00>;
			usb_charger_current_unconfigured = <0x1b58>;
			usb_charger_current_configured = <0xc350>;
			usb_charger_current = <0xc350>;
			ac_charger_current = <0x249f0>;
			non_std_ac_charger_current = <0xc350>;
			charging_host_charger_current = <0xfde8>;
			apple_0_5a_charger_current = <0xc350>;
			apple_1_0a_charger_current = <0xfde8>;
			apple_2_1a_charger_current = <0x13880>;
			bat_low_temp_protect_enable = <0x00>;
			v_charger_enable = <0x00>;
			v_charger_max = <0x1964>;
			v_charger_min = <0x1130>;
			onehundred_percent_tracking_time = <0x0a>;
			npercent_tracking_time = <0x14>;
			sync_to_real_tracking_time = <0x3c>;
			v_0percent_tracking = <0xd7a>;
			system_off_voltage = <0xd48>;
			high_battery_voltage_support = <0x00>;
			status = "disabled";
		};

		flashlight@ {
			compatible = "mediatek,camera_flashlight";
			status = "disabled";
		};

		isp_pipemgr {
			compatible = "mediatek,mt8163-isp_pipemgr";
			status = "disabled";
		};

		isp_sysram {
			compatible = "mediatek,mt8163-isp_sysram";
			status = "disabled";
		};

		mtee {
			compatible = "mediatek,mtee";
			clocks = <0x05 0x20>;
			clock-names = "GCPU";
		};
	};

	lcm {
		compatible = "mediatek,lcm";
		status = "disabled";
	};

	memory@00000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x20000000>;
	};

	chosen {
		stdout-path = "/soc/uart0@11002000:921600n8";
		bootargs = "console=ttyS0,921600n1 root=/dev/ram initrd=0x44000200,0x200000";
	};

	mtcpufreq {
		compatible = "mediatek,mt8163-cpufreq";
		reg-ext-vproc-supply = <0x47>;
	};

	amz_privacy {
		compatible = "amazon,amz-privacy";
		gpios = <&pio 0x57 0x01>;
		hw_latch = <0x00>;
		bright-state-gpio = <&pio 0x58 0x01>;
	};

	keys {
		compatible = "gpio-keys";
		autorepeat;

		volumeup@115 {
			label = "Volume Up Key";
			linux,code = <0x73>;
			gpios = <&pio 0x32 0x01>;
			debounce-interval = <0x14>;
		};

		volumedn@114 {
			label = "Volume Down Key";
			linux,code = <0x72>;
			gpios = <&pio 0x25 0x01>;
			debounce-interval = <0x14>;
		};
	};

	thermistor@0 {
		compatible = "amazon,virtual_sensor_thermistor";
		thermistor,offset = <0x2328>;
		thermistor,offset.sign = "plus";
		thermistor,alpha = <0x0a>;
		thermistor,weight = <0xc8>;
		aux_channel_num = <0x00>;
		io-channels = <&auxadc 0x00>;
	};

	thermistor@1 {
		compatible = "amazon,virtual_sensor_thermistor";
		thermistor,offset = <0x2328>;
		thermistor,offset.sign = "plus";
		thermistor,alpha = <0x0a>;
		thermistor,weight = <0xc8>;
		aux_channel_num = <0x01>;
		io-channels = <&auxadc 0x0c>;
	};

	thermistor@2 {
		compatible = "amazon,virtual_sensor_thermistor";
		thermistor,offset = <0x2710>;
		thermistor,offset.sign = "plus";
		thermistor,alpha = <0x0a>;
		thermistor,weight = <0xc8>;
		aux_channel_num = <0x02>;
		io-channels = <&auxadc 0x0d>;
	};

};

&cpu0 {
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&mt6323_vproc_reg>;
	clocks = <&apmixedsys 0x00>;
	clock-names = "cpu";
	#cooling-cells = <0x02>;
};

&cpu1 {
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&mt6323_vproc_reg>;
	clocks = <&apmixedsys 0x00>;
	clock-names = "cpu";
	#cooling-cells = <0x02>;
};

&cpu2 {
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&mt6323_vproc_reg>;
	clocks = <&apmixedsys 0x00>;
	clock-names = "cpu";
	#cooling-cells = <0x02>;
};

&cpu3 {
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&mt6323_vproc_reg>;
	clocks = <&apmixedsys 0x00>;
	clock-names = "cpu";
	#cooling-cells = <0x02>;
};
