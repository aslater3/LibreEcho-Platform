		i2c@11009000 {
			compatible = "mediatek,mt8173-i2c";
			reg = <0x00 0x11009000 0x00 0x70 0x00 0x11000280 0x00 0x80>;
			interrupts = <0x00 0x56 0x08>;
			clock-div = <0x0a>;
			clocks = <0x05 0x0d 0x05 0x29>;
			clock-names = "main\0dma";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0x22>;

			bq24297@6b {
				compatible = "ti,bq24297";
				reg = <0x6b>;
				interrupt-parent = <0x09>;
				interrupts = <0x01 0x02>;
				pinctrl-names = "bq24297_chg_en\0bq24297_interrupt_init";
				pinctrl-0 = <0x23>;
				pinctrl-1 = <&bq24297_int_pin>;
				/* Stock 3.18 and HW32 both NACK 0x6b on Radar-Puffin. */
				status = "disabled";
			};

			tlv320aic32x4@18 {
				compatible = "ti,tlv320aic32x4";
				reg = <0x18>;
				reset-gpios = <&pio 0x33 0x00>;
				/* IOVDD/LDOIN are fed by the board's always-on 1.8 V I/O rail. */
				ldoin-supply = <0x37>;
				iov-supply = <0x37>;
				clocks = <&puffin_codec_mclk>;
				clock-names = "mclk";
			};
		};

