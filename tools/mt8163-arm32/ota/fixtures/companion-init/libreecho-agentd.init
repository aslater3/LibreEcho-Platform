#!/bin/sh
### BEGIN INIT INFO
# Provides:          libreecho-agentd
# Required-Start:    $remote_fs $network libreecho-waked libreecho-sttd libreecho-ttsd
# Required-Stop:     $remote_fs $network libreecho-waked libreecho-sttd libreecho-ttsd
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

[ -r /etc/default/libreecho-agentd ] && . /etc/default/libreecho-agentd

PAYLOAD=${PAYLOAD:-/data/libreecho/features/assistant/payload.squashfs}
RUNTIME_ROOT=${RUNTIME_ROOT:-/run/libreecho/features/assistant/root}
DAEMON=${DAEMON:-$RUNTIME_ROOT/usr/local/sbin/libreecho-agentd}
CURL=${CURL:-$RUNTIME_ROOT/usr/local/libexec/libreecho-curl}
CA_BUNDLE=${CA_BUNDLE:-$RUNTIME_ROOT/usr/local/share/libreecho/cacert.pem}
PIDFILE=${PIDFILE:-/var/run/libreecho-agentd.pid}
LOGFILE=${LOGFILE:-/var/log/libreecho-agentd.log}
SOCKET=${SOCKET:-/run/libreecho/agent.sock}
WAKE_SOCKET=${WAKE_SOCKET:-/run/libreecho/wakeword.sock}
STT_SOCKET=${STT_SOCKET:-/run/libreecho/stt.sock}
AUDIO_SOCKET=${AUDIO_SOCKET:-/run/libreecho/audio.sock}
TTS_SOCKET=${TTS_SOCKET:-/run/libreecho/tts.sock}
AGENT_DEPENDENCY_TIMEOUT_SECONDS=${AGENT_DEPENDENCY_TIMEOUT_SECONDS:-90}
AGENT_DEPENDENCY_POLL_SECONDS=${AGENT_DEPENDENCY_POLL_SECONDS:-1}
FEATURE_POLICY_FILE=${FEATURE_POLICY_FILE:-/etc/libreecho/feature-policy}
case "$AGENT_DEPENDENCY_TIMEOUT_SECONDS" in
    ''|*[!0-9]*) AGENT_DEPENDENCY_TIMEOUT_SECONDS=90 ;;
esac
case "$AGENT_DEPENDENCY_POLL_SECONDS" in
    ''|*[!0-9]*|0) AGENT_DEPENDENCY_POLL_SECONDS=1 ;;
esac

mount_runtime() {
    [ -f "$PAYLOAD" ] || {
        echo "libreecho-agentd: feature payload missing: $PAYLOAD" >&2
        return 1
    }
    mkdir -p "$RUNTIME_ROOT"
    if grep -q " $RUNTIME_ROOT " /proc/mounts 2>/dev/null; then
        return 0
    fi
    mount -t squashfs -o loop,ro,nosuid,nodev,noatime \
        "$PAYLOAD" "$RUNTIME_ROOT" || {
        echo "libreecho-agentd: feature payload mount failed" >&2
        return 1
    }
}

unmount_runtime() {
    umount "$RUNTIME_ROOT" 2>/dev/null || true
}

# Every pid whose argv[0] is exactly $DAEMON. A pidfile is not proof of life:
# it goes stale when the daemon is started from a shell that then exits (the
# fallback branch of start_service() leaves the child in the caller's process
# group), and it goes missing when /run is cleared. Matching on the executable
# means stop and status still see the daemon in both cases, so restart cannot
# silently leave a second copy running.
running_pids() {
    for entry in /proc/[0-9]*; do
        candidate=${entry#/proc/}
        [ "$candidate" = "$$" ] && continue
        [ -r "$entry/cmdline" ] || continue
        argv0=$(tr '\0' '\n' < "$entry/cmdline" 2>/dev/null | sed -n '1p')
        [ "$argv0" = "$DAEMON" ] && printf '%s\n' "$candidate"
    done
}

pidfile_pid() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s\n' "$pid"
}

is_running() {
    pidfile_pid >/dev/null && return 0
    [ -n "$(running_pids)" ]
}

# Sends TERM, waits up to $2 seconds (default 5), then KILL.
terminate() {
    target=$1
    limit=${2:-5}
    kill "$target" 2>/dev/null || true
    count=0
    while kill -0 "$target" 2>/dev/null && [ "$count" -lt "$limit" ]; do
        sleep 1
        count=$((count + 1))
    done
    kill -KILL "$target" 2>/dev/null || true
}

dependency_sockets_ready() {
    if [ "$(feature_policy)" != redistributable ] && [ ! -S "$WAKE_SOCKET" ]; then
        return 1
    fi
    [ -S "$STT_SOCKET" ] &&
        [ -S "$AUDIO_SOCKET" ] &&
        [ -S "$TTS_SOCKET" ]
}

feature_policy() {
    sed -n '1p' "$FEATURE_POLICY_FILE" 2>/dev/null
}

missing_dependency_sockets() {
    missing=
    for dependency in \
        "stt:$STT_SOCKET" \
        "audio:$AUDIO_SOCKET" \
        "tts:$TTS_SOCKET"; do
        name=${dependency%%:*}
        path=${dependency#*:}
        if [ ! -S "$path" ]; then
            if [ -n "$missing" ]; then
                missing="$missing,$name"
            else
                missing=$name
            fi
        fi
    done
    if [ "$(feature_policy)" != redistributable ] && [ ! -S "$WAKE_SOCKET" ]; then
        if [ -n "$missing" ]; then missing="wakeword,$missing"; else missing=wakeword; fi
    fi
    printf '%s\n' "$missing"
}

wait_for_dependency_sockets() {
    elapsed=0
    while ! dependency_sockets_ready; do
        if [ "$elapsed" -ge "$AGENT_DEPENDENCY_TIMEOUT_SECONDS" ]; then
            echo "libreecho-agentd: dependencies not ready after ${AGENT_DEPENDENCY_TIMEOUT_SECONDS}s: $(missing_dependency_sockets)" >&2
            return 1
        fi
        remaining=$((AGENT_DEPENDENCY_TIMEOUT_SECONDS - elapsed))
        poll_seconds=$AGENT_DEPENDENCY_POLL_SECONDS
        if [ "$poll_seconds" -gt "$remaining" ]; then
            poll_seconds=$remaining
        fi
        sleep "$poll_seconds"
        elapsed=$((elapsed + poll_seconds))
    done
}

start_service() {
    if is_running; then echo "libreecho-agentd already running"; return 0; fi
    mount_runtime || return 1
    [ -x "$DAEMON" ] && [ -x "$CURL" ] && [ -r "$CA_BUNDLE" ] || {
        echo "libreecho-agentd: incomplete assistant runtime" >&2
        unmount_runtime
        return 1
    }
    wait_for_dependency_sockets || {
        unmount_runtime
        return 1
    }
    mkdir -p /data/libreecho/config /data/libreecho/secrets \
        "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")" "$(dirname "$SOCKET")"
    chmod 0700 /data/libreecho/secrets
    export LE_AGENT_CA_BUNDLE="$CA_BUNDLE"
    if [ -r /data/libreecho/config/web-config.json ] &&
        grep -q '"voice_pipeline_mode"[[:space:]]*:[[:space:]]*"custom"' \
            /data/libreecho/config/web-config.json; then
        export LE_AGENT_TTS_AGGREGATE=1
    fi
    ARGS=${ARGS:---socket $SOCKET --curl $CURL}
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS \
            </dev/null >>"$LOGFILE" 2>&1
    else
        # setsid detaches the child from this shell's process group. Without it
        # the daemon dies with the shell that started it -- which is why a
        # restart issued over adb or ssh appeared to work and then evaporated.
        if command -v setsid >/dev/null 2>&1; then
            setsid "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        else
            "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        fi
        launched=$!
        echo "$launched" >"$PIDFILE"
        # setsid normally execs the daemon in-place, so the common case resolves
        # immediately. If it forks, poll briefly for the real daemon instead of
        # delaying every service start by a fixed second.
        started=
        count=0
        while [ "$count" -lt 20 ]; do
            if [ -r "/proc/$launched/cmdline" ]; then
                argv0=$(tr '\0' '\n' < "/proc/$launched/cmdline" 2>/dev/null | sed -n '1p')
                if [ "$argv0" = "$DAEMON" ]; then
                    started=$launched
                    break
                fi
            fi
            started=$(running_pids | sort -n | sed -n '1p')
            [ -n "$started" ] && break
            sleep 0.05
            count=$((count + 1))
        done
        [ -n "$started" ] && echo "$started" >"$PIDFILE"
    fi
}

stop_service() {
    if pidfile_pid >/dev/null && command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -K -p "$PIDFILE" -R TERM/10/KILL/2
    else
        pid=$(pidfile_pid) && terminate "$pid" 10
    fi
    # Sweep anything the pidfile did not account for. Without this a lost or
    # stale pidfile made stop a no-op that still reported success, and the
    # following start added a second daemon instead of replacing the first.
    for stray in $(running_pids); do
        terminate "$stray" 10
    done
    rm -f "$PIDFILE" "$SOCKET"
    unmount_runtime
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; start_service ;;
    status) if is_running; then echo "running"; else echo "stopped"; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
