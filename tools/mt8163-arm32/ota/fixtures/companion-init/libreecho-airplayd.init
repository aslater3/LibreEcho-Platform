#!/bin/sh
### BEGIN INIT INFO
# Provides:          libreecho-airplayd
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: LibreEcho AirPlay 2 integration controller
### END INIT INFO

[ -r /etc/default/libreecho-airplayd ] && . /etc/default/libreecho-airplayd

DAEMON=${DAEMON:-/usr/local/sbin/libreecho-airplayd}
PIDFILE=${PIDFILE:-/var/run/libreecho-airplayd.pid}
LOGFILE=${LOGFILE:-/var/log/libreecho-airplayd.log}
LOG_MAX_BYTES=${LOG_MAX_BYTES:-2097152}
LOG_KEEP_BYTES=${LOG_KEEP_BYTES:-262144}
SOCKET=${SOCKET:-/run/libreecho/airplay.sock}
PAYLOAD=${PAYLOAD:-/data/libreecho/features/airplay2/payload.squashfs}
RUNTIME_ROOT=${RUNTIME_ROOT:-/run/libreecho/features/airplay2/root}
CONFIG=${CONFIG:-/data/libreecho/config/web-config.json}
AVAHI_SERVICES_SOURCE=${AVAHI_SERVICES_SOURCE:-/data/libreecho/features/airplay2/avahi-services}
# Discovery is an external dependency: the shared libreecho-mdnsd supervisor
# owns D-Bus, Avahi and every published record. This wrapper never starts,
# stops or mounts a responder of its own; it only stages its AirPlay service
# definitions where that supervisor reads them and reports its readiness.
MDNS_INIT=${MDNS_INIT:-/etc/init.d/libreecho-mdnsd.init}
MDNS_SOCKET=${MDNS_SOCKET:-/run/libreecho/mdns.sock}
MDNS_SERVICES_DIR=${MDNS_SERVICES_DIR:-/usr/local/lib/libreecho-mdns/root/etc/avahi/services}
MDNS_BUS_SOURCE=${MDNS_BUS_SOURCE:-/usr/local/lib/libreecho-mdns/root/run/dbus/system_bus_socket}
ARGS=${ARGS:---foreground --socket $SOCKET --root $RUNTIME_ROOT}

# The controller is always started, but the AirPlay children follow the
# persisted integration toggle.  Bit 16 is the AirPlay 2 flag in the shared
# integrations mask.  AirPlay is enabled by default after payload staging;
# clearing bit 16 is the explicit persistent AirPlay disable.
# Wyoming discovery is not decided here. The shared libreecho-mdnsd supervisor
# reads the persisted pipeline mode and the Home Assistant integration bit
# itself, so this wrapper neither stages a Wyoming record nor touches a
# responder.
airplay_enabled_at_boot=1
if [ -r "$CONFIG" ]; then
    integrations=$(sed -n 's/.*"integrations"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$CONFIG" | sed -n '1p')
    case "$integrations" in
        ''|*[!0-9]*) ;;
        *)
            if [ $((integrations & 16)) -ne 0 ]; then
                airplay_enabled_at_boot=1
            else
                airplay_enabled_at_boot=0
            fi
            ;;
    esac
fi
if [ "$airplay_enabled_at_boot" -eq 1 ]; then
    ARGS="$ARGS --enable-on-start"
fi

mount_led_socket() {
    source_socket=/run/libreecho/led.sock
    target_socket=$RUNTIME_ROOT/run/libreecho/led.sock
    if grep -q " $target_socket " /proc/mounts 2>/dev/null; then
        return 0
    fi
    count=0
    while [ ! -S "$source_socket" ] && [ "$count" -lt 20 ]; do
        sleep 0.1
        count=$((count + 1))
    done
    [ -S "$source_socket" ] || {
        echo "libreecho-airplayd: LED control socket unavailable" >&2
        return 0
    }
    mkdir -p "$(dirname "$target_socket")"
    : >"$target_socket"
    mount --bind "$source_socket" "$target_socket" || {
        rm -f "$target_socket"
        echo "libreecho-airplayd: LED control socket bind failed" >&2
        return 0
    }
}

# A feature transaction may have mounted the payload already. Writable
# support mounts are still ours, and each must be idempotent independently:
# /run being present does not prove a previous attempt finished /var or shm.
mount_support() {
    target=$1
    shift
    grep -q " $target " /proc/mounts 2>/dev/null && return 0
    mount "$@" "$target"
}

mount_shared_mdns_bus() {
    target_socket=$RUNTIME_ROOT/run/dbus/system_bus_socket
    grep -q " $target_socket " /proc/mounts 2>/dev/null && return 0
    count=0
    while [ ! -S "$MDNS_BUS_SOURCE" ] && [ "$count" -lt 50 ]; do
        sleep 0.1
        count=$((count + 1))
    done
    [ -S "$MDNS_BUS_SOURCE" ] || {
        echo "libreecho-airplayd: shared D-Bus socket unavailable" >&2
        return 1
    }
    mkdir -p "$(dirname "$target_socket")" || return 1
    : >"$target_socket" || return 1
    mount --bind "$MDNS_BUS_SOURCE" "$target_socket" || {
        rm -f "$target_socket"
        echo "libreecho-airplayd: shared D-Bus socket bind failed" >&2
        return 1
    }
}

create_support_mounts() {
    mkdir -p "$RUNTIME_ROOT/dev" "$RUNTIME_ROOT/proc" "$RUNTIME_ROOT/sys" \
        "$RUNTIME_ROOT/run" "$RUNTIME_ROOT/var" || return 1
    mount_support "$RUNTIME_ROOT/dev" --bind /dev || return 1
    # The /dev bind hides the payload's directory. Keep NQPTP's POSIX shared
    # memory private, and preserve the separate bounded audio-bus bridge.
    mkdir -p "$RUNTIME_ROOT/dev/shm" || return 1
    mount_support "$RUNTIME_ROOT/proc" -t proc proc || return 1
    mount_support "$RUNTIME_ROOT/sys" --bind /sys || return 1
    mount_support "$RUNTIME_ROOT/run" -t tmpfs -o mode=0755,size=1m libreecho-airplay-run || return 1
    mount_support "$RUNTIME_ROOT/var" -t tmpfs -o mode=0755,size=1m libreecho-airplay-var || return 1
    mount_support "$RUNTIME_ROOT/dev/shm" -t tmpfs -o mode=1777,size=64k libreecho-airplay-shm || return 1
    # No D-Bus or Avahi runtime: the shared mDNS supervisor owns the responder,
    # so the chroot needs only this device's own control sockets.
    mkdir -p "$RUNTIME_ROOT/var/run" "$RUNTIME_ROOT/run/libreecho" \
        "$RUNTIME_ROOT/run/libreecho-audio" /run/libreecho-audio || return 1
    mount_support "$RUNTIME_ROOT/run/libreecho-audio" --bind /run/libreecho-audio || return 1
    mount_shared_mdns_bus || return 1
}

mount_runtime() {
    [ -f "$PAYLOAD" ] || {
        echo "libreecho-airplayd: feature payload missing: $PAYLOAD" >&2
        return 1
    }
    mkdir -p "$RUNTIME_ROOT" || return 1
    if ! grep -q " $RUNTIME_ROOT " /proc/mounts 2>/dev/null; then
        mount -t squashfs -o loop,ro,nosuid,nodev,noatime "$PAYLOAD" "$RUNTIME_ROOT" || {
            echo "libreecho-airplayd: feature payload mount failed" >&2
            return 1
        }
    fi
    create_support_mounts || return 1
    configure_service_name
    stage_airplay_services
    mount_led_socket
}

# The payload ships a fixed service name, so two LibreEcho units on one LAN
# announce the same _airplay._tcp name. Avahi then withholds or renames one of
# them, and because the RAOP record's instance name is MAC-prefixed and unique
# that is the only one that survives - the unit is present as a legacy RAOP
# speaker but missing from AirPlay pickers. Announce the name this device is
# configured with, which the setup flow already persists.
configure_service_name() {
    target=$RUNTIME_ROOT/etc/libreecho/airplay2.conf
    [ -f "$target" ] || return 0
    grep -q " $target " /proc/mounts 2>/dev/null && return 0

    service_name=
    if [ -r "$CONFIG" ]; then
        service_name=$(sed -n \
            's/.*"device_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "$CONFIG" 2>/dev/null | head -n 1)
    fi
    [ -n "$service_name" ] || service_name=$(cat /etc/hostname 2>/dev/null)
    [ -n "$service_name" ] || return 0
    # The name is announced on the LAN, so keep it to plain name characters.
    case "$service_name" in
        *[!A-Za-z0-9._\ -]*) return 0 ;;
    esac

    # Only the general section's name. The pipe and metadata sections each carry
    # a "name" as well, and those are paths - rewriting one breaks audio.
    generated=$RUNTIME_ROOT/var/libreecho-airplay2.conf
    sed "s|^\([[:space:]]*\)name = \"[^/\"]*\";|\1name = \"$service_name\";|" \
        "$target" > "$generated" 2>/dev/null || return 0
    grep -q "name = \"$service_name\";" "$generated" || return 0
    mount_support "$target" --bind "$generated" || {
        echo "libreecho-airplayd: could not announce \"$service_name\"; using the payload name" >&2
        return 0
    }
    echo "libreecho-airplayd: AirPlay service name is \"$service_name\"" >&2
    return 0
}

# AirPlay 2 records are registered dynamically by shairport-sync with the shared
# responder, so an absent payload directory is not a discovery failure - but
# returning silently made it impossible to tell apart from one.
stage_airplay_services() {
    if [ ! -d "$AVAHI_SERVICES_SOURCE" ]; then
        echo "libreecho-airplayd: nothing to stage in $AVAHI_SERVICES_SOURCE; relying on the responder's dynamic registration" >&2
        return 0
    fi
    if mkdir -p "$MDNS_SERVICES_DIR" &&
        cp -a "$AVAHI_SERVICES_SOURCE/." "$MDNS_SERVICES_DIR/"; then
        return 0
    fi
    echo "libreecho-airplayd: AirPlay service definitions were not staged into $MDNS_SERVICES_DIR" >&2
    return 0
}

# Readiness of the shared responder. It is an external dependency: a stopped or
# absent supervisor degrades discovery and is never started, stopped or mounted
# from this wrapper.
mdns_status() {
    [ -x "$MDNS_INIT" ] || return 1
    "$MDNS_INIT" status >/dev/null 2>&1
}

unmount_runtime() {
    umount "$RUNTIME_ROOT/run/dbus/system_bus_socket" 2>/dev/null || true
    rm -f "$RUNTIME_ROOT/run/dbus/system_bus_socket" 2>/dev/null || true
    umount "$RUNTIME_ROOT/run/libreecho/led.sock" 2>/dev/null || true
    rm -f "$RUNTIME_ROOT/run/libreecho/led.sock" 2>/dev/null || true
    umount "$RUNTIME_ROOT/run/libreecho-audio" 2>/dev/null || true
    umount "$RUNTIME_ROOT/var" 2>/dev/null || true
    umount "$RUNTIME_ROOT/run" 2>/dev/null || true
    umount "$RUNTIME_ROOT/dev/shm" 2>/dev/null || true
    umount "$RUNTIME_ROOT/sys" 2>/dev/null || true
    umount "$RUNTIME_ROOT/proc" 2>/dev/null || true
    umount "$RUNTIME_ROOT/dev" 2>/dev/null || true
    umount "$RUNTIME_ROOT" 2>/dev/null || true
}

# Every pid whose argv[0] is exactly $DAEMON. A pidfile is not proof of life:
# it goes stale when the daemon is started from a shell that then exits (the
# fallback branch of start_service() leaves the child in the caller's process
# group), and it goes missing when /run is cleared. Matching on the executable
# means stop and status still see the daemon in both cases, so restart cannot
# silently leave a second copy running.
running_pids() {
    for entry in /proc/[0-9]*; do
        candidate=${entry#/proc/}
        [ "$candidate" = "$$" ] && continue
        [ -r "$entry/cmdline" ] || continue
        argv0=$(tr '\0' '\n' < "$entry/cmdline" 2>/dev/null | sed -n '1p')
        [ "$argv0" = "$DAEMON" ] && printf '%s\n' "$candidate"
    done
}

pidfile_pid() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s\n' "$pid"
}

is_running() {
    pidfile_pid >/dev/null && return 0
    [ -n "$(running_pids)" ]
}

# Sends TERM, waits up to $2 seconds (default 5), then KILL.
terminate() {
    target=$1
    limit=${2:-5}
    kill "$target" 2>/dev/null || true
    count=0
    while kill -0 "$target" 2>/dev/null && [ "$count" -lt "$limit" ]; do
        sleep 1
        count=$((count + 1))
    done
    kill -KILL "$target" 2>/dev/null || true
}

trim_log() {
    [ -f "$LOGFILE" ] || return 0
    size=$(wc -c <"$LOGFILE" 2>/dev/null || printf '0')
    case "$size" in ''|*[!0-9]*) return 0 ;; esac
    [ "$size" -le "$LOG_MAX_BYTES" ] && return 0
    tail -c "$LOG_KEEP_BYTES" "$LOGFILE" >"$LOGFILE.trim" || {
        rm -f "$LOGFILE.trim"
        return 0
    }
    chmod 0644 "$LOGFILE.trim"
    mv "$LOGFILE.trim" "$LOGFILE"
}

start_service() {
    if is_running; then echo "libreecho-airplayd already running"; return 0; fi
    mount_runtime || return 1
    # Discoverability is a shared, external service. A missing supervisor is
    # reported and does not stop AirPlay audio: the controller's status reports
    # the same dependency, and the supervisor is never started from here.
    if ! mdns_status; then
        echo "libreecho-airplayd: shared mDNS supervisor is not ready; AirPlay is not discoverable" >&2
    fi
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")" "$(dirname "$SOCKET")"
    trim_log
    if command -v start-stop-daemon >/dev/null 2>&1; then
        # Keep the controller and all chrooted AirPlay child stderr/stdout in
        # one persistent log.  Without this redirection start-stop-daemon
        # inherits the boot console and Shairport failures disappear when a
        # real RAOP stream opens the ALSA device.
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS \
            </dev/null >>"$LOGFILE" 2>&1
    else
        # setsid detaches the child from this shell's process group. Without it
        # the daemon dies with the shell that started it -- which is why a
        # restart issued over adb or ssh appeared to work and then evaporated.
        if command -v setsid >/dev/null 2>&1; then
            setsid "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        else
            "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        fi
        launched=$!
        echo "$launched" >"$PIDFILE"
        # setsid normally execs the daemon in-place, so the common case resolves
        # immediately. If it forks, poll briefly for the real daemon instead of
        # delaying every service start by a fixed second.
        started=
        count=0
        while [ "$count" -lt 20 ]; do
            if [ -r "/proc/$launched/cmdline" ]; then
                argv0=$(tr '\0' '\n' < "/proc/$launched/cmdline" 2>/dev/null | sed -n '1p')
                if [ "$argv0" = "$DAEMON" ]; then
                    started=$launched
                    break
                fi
            fi
            started=$(running_pids | sort -n | sed -n '1p')
            [ -n "$started" ] && break
            sleep 0.05
            count=$((count + 1))
        done
        [ -n "$started" ] && echo "$started" >"$PIDFILE"
    fi
}

stop_service() {
    if pidfile_pid >/dev/null && command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -K -p "$PIDFILE" -R TERM/5/KILL/2
    else
        pid=$(pidfile_pid) && terminate "$pid" 5
    fi
    # Sweep anything the pidfile did not account for. Without this a lost or
    # stale pidfile made stop a no-op that still reported success, and the
    # following start added a second daemon instead of replacing the first.
    for stray in $(running_pids); do
        terminate "$stray" 5
    done
    rm -f "$PIDFILE"
    unmount_runtime
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; start_service ;;
    status) if is_running; then echo "running"; else echo "stopped"; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
