#!/bin/sh
### BEGIN INIT INFO
# Provides:          libreecho-sttd
# Required-Start:    $remote_fs
# Required-Stop:     $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

[ -r /etc/default/libreecho-sttd ] && . /etc/default/libreecho-sttd

PAYLOAD=${PAYLOAD:-/data/libreecho/features/stt/payload.squashfs}
RUNTIME_ROOT=${RUNTIME_ROOT:-/run/libreecho/features/stt/root}
DAEMON=${DAEMON:-$RUNTIME_ROOT/usr/local/sbin/libreecho-sttd}
MODEL_ROOT=${MODEL_ROOT:-$RUNTIME_ROOT/usr/local/share/libreecho/stt}
PIDFILE=${PIDFILE:-/var/run/libreecho-sttd.pid}
LOGFILE=${LOGFILE:-/var/log/libreecho-sttd.log}
SOCKET=${SOCKET:-/run/libreecho/stt.sock}
THREADS=${THREADS:-2}
CONFIG=${CONFIG:-/data/libreecho/config/web-config.json}
WYOMING_DAEMON=${WYOMING_DAEMON:-/usr/local/sbin/libreecho-sttd-wyoming}

# Numeric settings are written unquoted in web-config.json, so they need a
# separate matcher from config_string.
config_number() {
    key=$1
    fallback=$2
    value=
    if [ -r "$CONFIG" ]; then
        value=$(sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p" \
            "$CONFIG" | sed -n '1p')
    fi
    case "$value" in ''|*[!0-9]*) value=$fallback ;; esac
    printf '%s\n' "$value"
}

config_string() {
    key=$1
    fallback=$2
    value=
    if [ -r "$CONFIG" ]; then
        value=$(sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
            "$CONFIG" | sed -n '1p')
    fi
    [ -n "$value" ] || value=$fallback
    printf '%s\n' "$value"
}

mount_runtime() {
    [ -f "$PAYLOAD" ] || {
        echo "libreecho-sttd: feature payload missing: $PAYLOAD" >&2
        return 1
    }
    mkdir -p "$RUNTIME_ROOT"
    if grep -q " $RUNTIME_ROOT " /proc/mounts 2>/dev/null; then
        return 0
    fi
    mount -t squashfs -o loop,ro,nosuid,nodev,noatime \
        "$PAYLOAD" "$RUNTIME_ROOT" || {
        echo "libreecho-sttd: feature payload mount failed" >&2
        return 1
    }
}

unmount_runtime() {
    umount "$RUNTIME_ROOT" 2>/dev/null || true
}

# Every pid whose argv[0] is exactly $DAEMON. A pidfile is not proof of life:
# it goes stale when the daemon is started from a shell that then exits (the
# fallback branch of start_service() leaves the child in the caller's process
# group), and it goes missing when /run is cleared. Matching on the executable
# means stop and status still see the daemon in both cases, so restart cannot
# silently leave a second copy running.
running_pids() {
    for entry in /proc/[0-9]*; do
        candidate=${entry#/proc/}
        [ "$candidate" = "$$" ] && continue
        [ -r "$entry/cmdline" ] || continue
        argv0=$(tr '\0' '\n' < "$entry/cmdline" 2>/dev/null | sed -n '1p')
        [ "$argv0" = "$DAEMON" ] && printf '%s\n' "$candidate"
    done
}

pidfile_pid() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s\n' "$pid"
}

is_running() {
    pidfile_pid >/dev/null && return 0
    [ -n "$(running_pids)" ]
}

# Sends TERM, waits up to $2 seconds (default 5), then KILL.
terminate() {
    target=$1
    limit=${2:-5}
    kill "$target" 2>/dev/null || true
    count=0
    while kill -0 "$target" 2>/dev/null && [ "$count" -lt "$limit" ]; do
        sleep 1
        count=$((count + 1))
    done
    kill -KILL "$target" 2>/dev/null || true
}

start_service() {
    if is_running; then echo "libreecho-sttd already running"; return 0; fi
    MODE=$(config_string voice_pipeline_mode local)
    if [ "$MODE" = custom ]; then
        ENDPOINT=$(config_string stt_wyoming_uri "")
        MODEL=$(config_string stt_wyoming_model whisper-small)
        case "$ENDPOINT" in tcp://*:* ) ;; *)
            echo "libreecho-sttd: invalid Wyoming endpoint" >&2
            return 1 ;;
        esac
        [ -x "$WYOMING_DAEMON" ] || {
            echo "libreecho-sttd: Wyoming client is unavailable" >&2
            return 1
        }
        DAEMON=$WYOMING_DAEMON
        export LE_STT_WYOMING_URI=$ENDPOINT
        export LE_STT_WYOMING_MODEL=$MODEL
        # How long the device listens after the wake word, and how it decides
        # the speaker has finished.  These need to be tunable per room: a
        # household with a television or other people talking keeps the VAD
        # permanently "active", so end-of-speech never fires and the turn runs
        # to the maximum.  Owners can shorten the cap and raise the noise floor
        # from the config rather than needing a new build.
        export LE_STT_MAX_UTTERANCE_MS=$(config_number stt_max_utterance_ms 6000)
        export LE_STT_END_SILENCE_MS=$(config_number stt_end_silence_ms 1000)
        export LE_STT_VAD_FLOOR_RMS=$(config_number stt_vad_floor_rms 16)
        ARGS=${ARGS:---socket $SOCKET --model-dir $ENDPOINT --threads 1}
    else
        mount_runtime || return 1
        [ -x "$DAEMON" ] &&
            [ -f "$MODEL_ROOT/encoder-epoch-99-avg-1.int8.onnx" ] &&
            [ -f "$MODEL_ROOT/decoder-epoch-99-avg-1.int8.onnx" ] &&
            [ -f "$MODEL_ROOT/joiner-epoch-99-avg-1.int8.onnx" ] &&
            [ -f "$MODEL_ROOT/tokens.txt" ] || {
            echo "libreecho-sttd: incomplete English STT runtime" >&2
            unmount_runtime
            return 1
        }
        case "$THREADS" in 1|2|3|4) ;; *)
            echo "libreecho-sttd: THREADS must be 1..4" >&2
            unmount_runtime
            return 1
        esac
        ARGS=${ARGS:---socket $SOCKET --model-dir $MODEL_ROOT --threads $THREADS}
    fi
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")" \
        "$(dirname "$SOCKET")"
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS \
            </dev/null >>"$LOGFILE" 2>&1
    else
        # setsid detaches the child from this shell's process group. Without it
        # the daemon dies with the shell that started it -- which is why a
        # restart issued over adb or ssh appeared to work and then evaporated.
        if command -v setsid >/dev/null 2>&1; then
            setsid "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        else
            "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        fi
        launched=$!
        echo "$launched" >"$PIDFILE"
        # setsid normally execs the daemon in-place, so the common case resolves
        # immediately. If it forks, poll briefly for the real daemon instead of
        # delaying every service start by a fixed second.
        started=
        count=0
        while [ "$count" -lt 20 ]; do
            if [ -r "/proc/$launched/cmdline" ]; then
                argv0=$(tr '\0' '\n' < "/proc/$launched/cmdline" 2>/dev/null | sed -n '1p')
                if [ "$argv0" = "$DAEMON" ]; then
                    started=$launched
                    break
                fi
            fi
            started=$(running_pids | sort -n | sed -n '1p')
            [ -n "$started" ] && break
            sleep 0.05
            count=$((count + 1))
        done
        [ -n "$started" ] && echo "$started" >"$PIDFILE"
    fi
}

stop_service() {
    if pidfile_pid >/dev/null && command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -K -p "$PIDFILE" -R TERM/5/KILL/2
    else
        pid=$(pidfile_pid) && terminate "$pid" 5
    fi
    # Sweep anything the pidfile did not account for. Without this a lost or
    # stale pidfile made stop a no-op that still reported success, and the
    # following start added a second daemon instead of replacing the first.
    for stray in $(running_pids); do
        terminate "$stray" 5
    done
    rm -f "$PIDFILE" "$SOCKET"
    unmount_runtime
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; start_service ;;
    status) if is_running; then echo "running"; else echo "stopped"; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
