#!/bin/sh
### BEGIN INIT INFO
# Provides:          libreecho-ttsd
# Required-Start:    $remote_fs
# Required-Stop:     $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

[ -r /etc/default/libreecho-ttsd ] && . /etc/default/libreecho-ttsd

PAYLOAD=${PAYLOAD:-/data/libreecho/features/tts/payload.squashfs}
RUNTIME_ROOT=${RUNTIME_ROOT:-/run/libreecho/features/tts/root}
DAEMON=${DAEMON:-$RUNTIME_ROOT/usr/local/sbin/libreecho-ttsd}
PIDFILE=${PIDFILE:-/var/run/libreecho-ttsd.pid}
LOGFILE=${LOGFILE:-/var/log/libreecho-ttsd.log}
SOCKET=${SOCKET:-/run/libreecho/tts.sock}
MODEL_ROOT=${MODEL_ROOT:-$RUNTIME_ROOT/usr/local/share/libreecho/tts/models}
VOICE_FILE=${VOICE_FILE:-/data/libreecho/config/tts-voice}
CONFIG=${CONFIG:-/data/libreecho/config/web-config.json}
WYOMING_DAEMON=${WYOMING_DAEMON:-/usr/local/sbin/libreecho-ttsd-wyoming}

config_string() {
    key=$1
    fallback=$2
    value=
    if [ -r "$CONFIG" ]; then
        value=$(sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
            "$CONFIG" | sed -n '1p')
    fi
    [ -n "$value" ] || value=$fallback
    printf '%s\n' "$value"
}

valid_voice() {
    case "$1" in
        northern-male|southern-female) return 0 ;;
        *) return 1 ;;
    esac
}

selected_voice() {
    selected=
    if [ -r "$VOICE_FILE" ]; then
        selected=$(sed -n '1p' "$VOICE_FILE")
    elif [ -r "$CONFIG" ]; then
        selected=$(sed -n 's/.*"tts_voice"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CONFIG" | sed -n '1p')
    fi
    valid_voice "$selected" || selected=southern-female
    printf '%s\n' "$selected"
}

mount_runtime() {
    [ -f "$PAYLOAD" ] || {
        echo "libreecho-ttsd: feature payload missing: $PAYLOAD" >&2
        return 1
    }
    mkdir -p "$RUNTIME_ROOT"
    if grep -q " $RUNTIME_ROOT " /proc/mounts 2>/dev/null; then
        return 0
    fi
    mount -t squashfs -o loop,ro,nosuid,nodev,noatime "$PAYLOAD" "$RUNTIME_ROOT" || {
        echo "libreecho-ttsd: feature payload mount failed" >&2
        return 1
    }
}

unmount_runtime() {
    umount "$RUNTIME_ROOT" 2>/dev/null || true
}

# Every pid whose argv[0] is exactly $DAEMON. A pidfile is not proof of life:
# it goes stale when the daemon is started from a shell that then exits (the
# fallback branch of start_service() leaves the child in the caller's process
# group), and it goes missing when /run is cleared. Matching on the executable
# means stop and status still see the daemon in both cases, so restart cannot
# silently leave a second copy running.
running_pids() {
    for entry in /proc/[0-9]*; do
        candidate=${entry#/proc/}
        [ "$candidate" = "$$" ] && continue
        [ -r "$entry/cmdline" ] || continue
        argv0=$(tr '\0' '\n' < "$entry/cmdline" 2>/dev/null | sed -n '1p')
        [ "$argv0" = "$DAEMON" ] && printf '%s\n' "$candidate"
    done
}

pidfile_pid() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s\n' "$pid"
}

is_running() {
    pidfile_pid >/dev/null && return 0
    [ -n "$(running_pids)" ]
}

# Sends TERM, waits up to $2 seconds (default 5), then KILL.
terminate() {
    target=$1
    limit=${2:-5}
    kill "$target" 2>/dev/null || true
    count=0
    while kill -0 "$target" 2>/dev/null && [ "$count" -lt "$limit" ]; do
        sleep 1
        count=$((count + 1))
    done
    kill -KILL "$target" 2>/dev/null || true
}

start_service() {
    if is_running; then echo "libreecho-ttsd already running"; return 0; fi
    MODE=$(config_string voice_pipeline_mode local)
    if [ "$MODE" = custom ]; then
        ENDPOINT=$(config_string tts_wyoming_uri "")
        VOICE=$(config_string tts_wyoming_voice en_GB-alan-medium)
        case "$ENDPOINT" in tcp://*:* ) ;; *)
            echo "libreecho-ttsd: invalid Wyoming endpoint" >&2
            return 1 ;;
        esac
        [ -x "$WYOMING_DAEMON" ] || {
            echo "libreecho-ttsd: Wyoming client is unavailable" >&2
            return 1
        }
        DAEMON=$WYOMING_DAEMON
        export LE_TTS_WYOMING_URI=$ENDPOINT
        export LE_TTS_WYOMING_VOICE=$VOICE
        LE_TTS_IN_PROCESS=${LE_TTS_IN_PROCESS:-0}
        ARGS=${ARGS:---foreground --socket $SOCKET --model-dir $ENDPOINT --voice $VOICE}
    else
        mount_runtime || return 1
        VOICE=$(selected_voice)
        MODEL_DIR="$MODEL_ROOT/$VOICE"
        [ -x "$DAEMON" ] && [ -f "$MODEL_DIR/model.onnx" ] &&
            [ -f "$MODEL_DIR/tokens.txt" ] &&
            [ -d "$MODEL_DIR/espeak-ng-data" ] || {
            echo "libreecho-ttsd: incomplete runtime for voice $VOICE" >&2
            unmount_runtime
            return 1
        }
        ARGS=${ARGS:---foreground --socket $SOCKET --model-dir $MODEL_DIR --voice $VOICE}
    fi
    export LE_TTS_THREADS=${LE_TTS_THREADS:-4}
    export LE_TTS_STREAMING=${LE_TTS_STREAMING:-1}
    export LE_TTS_IN_PROCESS=${LE_TTS_IN_PROCESS:-1}
    export LE_TTS_CPU_BOOST=${LE_TTS_CPU_BOOST:-1}
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")" "$(dirname "$SOCKET")"
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS \
            </dev/null >>"$LOGFILE" 2>&1
    else
        # setsid detaches the child from this shell's process group. Without it
        # the daemon dies with the shell that started it -- which is why a
        # restart issued over adb or ssh appeared to work and then evaporated.
        if command -v setsid >/dev/null 2>&1; then
            setsid "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        else
            "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        fi
        launched=$!
        echo "$launched" >"$PIDFILE"
        # setsid normally execs the daemon in-place, so the common case resolves
        # immediately. If it forks, poll briefly for the real daemon instead of
        # delaying every service start by a fixed second.
        started=
        count=0
        while [ "$count" -lt 20 ]; do
            if [ -r "/proc/$launched/cmdline" ]; then
                argv0=$(tr '\0' '\n' < "/proc/$launched/cmdline" 2>/dev/null | sed -n '1p')
                if [ "$argv0" = "$DAEMON" ]; then
                    started=$launched
                    break
                fi
            fi
            started=$(running_pids | sort -n | sed -n '1p')
            [ -n "$started" ] && break
            sleep 0.05
            count=$((count + 1))
        done
        [ -n "$started" ] && echo "$started" >"$PIDFILE"
    fi
}

stop_service() {
    if pidfile_pid >/dev/null && command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -K -p "$PIDFILE" -R TERM/5/KILL/2
    else
        pid=$(pidfile_pid) && terminate "$pid" 5
    fi
    # Sweep anything the pidfile did not account for. Without this a lost or
    # stale pidfile made stop a no-op that still reported success, and the
    # following start added a second daemon instead of replacing the first.
    for stray in $(running_pids); do
        terminate "$stray" 5
    done
    rm -f "$PIDFILE"
    rm -f "$SOCKET"
    unmount_runtime
}

switch_voice() {
    selected=${2:-}
    valid_voice "$selected" || {
        echo "libreecho-ttsd: voice must be northern-male or southern-female" >&2
        return 1
    }
    mkdir -p "$(dirname "$VOICE_FILE")"
    printf '%s\n' "$selected" >"$VOICE_FILE.new" || return 1
    chmod 0600 "$VOICE_FILE.new"
    mv "$VOICE_FILE.new" "$VOICE_FILE" || return 1
    sync
    stop_service
    start_service
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; start_service ;;
    switch) switch_voice "$@" ;;
    status) if is_running; then echo "running"; else echo "stopped"; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status|switch <northern-male|southern-female>}"; exit 1 ;;
esac
