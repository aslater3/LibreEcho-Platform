 void SyncTask::apply_stream_clear(SyncContext& sync_context) {
+    // Capture the monotonic boundary token and retire the command bit first: a stream/clear
+    // signalled while this boundary is being applied must survive to produce its own later
+    // boundary, and the token must be the value as observed here so it stays strictly increasing
+    // across applied boundaries even if a new signal races in mid-call.
+    const uint32_t boundary_token = this->clear_generation_.load(std::memory_order_acquire);
+    this->event_flags_.clear(EventGroupBits::COMMAND_STREAM_CLEAR);
+
     // Drop in-flight decoded audio (it carries the pre-seek timestamp; appending post-seek audio to
     // it would mis-stamp the buffer) and any pending hard-sync gap-fill silence. Codec/decoder
-    // state, buffered_frames and new_audio_client_playtime are deliberately left intact: the audio
-    // already handed to the sink keeps draining, and the next chunk's server timestamp lets the
-    // sync logic re-align on its own. Force hard_syncing on so that re-alignment uses the tight
-    // settle threshold (the post-seek timestamp jump would trigger it anyway, but this is
-    // explicit). initial_decode is left as-is: if priming has not finished the caller resumes it
-    // via the INITIAL_SYNC state; if it has, we must not re-prime an already-running sink.
+    // state and initial_decode are left intact; the next chunk's server timestamp lets the sync
+    // logic re-align on its own. Force hard_syncing on so that re-alignment uses the tight settle
+    // threshold (the post-seek timestamp jump would trigger it anyway, but this is explicit).
+    // initial_decode is left as-is: if priming has not finished the caller resumes it via the
+    // INITIAL_SYNC state; if it has, we must not re-prime an already-running sink.
     sync_context.silence_remaining = 0;
     sync_context.release_chunk = false;
     sync_context.hard_syncing = true;
@@ -730,7 +742,50 @@
     if (sync_context.decode_buffer != nullptr) {
         sync_context.decode_buffer->decrease_buffer_length(sync_context.decode_buffer->available());
     }
-    this->event_flags_.clear(EventGroupBits::COMMAND_STREAM_CLEAR);
+
+    // Fire the synchronous seek boundary on this (sync) thread, between the last pre-seek
+    // on_audio_write() and the first post-seek one, once per distinct boundary token. The listener
+    // fences its sink and returns the frames it discarded; those are removed from the
+    // accepted-minus-played ledger so the post-seek sync does not mistake correctly-timed audio for
+    // late. apply_stream_clear() is also reachable from decode_chunk()'s marker branch, where a
+    // marker the flag path already handled for the same signal would otherwise re-deliver the
+    // boundary and reset the ledger twice; a token already delivered is suppressed. A listener that
+    // does not discard returns 0 (the default), leaving the ledger untouched.
+    if (boundary_token != this->last_applied_boundary_) {
+        this->last_applied_boundary_ = boundary_token;
+        PlayerRoleListener* listener =
+            this->player_impl_ != nullptr ? this->player_impl_->listener : nullptr;
+        if (listener != nullptr) {
+            this->apply_dropped_frames(sync_context, listener->on_stream_boundary(boundary_token));
+        }
+    }
+}
+
+void SyncTask::apply_dropped_frames(SyncContext& sync_context, uint32_t frames) {
+    if (frames == 0) {
+        return;
+    }
+    uint32_t dropped = frames;
+    if (dropped > sync_context.buffered_frames) {
+        // The ledger is the SDK's own upper bound on what the sink can still hold (accepted minus
+        // reported-played), so a larger report is a consumer accounting error, not extra audio.
+        SS_LOGW(TAG,
+                "seek boundary: sink discarded %" PRIu32
+                " frames but only %" PRIu32 " were buffered; clamping",
+                frames, sync_context.buffered_frames);
+        dropped = sync_context.buffered_frames;
+    }
+    if (dropped == 0) {
+        return;
+    }
+    sync_context.buffered_frames -= dropped;
+    // Move the predicted end of the buffered audio back by exactly the discarded duration: the
+    // dropped frames were the sink's future timeline and no longer play, so buffered_frames and
+    // new_audio_client_playtime must move together. This is a bookkeeping correction, not a played
+    // event: the frames are NOT reported through notify_audio_played(), so they never masquerade as
+    // hardware-played audio.
+    sync_context.new_audio_client_playtime -=
+        sync_context.current_stream_info.frames_to_microseconds(dropped);
 }
 
