     /// not-yet-played accepted bytes here, or pre-seek audio replays after the seek.
     virtual void on_stream_clear() {}
 
+    /// @brief Synchronous seek boundary, delivered on the SYNC TASK thread at the exact point the
+    /// SDK applies a server stream/clear.
+    ///
+    /// Fires after every on_audio_write() for the pre-seek audio has returned and before any
+    /// on_audio_write() carrying post-seek audio is issued, on the same thread as on_audio_write().
+    /// That is a hard happens-before: unlike on_stream_clear(), which is inbox-queued and delivered
+    /// on the main loop in arrival order and may therefore run after post-seek audio has already been
+    /// accepted by a sink, an implementation that must fence its own sink can do so here without
+    /// racing the post-seek writes. stream/clear is a seek within the open stream: no stream/start
+    /// follows.
+    ///
+    /// The accepted-but-unplayed accounting below is the second half of the contract: the SDK keeps
+    /// a ledger of frames the sink accepted minus frames it reported as played, and a sink-side
+    /// discard would otherwise leave the discarded frames in that ledger forever, making the SDK
+    /// treat correctly-timed post-seek audio as late and drop or silence it.
+    ///
+    /// @param clear_generation Monotonic count of stream/clear signals observed on this role;
+    ///        strictly increases per applied boundary. Opaque beyond ordering.
+    /// @return The number of PCM frames the implementation discarded from its sink at this boundary:
+    ///         frames it had accepted from on_audio_write() but never reported as played through
+    ///         notify_audio_played(). The SDK removes exactly this many frames from its
+    ///         accepted-minus-played ledger and moves the predicted buffer playtime back by their
+    ///         duration. Such frames are counted as dropped, never as played, so they must not
+    ///         include frames already reported through notify_audio_played(). Return 0 if nothing
+    ///         was discarded; the default returns 0, which preserves the pre-boundary drain model
+    ///         for implementations that do not fence a sink here.
+    virtual uint32_t on_stream_boundary(uint32_t /*clear_generation*/) {
+        return 0;
+    }
+
     /// @brief Called when the volume is changed by the server
     virtual void on_volume_changed(uint8_t /*volume*/) {}
 
