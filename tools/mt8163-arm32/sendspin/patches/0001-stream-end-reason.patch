+// ============================================================================
+// Stream-end reason + seek-clear notification
+// ============================================================================
+//
+// The three reasons were previously indistinguishable at the public boundary: natural end, role
+// removal and connection shutdown all delivered the same reason-less on_stream_end(). These
+// tests pin the typed contract and the seek/clear notification, and prove the legacy reason-less
+// override still fires (source compatibility). They drain the role's ring through the same
+// generation gate SendspinClient::loop() applies to a PLAYER_STREAM event before calling
+// on_stream_ring_event(), then run the tick's drain_events(), so the ordering/fencing they assert
+// is the ordering/fencing a real client produces.
+
+namespace {
+
+// A listener that records callback order and the stream-end reason of every end.
+class ReasonRecordingListener : public PlayerRoleListener {
+public:
+    size_t on_audio_write(uint8_t*, size_t length, uint32_t) override { return length; }
+    void on_stream_start() override { this->events.emplace_back("start"); }
+    void on_stream_end(SendspinStreamEndReason reason) override {
+        this->events.emplace_back("end");
+        this->end_reasons.push_back(reason);
+    }
+    void on_stream_clear() override { this->events.emplace_back("clear"); }
+
+    std::vector<std::string> events;
+    std::vector<SendspinStreamEndReason> end_reasons;
+};
+
+// A listener that overrides ONLY the legacy reason-less form: the new reason overload must still
+// reach it unchanged (source compatibility for existing implementers).
+class LegacyNoArgListener : public PlayerRoleListener {
+public:
+    size_t on_audio_write(uint8_t*, size_t length, uint32_t) override { return length; }
+    void on_stream_end() override { ++this->ends; }
+    int ends{0};
+};
+
+// Drains the role's own ring exactly as SendspinClient::loop() dispatches a PLAYER_STREAM batch:
+// each event is admitted only if its epoch still matches the role's teardown generation, then
+// handed to on_stream_ring_event(); the tick's drain_events() runs once afterwards.
+void pump_role_tick(PlayerRole::Impl& impl) {
+    InboxEvent events[Inbox::EVENT_CAPACITY];
+    const size_t n = impl.inbox->take_events(events, Inbox::EVENT_CAPACITY);
+    for (size_t i = 0; i < n; ++i) {
+        if (events[i].type != InboxEventType::PLAYER_STREAM) {
+            continue;
+        }
+        if (event_is_current(events[i].epoch,
+                             impl.cleanup_generation.load(std::memory_order_acquire),
+                             "test", "a player stream event")) {
+            impl.on_stream_ring_event(static_cast<PlayerStreamCallbackType>(events[i].code));
+        }
+    }
+    impl.drain_events();
+}
+
+// Starts a stream and drains the start tick, so the role is an active stream before the case runs.
+void start_active_stream(PlayerRole::Impl& impl, uint32_t generation) {
+    impl.handle_stream_start(pcm_stream_params(), generation);
+    pump_role_tick(impl);
+}
