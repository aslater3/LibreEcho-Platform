+/// @brief Why a player stream ended, delivered to PlayerRoleListener::on_stream_end().
+///
+/// The three reasons are indistinguishable from the listener's public surface otherwise: the
+/// public client API carries no active-role signal (client.h exposes no on_activate and no role
+/// add/remove callback), and the natural-end and teardown producers enqueue the same event type.
+/// A consumer that must finish the buffered tail on a natural end but fence and discard it on a
+/// removal or a lost connection relies on this typed reason.
+enum class SendspinStreamEndReason : uint8_t {
+    /// The server sent stream/end while the player role stays in the session's active roles: the
+    /// buffered tail should be allowed to finish (drain / FINISH).
+    NATURAL = 0,
+    /// A server/activate took player@v1 out of active_roles: the stream must be fenced and the
+    /// buffered audio discarded, not finished. The connection itself survives.
+    ROLE_REMOVED = 1,
+    /// The connection was lost (drop_connection()/cleanup_connection_state()) or the client was
+    /// stopped: fence and discard.
+    DISCONNECTED = 2,
+};
