+    const uint32_t gen = live_generation(*impl);
+    start_active_stream(*impl, gen);
+    impl->handle_stream_end(gen);                          // natural end queued first
+    impl->cleanup(SendspinStreamEndReason::ROLE_REMOVED);  // removal before the tick drains
+    pump_role_tick(*impl);
+
+    ASSERT_EQ(listener.end_reasons.size(), 1u) << "the fenced natural end was still delivered";
+    EXPECT_EQ(listener.end_reasons.back(), SendspinStreamEndReason::ROLE_REMOVED);
+    EXPECT_EQ(listener.events, (std::vector<std::string>{"start", "end"}));
+}
