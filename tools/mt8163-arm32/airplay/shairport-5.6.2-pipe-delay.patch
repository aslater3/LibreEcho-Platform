+// Frames written to the pipe but not yet played: what is in the pipe now plus
+// what the bridge and the audio engine still hold. Fails (-ENODEV) when the
+// bridge's figure is missing or stale, so Shairport falls back to running
+// without a delay() rather than trusting a wrong number.
+static int delay(long *the_delay) {
+  return le_ad_client_delay(&le_delay, fd, bytes_per_frame, the_delay);
+}
+
 static void stop(void) {
