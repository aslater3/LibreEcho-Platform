+// Frames written to the pipe but not yet played: what is in the pipe now plus
+// what the bridge and the audio engine still hold. Fails (-ENODEV) when the
+// bridge's figure is missing or stale, so Shairport falls back to running
+// without a delay() rather than trusting a wrong number.
+static int delay(long *the_delay) {
+  le_sync_counters();
+  return le_ad_client_delay(&le_delay, fd, bytes_per_frame, the_delay);
+}
+
+// Everything written to the pipe so far is stale (skip, seek, pause). Called from
+// the player thread with flush_mutex held and, in AirPlay 2, from the buffered
+// audio thread on pause, so it must not wait for long and must not race play():
+// both take one mutex. It asks the bridge to discard what is queued past this
+// pipe and waits a bounded time for the answer (see airplay_delay.h).
+static void flush(void) {
+  le_sync_counters();
+  le_ad_client_flush(&le_delay);
+}
