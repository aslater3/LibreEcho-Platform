+static void le_sync_counters(void) {
+  le_ad_client_set_sync(&le_delay, __atomic_load_n(&le_ad_ctr_resyncs, __ATOMIC_RELAXED),
+                        __atomic_load_n(&le_ad_ctr_late_drops, __ATOMIC_RELAXED),
