#!/bin/busybox sh
# Signed A/B updater for the Amonet Biscuit layout.

BB=/bin/busybox

# Exact reviewed post-Amonet Biscuit userdata sizes, in 512-byte sectors.
# Do not accept arbitrary larger partitions or change any other partition.
userdata_size_supported()
{
    case "$1" in
        2137088|2153472) return 0 ;;
        *) return 1 ;;
    esac
}

DATA_ROOT=/data
GENERATIONS=${GENERATIONS:-$DATA_ROOT/libreecho/generations}
UPDATE_ROOT=$DATA_ROOT/libreecho/update
INCOMING=$UPDATE_ROOT/incoming
STAGING=$UPDATE_ROOT/staging
STATE=$UPDATE_ROOT/state
PENDING=$UPDATE_ROOT/pending
LOCK=$UPDATE_ROOT/install.lock
VERIFY=/usr/local/libexec/libreecho-update-verify
BOOTCTL=/usr/local/sbin/libreecho-bootctl
PUBLIC_KEY=/etc/libreecho/ota-public-key.hex
CHANNEL_FILE=$UPDATE_ROOT/automatic-updates
PACKAGED_CHANNEL_FILE=/etc/libreecho/update-channel
# Set to 1 only by the manual-upload install path via the --allow-unsigned flag.
# The GitHub fetch path (libreecho-update-fetch) never passes it, so fetched and
# automatic updates always verify signatures.
ALLOW_UNSIGNED=0
BOOT_SIZE=16777216
BOOT_SECTORS=32768

# Set once an install has begun writing progress to $STATE, so die() knows the
# status file is mid-transaction and must not be left there.
STATE_DIRTY=0
ACTIVATION_STARTED=0
ABORT_ATTEMPTED=0
CURRENT_SERVICE_PROFILE=
FEATURE_TRANSACTION=/usr/local/sbin/libreecho-feature-transaction
USERDATA_DEVICE=/dev/mmcblk0p16
USERDATA_SYS=/sys/class/block/mmcblk0p16
MOUNTS_FILE=/proc/mounts
BOOT_DEVICE_ROOT=/dev
BOOT_SYS_ROOT=/sys/class/block
TRANSACTION_SLOT_FILE=$UPDATE_ROOT/transaction-slot
TRANSACTION_BCB_FILE=$STAGING/bootctl.readback
OTA_FORMAT=v3

# Immutable image identity, not a caller environment or bootloader product.
# Keep this bounded loader inline: no extra staged runtime file is required.
load_image_target()
{
    local target_file=/etc/libreecho/target target_count
    TARGET_ID=
    TARGET_SLUG=
    if [ ! -e "$target_file" ] && [ ! -L "$target_file" ]; then
        TARGET_ID=radar_puffin
        TARGET_SLUG=radar-puffin
        printf '%s\n' 'target-file=missing fallback=radar_puffin' >&2
        return 0
    fi
    [ -f "$target_file" ] && [ ! -L "$target_file" ] && [ -r "$target_file" ] || return 1
    target_count=$($BB grep -c '^target_id=' "$target_file")
    [ "$target_count" = 1 ] || return 1
    TARGET_ID=$($BB sed -n 's/^target_id=//p' "$target_file")
    case "$TARGET_ID" in
        radar_puffin) TARGET_SLUG=radar-puffin ;;
        biscuit) TARGET_SLUG=biscuit ;;
        *) TARGET_ID=; return 1 ;;
    esac
}


cleanup_refused_install_artifacts()
{
    # A pending target transaction owns its staged manifest and boot image as rollback evidence. Only discard transient working data
    # when no durable transaction record exists, and only for the install
    # command: inspect/status share die() and must never touch staging.
    [ "${INSTALL_CLEANUP:-0}" = 1 ] || return 0
    if [ -e "$PENDING" ]; then
        return 0
    fi
    $BB rm -rf "$STAGING" 2>/dev/null || return 1
    case "${package:-}" in
        "$INCOMING"/*) $BB rm -f "$package" 2>/dev/null || return 1 ;;
    esac
    return 0
}

die()
{
    echo "ERROR:$1" >&2
    # An aborted install used to leave $STATE at whatever step it reached
    # (typically "verifying" / 5), which makes the update subsystem report a
    # transfer in progress forever and blocks the next attempt. Record the
    # failure and the reason instead, so `status` and the web API can explain
    # what happened rather than showing a phantom running install.
    if [ "${STATE_DIRTY:-0}" = 1 ] && [ -n "${STATE:-}" ]; then
        {
            echo schema=1
            echo state=failed
            echo progress=0
            echo "detail=$1"
        } > "$STATE.tmp" 2>/dev/null &&
            $BB mv "$STATE.tmp" "$STATE" 2>/dev/null || $BB rm -f "$STATE.tmp" 2>/dev/null
        $BB sync 2>/dev/null || true
    fi
    # On an ordinary aborted install, release only this candidate's lifecycle
    # pin. A pending target remains owned by the transaction instead.
    if [ -n "${INSTALL_PIN:-}" ] && [ ! -e "$PENDING" ] && [ ! -L "$PENDING" ]; then
        $BB rm -f "$INSTALL_PIN"
        $BB sync
    fi
    cleanup_refused_install_artifacts || true
    exit 1
}

require_userdata()
{
    [ -b "$USERDATA_DEVICE" ] &&
        $BB grep -qx 'PARTNAME=userdata' \
            "$USERDATA_SYS/uevent" 2>/dev/null &&
        userdata_size_supported "$($BB cat "$USERDATA_SYS/size" 2>/dev/null)" &&
        $BB grep -q " $DATA_ROOT " "$MOUNTS_FILE" 2>/dev/null ||
        die userdata_identity_or_mount_failed
    $BB mkdir -p "$INCOMING" "$UPDATE_ROOT" || die update_directory_failed
    $BB chmod 0700 "$DATA_ROOT/libreecho" "$UPDATE_ROOT" "$INCOMING" 2>/dev/null
}

channel_value()
{
    $BB sed -n 's/^channel=//p' "$CHANNEL_FILE" 2>/dev/null
}

write_channel()
{
    channel=$1
    {
        [ -r "$CHANNEL_FILE" ] && $BB sed '/^channel=/d' "$CHANNEL_FILE"
        printf '%s\n' "channel=$channel"
    } > "$CHANNEL_FILE.tmp" || die channel_write_failed
    $BB chmod 0600 "$CHANNEL_FILE.tmp" &&
        $BB mv "$CHANNEL_FILE.tmp" "$CHANNEL_FILE" || die channel_commit_failed
}

seed_channel()
{
    channel=$(channel_value)
    [ "$channel" = dev ] || [ "$channel" = stable ] || {
        channel=$($BB cat "$PACKAGED_CHANNEL_FILE" 2>/dev/null)
        [ "$channel" = dev ] || [ "$channel" = stable ] || die packaged_update_channel
        write_channel "$channel"
    }
}

target_device_for_slot()
{
    slot_name=$1
    case "$slot_name" in
        a)
            target_device=$BOOT_DEVICE_ROOT/mmcblk0p10
            target_sys=$BOOT_SYS_ROOT/mmcblk0p10
            target_partname=boot_a_x
            target_partname_pinned=boot_a
            ;;
        b)
            target_device=$BOOT_DEVICE_ROOT/mmcblk0p11
            target_sys=$BOOT_SYS_ROOT/mmcblk0p11
            target_partname=boot_b_x
            target_partname_pinned=boot_b
            ;;
        *) die boot_control_target ;;
    esac

    # The slot store is the same reviewed 32768-sector partition at the same
    # device node on both supported layouts; only its PARTNAME differs. The
    # legacy Amonet layout redirects LK's boot_a/boot_b reads to these _x stores,
    # while the pinned upstream chain names the stores boot_a/boot_b directly.
    # Accepting either name for this node changes nothing else, and the exact
    # sector check still rejects the 225280-sector Amonet wrapper partitions, so
    # a boot image can never be written to a wrapper.
    [ -b "$target_device" ] &&
        { $BB grep -qx "PARTNAME=$target_partname" "$target_sys/uevent" 2>/dev/null ||
          $BB grep -qx "PARTNAME=$target_partname_pinned" "$target_sys/uevent" 2>/dev/null; } &&
        [ "$($BB cat "$target_sys/size" 2>/dev/null)" = "$BOOT_SECTORS" ] ||
        die boot_target_identity
}

state_write()
{
    state_name=$1
    progress=$2
    detail=$3
    {
        echo schema=1
        echo "state=$state_name"
        echo "progress=$progress"
        echo "detail=$detail"
    } > "$STATE.tmp" || die state_write_failed
    $BB mv "$STATE.tmp" "$STATE" || die state_commit_failed
    $BB sync
}

lock_take()
{
    if ! $BB mkdir "$LOCK" 2>/dev/null; then
        die update_busy
    fi
    trap '$BB rmdir "$LOCK" 2>/dev/null' EXIT
}

manifest_value()
{
    key=$1
    $BB sed -n "s/^${key}=//p" "$STAGING/manifest"
}


current_service_profile()
{
    current=$($BB cat /etc/libreecho/service-profile 2>/dev/null)
    case "$current" in
        diagnostic|production)
            CURRENT_SERVICE_PROFILE=$current
            ;;
        *)
            die current_service_profile_unavailable
            ;;
    esac
}










verify_manifest()
{
    case "$(manifest_value format)" in
        libreecho-ota-v3)
            "${TARGET_MANIFEST:-/usr/local/sbin/libreecho-target-manifest}" check "$STAGING/manifest" "$STAGING/manifest.sig" || die target_manifest_invalid
            OTA_FORMAT=v3
            version=$(manifest_value version)
            SERVICE_PROFILE=$(manifest_value service_profile)
            UPDATE_CHANNEL=$(manifest_value update_channel)
            [ "$UPDATE_CHANNEL" = "$(channel_value)" ] || die update_channel_mismatch
            boot_sha=$(manifest_value boot_sha256)
            return 0;;
        libreecho-ota-v1|libreecho-ota-v2) die legacy_manifest_unsupported;;
    esac
    die manifest_format
}

transaction_pending()
{
    [ -e "$PENDING" ] || [ -L "$PENDING" ]

}

extract_and_verify()
{
    package=$1
    [ -f "$package" ] && [ ! -L "$package" ] || die package_not_regular
    # The target confirmation path authenticates the signed generation and
    # boot image. Re-extracting here would delete and replace
    # that evidence -- even from an unrelated `inspect` -- and force a rollback,
    # so refuse to touch $STAGING while a transaction is still pending.
    transaction_pending && die transaction_pending
    [ "$($BB stat -c %s "$package" 2>/dev/null)" -le 33554432 ] ||
        die package_too_large
    members=$($BB tar -tf "$package" 2>/dev/null) || die package_tar_invalid
    [ "$members" = "manifest
manifest.sig
boot.img" ] || die package_member_contract

    $BB rm -f "$STAGING/manifest" "$STAGING/manifest.sig" "$STAGING/boot.img" \
        "$STAGING/boot-write.log" "$STAGING/bootctl.status" "$STAGING/bootctl.activate" \
        "$TRANSACTION_BCB_FILE" 2>/dev/null
    $BB mkdir -p "$STAGING" || die staging_create_failed
    $BB tar -xf "$package" -C "$STAGING" manifest manifest.sig boot.img \
        2>/dev/null || die package_extract_failed
    [ -f "$STAGING/manifest" ] && [ ! -L "$STAGING/manifest" ] &&
        [ -f "$STAGING/manifest.sig" ] &&
        [ ! -L "$STAGING/manifest.sig" ] &&
        [ -f "$STAGING/boot.img" ] && [ ! -L "$STAGING/boot.img" ] ||
        die package_extracted_type
    [ "$($BB stat -c %h "$STAGING/manifest" 2>/dev/null)" = 1 ] &&
        [ "$($BB stat -c %h "$STAGING/manifest.sig" 2>/dev/null)" = 1 ] &&
        [ "$($BB stat -c %h "$STAGING/boot.img" 2>/dev/null)" = 1 ] ||
        die package_extracted_links
    if [ "$ALLOW_UNSIGNED" = 1 ]; then
        $BB printf 'libreecho-update: WARNING signature verification skipped (--allow-unsigned)\n' >&2
    else
        "$VERIFY" "$PUBLIC_KEY" "$STAGING/manifest" "$STAGING/manifest.sig" ||
            die package_signature
    fi
    verify_manifest
    [ "$($BB stat -c %s "$STAGING/boot.img" 2>/dev/null)" = "$BOOT_SIZE" ] ||
        die boot_size
    header=$($BB dd if="$STAGING/boot.img" bs=8 count=1 2>/dev/null |
        $BB od -An -tx1 -v | $BB tr -d ' \n')
    [ "$header" = 414e44524f494421 ] || die boot_android_magic
    actual=$($BB sha256sum "$STAGING/boot.img" | $BB awk '{print $1}')
    [ "$actual" = "$boot_sha" ] || die boot_package_hash
}


bootctl_status()
{
    "$BOOTCTL" status > "$STAGING/bootctl.status" ||
        die boot_control_status
    selected=$($BB sed -n 's/^selected_slot=//p' "$STAGING/bootctl.status")
    inactive=$($BB sed -n 's/^inactive_slot=//p' "$STAGING/bootctl.status")
    case "$selected:$inactive" in
        a:b|b:a) ;;
        *) die boot_control_slots ;;
    esac
    selected_success=$($BB sed -n \
        "s/^slot_${selected}_success=//p" "$STAGING/bootctl.status")
    [ "$selected_success" = 1 ] || die current_slot_not_confirmed
    target=$inactive
    target_device_for_slot "$target"
    write_device=$target_device
    backup_device=
    store_mode=$($BB sed -n 's/^boot_store_mode=//p' "$STAGING/bootctl.status")
    case "$store_mode" in
        ''|slotted) ;;
        fixed-a)
            # Issue #231: the pinned chain's LK always loads boot_a; the BCB
            # selects only the reported suffix and the tries accounting. The
            # candidate must therefore replace boot_a, and the running image is
            # kept in boot_b as the copy the boot path restores after a rollback.
            target_device_for_slot b
            backup_device=$target_device
            target_device_for_slot a
            write_device=$target_device
            ;;
        *) die boot_store_mode ;;
    esac
}

# Preserve the running image before a fixed-a store is overwritten. It must be
# the committed generation's signed image (the boot path converges boot_a onto
# it), so an unrecognised image is never promoted to the recovery copy.
backup_running_boot()
{
    [ -n "$backup_device" ] || return 0
    running_sha=$($BB dd if="$write_device" bs=4096 count=4096 2>/dev/null |
        $BB sha256sum | $BB awk '{print $1}')
    if [ -r "$UPDATE_ROOT/current" ]; then
        committed=$($BB cat "$UPDATE_ROOT/current")
        case "$committed" in ''|.|..|*[!A-Za-z0-9._+~:-]*) die boot_store_committed_pointer;; esac
        committed_sha=$($BB sed -n 's/^boot_sha256=//p' \
            "$GENERATIONS/$committed/target.manifest" 2>/dev/null | $BB head -n 1)
        [ -n "$committed_sha" ] && [ "$running_sha" = "$committed_sha" ] ||
            die boot_store_not_committed
    fi
    $BB dd if="$write_device" of="$backup_device" bs=4096 count=4096 \
        conv=fsync 2>"$STAGING/boot-backup.log" || die boot_backup_write
    backup_sha=$($BB dd if="$backup_device" bs=4096 count=4096 2>/dev/null |
        $BB sha256sum | $BB awk '{print $1}')
    [ "$backup_sha" = "$running_sha" ] || die boot_backup_hash
}

feature_file_sha256()
{
    path=$1
    allow_symlink=${2:-0}
    [ -f "$path" ] || { echo unavailable; return 0; }
    if [ "$allow_symlink" -ne 1 ] && [ -L "$path" ]; then
        echo unavailable
        return 0
    fi
    digest=$($BB sha256sum "$path" 2>/dev/null | $BB awk '{print $1}')
    [ -n "$digest" ] || digest=unavailable
    printf '%s\n' "$digest"
}

transaction_status()
{
    if [ -r "$UPDATE_ROOT/features-status" ] && [ ! -L "$UPDATE_ROOT/features-status" ]; then
        $BB grep -E '^features_(state|error)=[A-Za-z0-9_:-]*$' "$UPDATE_ROOT/features-status"
    fi
    if [ -r "$UPDATE_ROOT/config-status" ] && [ ! -L "$UPDATE_ROOT/config-status" ]; then
        $BB grep -E '^config_(schema|error)=[A-Za-z0-9_:-]*$' "$UPDATE_ROOT/config-status"
    fi
    transaction_state=none
    [ -r "$PENDING" ] && transaction_state=pending
    # The rolled-back marker is retained rollback history, not live state, so it
    # must not mask a pending or committing transaction recorded above.
    [ "$transaction_state" = none ] && [ -r "$UPDATE_ROOT/rolled-back" ] &&
        transaction_state=rollback
    echo "ota_transaction_state=$transaction_state"
    [ "$transaction_state" = pending ] && echo ota_transaction_pending=1
    [ "$transaction_state" = rollback ] && echo ota_transaction_rollback=1

}

feature_status()
{
    [ -f "$UPDATE_ROOT/current" ] && [ ! -L "$UPDATE_ROOT/current" ] || return 1
    current=$($BB cat "$UPDATE_ROOT/current")
    case "$current" in ''|.|..|*[!A-Za-z0-9._+~:-]*) return 1;; esac
    [ "${#current}" -le 96 ] || return 1
    FEATURE_ROOT=$GENERATIONS/$current/features
    for path in "$GENERATIONS" "$GENERATIONS/$current" "$FEATURE_ROOT"; do
        [ ! -L "$path" ] || return 1
    done
    printf 'generation=%s\n' "$current"
    for feature in airplay2 tts wakeword stt assistant; do
        case "$feature" in
            airplay2) daemon=libreecho-audio-engine ;;
            tts) daemon=libreecho-ttsd ;;
            wakeword) daemon=libreecho-waked ;;
            stt) daemon=libreecho-sttd ;;
            assistant) daemon=libreecho-agentd ;;
        esac
        feature_root=$FEATURE_ROOT/$feature
        payload=$feature_root/payload.squashfs
        manifest=$feature_root/manifest.json
        payload_sha=$(feature_file_sha256 "$payload")
        payload_size=unavailable
        if [ -f "$payload" ] && [ ! -L "$payload" ]; then
            payload_size=$($BB stat -c %s "$payload" 2>/dev/null)
            [ -n "$payload_size" ] || payload_size=unavailable
        fi
        manifest_sha=$(feature_file_sha256 "$manifest")
        running_daemon_sha256=not-running
        pid=$($BB pidof "$daemon" 2>/dev/null | $BB awk '{print $1}')
        case "$pid" in
            ''|*[!0-9]*) ;;
            *)
                if [ -r "/proc/$pid/exe" ]; then
                    running_daemon_sha256=$(feature_file_sha256 "/proc/$pid/exe" 1)
                fi
                ;;
        esac
        effective=present
        [ "$payload_sha" != unavailable ] &&
            [ "$manifest_sha" != unavailable ] || effective=missing
        echo "feature_${feature}_payload_sha256=$payload_sha"
        echo "feature_${feature}_payload_size=$payload_size"
        echo "feature_${feature}_manifest_sha256=$manifest_sha"
        echo "feature_${feature}_running_daemon=$daemon"
        echo "feature_${feature}_running_daemon_sha256=$running_daemon_sha256"
        echo "feature_${feature}_effective=$effective"
    done
}




install_package()
{
    INSTALL_PIN=
    package=$1
    require_userdata
    lock_take
    seed_channel
    STATE_DIRTY=1
    state_write verifying 5 package
    extract_and_verify "$package"
    if [ "$OTA_FORMAT" = v3 ]; then
        tx=$(manifest_value transaction_id)
        generation="${GENERATIONS:-/data/libreecho/generations}/$tx"
        [ -f "$generation/target.manifest" ] && [ ! -L "$generation/target.manifest" ] || die generation_manifest_mismatch
        [ "$(sha256sum "$generation/target.manifest" | $BB awk '{print $1}')" = "$(sha256sum "$STAGING/manifest" | $BB awk '{print $1}')" ] || die generation_manifest_mismatch
        # The install lock and authenticated candidate identity transfer ownership
        # before fallible tree verification and boot-control probing. Unverified
        # callers and colliding transaction identities own no pin.
        INSTALL_PIN=$GENERATIONS/$tx.pin
        "${GENERATION_TOOL:-/usr/local/sbin/libreecho-generation}" verify "$generation" || die generation_invalid
    fi
    state_write verified 20 "$version"
    bootctl_status

    state_write writing 30 "$target"
    backup_running_boot
    $BB dd if="$STAGING/boot.img" of="$write_device" bs=4096 \
        conv=fsync 2>"$STAGING/boot-write.log" || die boot_write
    state_write verifying-write 75 "$target"
    written=$($BB dd if="$write_device" bs=4096 count=4096 2>/dev/null |
        $BB sha256sum | $BB awk '{print $1}')
    [ "$written" = "$boot_sha" ] || die boot_write_hash

    if [ "$OTA_FORMAT" = v3 ]; then
        {
            echo schema=3
            echo "slot=$target"
            echo "transaction_id=$tx"
            echo "manifest_sha256=$(sha256sum "$STAGING/manifest" | $BB awk '{print $1}')"
        } > "$PENDING.tmp" || die pending_write
        $BB chmod 0600 "$PENDING.tmp" || die pending_mode
        $BB sync
        $BB mv "$PENDING.tmp" "$PENDING" || die pending_commit
        $BB sync
        $BB rm -f "$GENERATIONS/$tx.pin" || die generation_unpin
        $BB sync

    fi

    state_write activating 90 "$target"
    ACTIVATION_STARTED=1
    "$BOOTCTL" activate "$target" > "$STAGING/bootctl.activate" ||
        die boot_control_activate
    state_write reboot-pending 100 "$target"
    echo "UPDATE_READY slot=$target version=$version"
}

confirm_pending()
{
    require_userdata
    lock_take
    [ -r "$PENDING" ] || die no_pending_update
    pending_schema=$($BB sed -n 's/^schema=//p' "$PENDING")
    if [ "$pending_schema" = 3 ]; then
        slot=$($BB sed -n 's/^slot=//p' "$PENDING")
        target_device_for_slot "$slot"
        ROOT="$UPDATE_ROOT" "$FEATURE_TRANSACTION" verify-running || die feature_target_not_ready
        "$BOOTCTL" confirm "$slot" > "$UPDATE_ROOT/bootctl.confirm" || die boot_control_confirm
        ROOT="$UPDATE_ROOT" "$FEATURE_TRANSACTION" commit || die generation_commit_pending
        state_write installed 100 "$slot"
        echo "UPDATE_CONFIRMED slot=$slot"
        return 0
    fi
    die legacy_manifest_unsupported
}

inspect_package()
{
    package=$1
    require_userdata
    lock_take
    extract_and_verify "$package"
    echo "UPDATE_VALID version=$version"
}

case "${1:-}" in
    status)
        require_userdata
        "$BOOTCTL" status
        [ ! -r "$STATE" ] || $BB cat "$STATE"
        [ ! -r "$PENDING" ] || $BB cat "$PENDING"
        # Issue #41: surface the persistent health-worker restart record so a
        # worker-forced reboot is distinguishable from a hardware watchdog
        # reset during OTA triage.
        [ ! -r "$UPDATE_ROOT/restart-record" ] ||
            { echo restart_record=1; $BB cat "$UPDATE_ROOT/restart-record"; }
        transaction_status
        feature_status
        ;;
    install)
        shift
        if [ "${1:-}" = "--allow-unsigned" ]; then ALLOW_UNSIGNED=1; shift; fi
        [ "$#" -ge 1 ] || die usage
        package=$1; shift
        [ "$ALLOW_UNSIGNED" = 0 ] || die unsigned_target_unsupported
        [ "$#" = 0 ] || die usage
        INSTALL_CLEANUP=1
        install_package "$package"
        ;;
    inspect)
        [ "$#" -eq 2 ] || die usage
        inspect_package "$2"
        ;;
    confirm)
        [ "$#" -eq 1 ] || die usage
        confirm_pending
        ;;
    capabilities)
        # Machine-readable feature list (one token per line) so the web daemon
        # can advertise only what this tool actually supports. Older tools lack
        # this subcommand and fall through to the usage/exit-2 case, which the
        # daemon reads as "unsupported" -- a safe default.
        [ "$#" -eq 1 ] || die usage
        echo immutable-target-v3
        ;;
    *)
        echo "Usage: libreecho-update status | inspect PACKAGE.tar | install [--allow-unsigned] PACKAGE.tar | confirm | capabilities" >&2
        exit 2
        ;;
esac
