#!/bin/busybox sh
# shellcheck shell=dash
# v97-compatible ARM32 recovery control plane.

BB=/bin/busybox

# Exact reviewed post-Amonet Biscuit userdata sizes, in 512-byte sectors.
# Do not accept arbitrary larger partitions or change any other partition.
userdata_size_supported()
{
    case "$1" in
        2137088|2153472) return 0 ;;
        *) return 1 ;;
    esac
}

PATH=/bin:/sbin:/system/bin
export PATH
umask 022

# Service profile is immutable image policy, never userdata policy.  Missing or
# invalid content falls back to the bounded diagnostic graph.
SERVICE_PROFILE_VALUE=$($BB cat /etc/libreecho/service-profile 2>/dev/null)
SERVICE_PROFILE=diagnostic
SERVICE_PROFILE_INVALID=0
case "$SERVICE_PROFILE_VALUE" in
    diagnostic)
        SERVICE_PROFILE=diagnostic
        ;;
    production)
        SERVICE_PROFILE=production
        ;;
    *)
        SERVICE_PROFILE_INVALID=1
        ;;
esac

# Feature policy is immutable image policy. Missing or malformed content fails
# closed to the payload-free graph even if a production service profile was
# accidentally selected.
FEATURE_POLICY_VALUE=$($BB cat /etc/libreecho/feature-policy 2>/dev/null)
FEATURE_POLICY=exclude
FIRST_INSTALL_MARKER=/etc/libreecho/first-install-confirm
STARTUP_READY=${STARTUP_READY:-/run/libreecho/startup-ready}
MDNS_RUNTIME_ROOT=${MDNS_RUNTIME_ROOT:-/usr/local/lib/libreecho-mdns/root}
case "$FEATURE_POLICY_VALUE" in
    preserve|redistributable|community-noncommercial|exclude)
        FEATURE_POLICY=$FEATURE_POLICY_VALUE
        ;;
esac

$BB mkdir -p /dev/pts /dev/usb-ffs/adb /dev/socket /proc /sys /tmp /run/libreecho-control
$BB chmod 0700 /run/libreecho-control
$BB chmod 0777 /tmp

# Create /dev/null before the first stderr redirection.  If it is absent, a
# shell `2>/dev/null` creates a regular file; a later mknod then fails with
# EEXIST.  Replace any non-character placeholder before creating each node.
ensure_chr()
{
	path=$1
	major=$2
	minor=$3
	if [ ! -c "$path" ]; then
		$BB rm -f "$path"
		$BB mknod "$path" c "$major" "$minor"
	fi
}
ensure_chr /dev/null 1 3
ensure_chr /dev/zero 1 5
ensure_chr /dev/full 1 7
ensure_chr /dev/random 1 8
ensure_chr /dev/urandom 1 9
ensure_chr /dev/console 5 1
ensure_chr /dev/tty 5 0
ensure_chr /dev/ptmx 5 2
$BB chmod 0666 /dev/null /dev/zero /dev/full /dev/random /dev/urandom
$BB chmod 0600 /dev/console
$BB chmod 0666 /dev/tty /dev/ptmx

# Android init normally mounts these before parsing init.rc.  Keep the script
# usable in a reduced recovery environment without mounting over /dev, because
# doing so would hide Android's property area and break adbd.
$BB grep -q ' /proc ' /proc/mounts 2>/dev/null || $BB mount -t proc proc /proc 2>/dev/null
$BB grep -q ' /sys ' /proc/mounts 2>/dev/null || $BB mount -t sysfs sysfs /sys 2>/dev/null
$BB grep -q ' /dev/pts ' /proc/mounts 2>/dev/null || $BB mount -t devpts devpts /dev/pts 2>/dev/null

log()
{
	msg="libreecho-init: $*"
	printf '%s\n' "$*" >> /tmp/init.log
	# Explicit priority keeps these diagnostics visible on the UART even when
	# the old /dev/kmsg writer does not default to INFO.
	printf '<6>%s\n' "$msg" > /dev/kmsg 2>/dev/null
	printf '%s\n' "$msg" > /dev/console 2>/dev/null
}

# pmsg is the only userspace pstore input that survives a forced reboot. Keep
# the record deliberately tiny and token-only: arbitrary logs can contain
# credentials, URLs or board identity and must never be mirrored wholesale.
pmsg_marker()
{
    marker=${1:-}
    [ -c /dev/pmsg0 ] || return 0
    case "$marker" in
        ''|*[!A-Za-z0-9._:/=-]*) return 0 ;;
    esac
    [ "${#marker}" -le 160 ] || return 0
    printf 'libreecho-init:%s\n' "$marker" > /dev/pmsg0 2>/dev/null || true
}

# A candidate slot that fails its health confirmation is rebooted by this
# worker, which destroys /tmp and with it $INIT_LOG -- the only place the
# underlying reason is written.  Keep a bounded, scrubbed copy on the
# persistent userdata filesystem so a rollback stays diagnosable after the
# reboot.  The record is deliberately never mirrored to pmsg: it carries more
# than a token, and pmsg stays token-only.
sanitize_failure_text()
{
    $BB sed \
        -e 's#http://[^ ]*#URL#g' \
        -e 's#https://[^ ]*#URL#g' \
        -e 's#ssid:[^ ]*#ssid:SSID#g' \
        -e 's#ssid=[^ ]*#ssid=SSID#g' \
        -e 's#serialno=[^ ]*#serialno=SERIAL#g' \
        -e 's#[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]#MAC#g'
}

# Never fails the caller: recording evidence must not change the boot outcome.
# Prints the record basename on success, nothing otherwise.
persist_failure_log()
{
    : "${FAILURE_LOG_DIR:=/data/libreecho/update}"
    : "${FAILURE_LOG_MAX_BYTES:=8192}"
    : "${FAILURE_LOG_KEEP:=3}"
    : "${INIT_LOG:=/tmp/init.log}"
    reason=${1:-unknown}
    detail=${2:-}
    airplay_start_log=${3:-/tmp/libreecho-airplayd.reconcile.log}
    case "$reason" in
        ''|*[!A-Za-z0-9._-]*) reason=invalid-reason ;;
    esac
    [ -d "$FAILURE_LOG_DIR" ] || return 0
    epoch=$($BB date -u +%s 2>/dev/null)
    case "$epoch" in ''|*[!0-9]*) epoch=0 ;; esac
    # Slot identity at the moment of failure.  The bare `status` form is the
    # only one that reads the boot-control block: `status <slot>` echoes its
    # argument under the same field name, so a difference between what the BCB
    # selects next and the slot actually running is visible only here.
    bootctl=${LIBREECHO_BOOTCTL_TOOL:-/usr/local/sbin/libreecho-bootctl}
    cmdline=${LIBREECHO_CMDLINE_FILE:-/proc/cmdline}
    running_slot=$($BB sed -n 's/.*androidboot.slot_suffix=_\([ab]\).*/\1/p' \
        "$cmdline" 2>/dev/null | $BB head -n 1)
    pending_slot=$($BB sed -n 's/^slot=//p' "$FAILURE_LOG_DIR/pending" 2>/dev/null |
        $BB head -n 1)
    # The transaction tool's journal is $ROOT/feature-commit, not a file named
    # "journal"; fall back to the pending record, which carries the same field
    # while the candidate is still pending.
    transaction_id=$($BB sed -n 's/^transaction_id=//p' \
        "$FAILURE_LOG_DIR/feature-commit" 2>/dev/null | $BB head -n 1)
    [ -n "$transaction_id" ] || transaction_id=$($BB sed -n \
        's/^transaction_id=//p' "$FAILURE_LOG_DIR/pending" 2>/dev/null | $BB head -n 1)
    name=failure-$epoch-$$.log
    target=$FAILURE_LOG_DIR/$name
    tmp=$FAILURE_LOG_DIR/.$name.tmp
    # Cap the free-form detail well below the record budget, so the identity
    # and readback that make the snapshot useful survive truncation.
    detail_limit=$((FAILURE_LOG_MAX_BYTES / 4))
    {
        echo schema=1
        echo "reason=$reason"
        echo "slot_suffix=$running_slot"
        echo "uptime_seconds=$($BB cut -d' ' -f1 /proc/uptime 2>/dev/null)"
        echo "epoch=$epoch"
        echo "running_slot=$running_slot"
        echo "pending_slot=${pending_slot:-none}"
        echo "transaction_id=${transaction_id:-none}"
        echo "--- bcb-readback (bare status: next-boot eligibility, not the running slot)"
        if [ -x "$bootctl" ]; then
            "$bootctl" status 2>/dev/null | $BB head -n 20
        else
            echo bcb-readback-unavailable
        fi
        echo "--- detail"
        printf '%s\n' "$detail" | sanitize_failure_text | $BB head -c "$detail_limit"
        echo
        if $BB grep -q 'feature-reconcile-service-start-failed:airplayd' "$INIT_LOG" 2>/dev/null &&
                [ -r "$airplay_start_log" ]; then
            echo "--- airplayd-reconcile-log"
            # This is the wrapper's bounded start output, not the daemon's
            # unrestricted service log. Redact user-selected names and the
            # common network/device identifiers before persisting it.
            $BB tail -c 1024 "$airplay_start_log" 2>/dev/null | sanitize_failure_text | \
                $BB sed 's/AirPlay service name is "[^"]*"/AirPlay service name is "REDACTED"/g'
        fi
        echo "--- init.log"
        $BB tail -n 120 "$INIT_LOG" 2>/dev/null | sanitize_failure_text
    } > "$tmp" 2>/dev/null || { $BB rm -f "$tmp"; return 0; }
    if $BB head -c "$FAILURE_LOG_MAX_BYTES" "$tmp" > "$tmp.cut" 2>/dev/null; then
        $BB mv "$tmp.cut" "$tmp" 2>/dev/null || $BB rm -f "$tmp.cut"
    fi
    $BB chmod 0600 "$tmp" 2>/dev/null || true
    $BB mv "$tmp" "$target" 2>/dev/null || { $BB rm -f "$tmp"; return 0; }
    $BB sync 2>/dev/null || true
    $BB ls -1dt "$FAILURE_LOG_DIR"/failure-*.log 2>/dev/null |
        $BB tail -n "+$((FAILURE_LOG_KEEP + 1))" |
        while read -r stale; do $BB rm -f "$stale" 2>/dev/null || true; done
    printf '%s\n' "$name"
    return 0
}

# The kernel already carries ramoops/pstore and pmsg support, but this reduced
# userspace previously mounted neither pstore nor the dynamically allocated
# pmsg character device. Materialise both without assuming a fixed major.
setup_pstore()
{
    pstore_dir=/sys/fs/pstore
    $BB mkdir -p "$pstore_dir"
    if ! $BB grep -q " $pstore_dir " /proc/mounts 2>/dev/null; then
        $BB mount -t pstore pstore "$pstore_dir" 2>/tmp/pstore-mount.log || return 1
    fi
    log pstore-mounted

    i=0
    while [ "$i" -lt 10 ] && [ ! -r /sys/class/pmsg/pmsg0/dev ]; do
        $BB sleep 1
        i=$((i + 1))
    done
    if [ -r /sys/class/pmsg/pmsg0/dev ]; then
        devno=$($BB cat /sys/class/pmsg/pmsg0/dev 2>/dev/null)
        case "$devno" in
            ''|*[!0-9:]*|*:*:*) ;;
            *)
                major=${devno%:*}
                minor=${devno#*:}
                if [ ! -c /dev/pmsg0 ]; then
                    $BB rm -f /dev/pmsg0
                    $BB mknod /dev/pmsg0 c "$major" "$minor" 2>/dev/null || true
                fi
                if [ -c /dev/pmsg0 ]; then
                    $BB chmod 0600 /dev/pmsg0 2>/dev/null
                    log pmsg-ready
                    pmsg_marker pstore-ready
                else
                    log pmsg-node-failed
                fi
                ;;
        esac
    else
        log pmsg-sysfs-unavailable
    fi
    return 0
}
if ! setup_pstore; then
    log pstore-mount-failed
fi

# Production LAN exposure requires a valid WebUI account database even when
# the optional SSH bundle is absent. Keep this validator aligned with the SSH
# supervisor's fail-closed account contract.
web_users_file_ready()
{
	users_file=/data/libreecho/config/users
	[ -f "$users_file" ] && [ ! -L "$users_file" ] || return 1
	[ "$($BB stat -c %u "$users_file" 2>/dev/null)" = 0 ] || return 1
	[ "$($BB stat -c %a "$users_file" 2>/dev/null)" = 600 ] || return 1
	$BB awk -F: '
		function ishex(value,    rest, removed) {
			rest = value
			removed = gsub(/[0-9A-Fa-f]/, "", rest)
			return removed == length(value)
		}
		BEGIN { good = 1; count = 0 }
		{
			if (length($0) > 255) { good = 0; next }
			if ($0 ~ /^[[:space:]]*$/ || $0 ~ /^[[:space:]]*#/) next
			name = tolower($1)
			if (NF != 4 || length($1) < 1 || length($1) > 31 ||
				name == "root" || name == "." || name == ".." ||
				$1 !~ /^[A-Za-z0-9._-]+$/ ||
				$2 != "sha256" || length($3) < 16 || length($3) > 64 ||
				!ishex($3) || length($4) != 64 || !ishex($4)) {
				good = 0
				next
			}
			if (name in seen) good = 0
			seen[name] = 1
			count++
		}
		END { exit (good && count > 0 && count <= 8) ? 0 : 1 }
	' "$users_file"
}

if [ "$SERVICE_PROFILE_INVALID" -eq 1 ]; then
    log service-profile-invalid-fallback-diagnostic
else
    log "service-profile:$SERVICE_PROFILE"
fi

create_audio_nodes()
{
    nodes=0
    $BB mkdir -p /dev/snd
    for sys_sound in /sys/class/sound/*; do
        [ -r "$sys_sound/dev" ] || continue
        name=${sys_sound##*/}
        case "$name" in
            ''|*/*) continue ;;
            dsp|mixer|audio|adsp|sequencer|timer) target="/dev/$name" ;;
            *) target="/dev/snd/$name" ;;
        esac
        devno=$($BB cat "$sys_sound/dev" 2>/dev/null)
        case "$devno" in
            ''|*[!0-9:]*|*:*:*) continue ;;
        esac
        major=${devno%:*}
        minor=${devno#*:}
        [ -n "$major" ] && [ -n "$minor" ] || continue
        if [ ! -e "$target" ]; then
            $BB mknod "$target" c "$major" "$minor" 2>/dev/null || continue
        fi
        [ -c "$target" ] || continue
        $BB chmod 0660 "$target" 2>/dev/null
        nodes=$((nodes + 1))
    done
    $BB chmod 0755 /dev/snd 2>/dev/null
    AUDIO_NODES_CREATED=$nodes
}

create_input_nodes()
{
    nodes=0
    $BB mkdir -p /dev/input
    for sys_input in /sys/class/input/input*; do
        [ -d "$sys_input" ] || continue
        for sys_event in "$sys_input"/event*; do
            [ -r "$sys_event/dev" ] || continue
            name=${sys_event##*/}
            case "$name" in
                event[0-9]*) ;;
                *) continue ;;
            esac
            target="/dev/input/$name"
            devno=$($BB cat "$sys_event/dev" 2>/dev/null)
            case "$devno" in
                ''|*[!0-9:]*|*:*:*) continue ;;
            esac
            major=${devno%:*}
            minor=${devno#*:}
            [ -n "$major" ] && [ -n "$minor" ] || continue
            if [ ! -e "$target" ]; then
                $BB mknod "$target" c "$major" "$minor" 2>/dev/null || continue
            fi
            [ -c "$target" ] || continue
            $BB chmod 0660 "$target" 2>/dev/null
            nodes=$((nodes + 1))
        done
    done
    $BB chmod 0755 /dev/input 2>/dev/null
    INPUT_NODES_CREATED=$nodes
}

log init-started
pmsg_marker init-started

# Give every device a stable, human-readable network identity before Wi-Fi,
# DHCP, mDNS, and the control-plane daemons start. A user-selected hostname on
# userdata wins; IDME supplies only the immutable first-boot default.
set_boot_hostname()
{
    hostname=
    hostname_source=default
    config=/data/libreecho/config/web-config.json
    hostname_persisted=
    if [ -r "$config" ]; then
        hostname_persisted=$($BB sed -n \
            's/^[[:space:]]*"hostname_persisted"[[:space:]]*:[[:space:]]*true[[:space:]]*,*[[:space:]]*$/yes/p' \
            "$config" 2>/dev/null | $BB head -n 1)
    fi
    if [ "$hostname_persisted" = yes ]; then
        saved_hostname=$($BB sed -n \
            's/^[[:space:]]*"hostname"[[:space:]]*:[[:space:]]*"\([^"]*\)"[[:space:]]*,*[[:space:]]*$/\1/p' \
            "$config" 2>/dev/null | $BB head -n 1)
        case "$saved_hostname" in
            ''|-*|*-|*[!A-Za-z0-9-]*)
                log hostname-persisted-invalid
                ;;
            *)
                if [ "${#saved_hostname}" -le 63 ]; then
                    hostname=$saved_hostname
                    hostname_source=persisted
                else
                    log hostname-persisted-invalid
                fi
                ;;
        esac
    fi

    if [ -n "$hostname" ]; then
        :
    else
    serial=$($BB dd if=/proc/idme/serial bs=1 count=32 2>/dev/null |
        $BB tr -cd 'A-Za-z0-9')
    if [ "${#serial}" -lt 4 ]; then
        log hostname-idme-serial-unavailable
        return 1
    fi
    serial_prefix=${serial%????}
    serial_suffix=${serial#"$serial_prefix"}
    hostname="LibreEcho-$serial_suffix"
    fi
    if printf '%s\n' "$hostname" > /proc/sys/kernel/hostname 2>/dev/null; then
        log "hostname-set:$hostname:$hostname_source"
        return 0
    fi
    log hostname-set-failed
    return 1
}

# Android's reduced ramdisk does not mount devtmpfs over /dev: doing so hides
# the property area needed by adbd.  Materialize only the ALSA character
# devices advertised by sysfs instead, with a bounded retry for late probes.
audio_node_worker()
{
    i=0
    while [ "$i" -lt 20 ]; do
        create_audio_nodes
        if [ "${AUDIO_NODES_CREATED:-0}" -gt 0 ]; then
            log "audio-devnodes-created:$AUDIO_NODES_CREATED"
            return 0
        fi
        $BB sleep 1
        i=$((i + 1))
    done
    log audio-devnodes-timeout
    return 1
}
audio_node_worker &
log audio-node-worker-started

# The reduced ramdisk deliberately does not mount devtmpfs over /dev.  Expose
# evdev nodes from the input devices' sysfs major/minor numbers instead, so
# GPIO keys and the MTK keypad can be consumed by a root event/trigger service.
input_node_worker()
{
    i=0
    while [ "$i" -lt 20 ]; do
        create_input_nodes
        if [ "${INPUT_NODES_CREATED:-0}" -gt 0 ]; then
            log "input-devnodes-created:$INPUT_NODES_CREATED"
            return 0
        fi
        $BB sleep 1
        i=$((i + 1))
    done
    log input-devnodes-timeout
    return 1
}
input_node_worker &
log input-node-worker-started

# Linux 6.1 has no Android android_usb class.  Compose an ADB-only gadget with
# ConfigFS and FunctionFS, and bind the UDC only after adbd publishes endpoints.
G=/sys/kernel/config/usb_gadget/libreecho
ffs_ready=0
$BB mkdir -p /sys/kernel/config
if ! $BB grep -q ' /sys/kernel/config ' /proc/mounts 2>/dev/null; then
    if $BB mount -t configfs configfs /sys/kernel/config 2>/tmp/configfs.log; then
        log configfs-mounted
    else
        log configfs-mount-failed
    fi
else
    log configfs-already-mounted
fi

if $BB grep -q ' /sys/kernel/config ' /proc/mounts 2>/dev/null; then
    $BB mkdir -p "$G" "$G/strings/0x409" \
        "$G/configs/c.1/strings/0x409" "$G/functions/ffs.adb"
    echo 0x18d1 > "$G/idVendor"
    echo 0xd001 > "$G/idProduct"
    echo 0x0200 > "$G/bcdUSB"
    serial=$($BB sed -n 's/.*androidboot.serialno=\([^ ]*\).*/\1/p' /proc/cmdline)
    echo "${serial:-libreecho}" > "$G/strings/0x409/serialnumber"
    echo LibreEcho > "$G/strings/0x409/manufacturer"
    echo MT8163-ARM32-ADB > "$G/strings/0x409/product"
    echo adb > "$G/configs/c.1/strings/0x409/configuration"
    echo 120 > "$G/configs/c.1/MaxPower"
    [ -e "$G/configs/c.1/ffs.adb" ] || \
        $BB ln -s "$G/functions/ffs.adb" "$G/configs/c.1/ffs.adb"
    log configfs-adb-composition-created

    if $BB mount -t functionfs -o uid=2000,gid=2000 adb /dev/usb-ffs/adb 2>/tmp/functionfs.log; then
        log functionfs-mounted
        # Linux 6.1 is built with DAC as its security model and has no SELinux
        # filesystem.  Passing Android's root_seclabel makes this static adbd
        # exit before opening FunctionFS, so retain only its device banner.
        # HW18 enables adbd's own bounded trace so UART can distinguish a
        # missing transport thread from a FunctionFS endpoint failure.
        export ADB_TRACE=all
        /sbin/adbd --device_banner=device </dev/null >/tmp/adbd.log 2>&1 &
        adbd_pid=$!
        log "adbd-started:$adbd_pid"

        i=0
        while [ "$i" -lt 15 ]; do
            if [ -e /dev/usb-ffs/adb/ep1 ] && [ -e /dev/usb-ffs/adb/ep2 ]; then
                ffs_ready=1
                break
            fi
            if ! $BB kill -0 "$adbd_pid" 2>/dev/null; then
                wait "$adbd_pid" 2>/dev/null
                log "adbd-exit-status:$?"
                log adbd-exited-early
                break
            fi
            $BB sleep 1
            i=$((i + 1))
        done

        if [ "$ffs_ready" -eq 1 ]; then
            log functionfs-ready
            udc=
            for candidate in /sys/class/udc/*; do
                [ -e "$candidate" ] || continue
                udc=${candidate##*/}
                break
            done
            if [ -n "$udc" ] && echo "$udc" > "$G/UDC" 2>/tmp/configfs-udc-bind.err; then
                log "configfs-udc-bound:$udc"
                # The port is dr_mode="otg" so the role can be switched at
                # runtime, which the storage toggle needs.  The cost is that the
                # boot role is otherwise decided by ID/VBUS detection, and that
                # proved unreliable -- ADB came up on some boots and not others,
                # which is unacceptable for the only recovery path this device
                # has.  Pin it to device so the gadget is unconditional; the
                # toggle moves it to host later, and every boot resets it here.
                for role_sx in /sys/class/usb_role/*/role; do
                    [ -w "$role_sx" ] || continue
                    if printf device > "$role_sx" 2>/dev/null; then
                        log "usb-role-pinned-device:${role_sx#/sys/class/usb_role/}"
                    else
                        log "usb-role-pin-failed:${role_sx#/sys/class/usb_role/}"
                    fi
                done
                # Capture one bounded userspace snapshot after the host has had
                # time to send CNXN.  Never loop: repeated ADB reconnects would
                # otherwise flood the authoritative UART record.
                (
                    $BB sleep 8
                    log adbd-diagnostic-begin
                    if $BB kill -0 "$adbd_pid" 2>/dev/null; then
                        for fd in /proc/"$adbd_pid"/fd/*; do
                            [ -e "$fd" ] || continue
                            target=$($BB readlink "$fd" 2>/dev/null)
                            log "adbd-fd:${fd##*/}:$target"
                        done
                        for task in /proc/"$adbd_pid"/task/*; do
                            [ -d "$task" ] || continue
                            tid=${task##*/}
                            comm=$($BB cat "$task/comm" 2>/dev/null)
                            state=$($BB sed -n 's/^State:[[:space:]]*//p' "$task/status" 2>/dev/null)
                            wchan=$($BB cat "$task/wchan" 2>/dev/null)
                            log "adbd-task:$tid:$comm:$state:$wchan"
                        done
                    else
                        log adbd-diagnostic-process-gone
                    fi
                    if [ -s /tmp/adbd.log ]; then
                        $BB tail -n 40 /tmp/adbd.log | while IFS= read -r line; do
                            log "adbd-log:$line"
                        done
                    else
                        log adbd-log-empty
                    fi
                    log adbd-diagnostic-end
                ) &
            else
                ffs_ready=0
                log configfs-udc-bind-failed
            fi
        else
            log functionfs-not-ready
            [ -s /tmp/adbd.log ] && \
                $BB tail -n 8 /tmp/adbd.log | $BB sed 's/^/<3>adbd: /' > /dev/kmsg 2>/dev/null
        fi
    else
        log functionfs-mount-failed
    fi
else
    log configfs-unavailable
fi

# Persistent readiness evidence for the control plane.  pmsg survives a forced
# reboot, so a boot where adb never came up is distinguishable from one where
# it did -- adbd's own diagnostics live on the ramdisk and are lost with it.
#
# The configured transport is read from the image, not inferred from the running
# system.  A canonical build is USB FunctionFS-only, so the absence of a TCP
# listener is the expected policy outcome and must never be reported as a
# failure; a TCP listener is only probed when the image says one is configured.
ADBD_TRANSPORT_FILE=/etc/libreecho/adb-transport
adbd_tcp_configured=0
if [ -r "$ADBD_TRANSPORT_FILE" ]; then
    log adb-transport-policy-read
    if $BB sed -n 's/^tcp_listener=//p' "$ADBD_TRANSPORT_FILE" 2>/dev/null |
            $BB grep -qx true; then
        adbd_tcp_configured=1
    fi
else
    # No policy record means the image does not know its own transport, so no
    # conclusion about TCP may be drawn from its absence.
    log adb-transport-policy-absent
fi
if [ "${ffs_ready:-0}" -eq 1 ]; then
    pmsg_marker adb-ffs-ready
else
    pmsg_marker adb-ffs-not-ready
fi
# USB endpoint readiness is the transport this build actually uses.
if [ "${ffs_ready:-0}" -eq 1 ] && [ -e /dev/usb-ffs/adb/ep0 ] &&
   [ -e /dev/usb-ffs/adb/ep1 ]; then
    pmsg_marker adb-usb-endpoints-ready
else
    pmsg_marker adb-usb-endpoints-missing
fi
# Daemon liveness, not a listener guess. The state must be 0A (LISTEN) and the
# 5555 port must appear in the local address of a listening row, on the
# wildcard or a loopback address. The remote side must be the wildcard: a
# listening row with a real remote address is a client socket, and a row whose
# remote port is 5555 in state 01 is a connection *to* adbd, not a listener.
adb_listening() {
    $BB awk 'NR > 1 && $4 == "0A" {
                 split($2, l, ":")
                 split($3, r, ":")
                 if (l[2] == "15B3" && (l[1] == "00000000" || l[1] == "0100007F"))
                     listening = 1
                 if (r[2] == "15B3" && r[1] == "00000000") listening = 1
             }
             END { exit(listening ? 0 : 1) }' \
        /proc/net/tcp /proc/net/tcp6 2>/dev/null
}
if [ "$adbd_tcp_configured" -eq 1 ]; then
    i=0
    while [ "$i" -lt 5 ] && ! adb_listening; do
        $BB sleep 1
        i=$((i + 1))
    done
    if adb_listening; then
        pmsg_marker adb-tcp-5555-bound
    else
        pmsg_marker adb-tcp-5555-unbound
    fi
else
    # Expected for a USB-only build: the policy, not a failure.
    pmsg_marker adb-tcp-not-configured
fi

# The GPT used by Biscuit exposes expdb as Linux partition 7.  Wait for the
# kernel's block identity, then create direct aliases from sysfs rather than
# assuming MMC minor numbers.
EXPDB=/dev/mmcblk0p7
EXPDB_SYS=/sys/class/block/mmcblk0p7
i=0
while [ "$i" -lt 10 ] && [ ! -r "$EXPDB_SYS/dev" ]; do
    $BB sleep 1
    i=$((i + 1))
done
for sys_block in /sys/class/block/mmcblk0 /sys/class/block/mmcblk0p*; do
    [ -r "$sys_block/dev" ] || continue
    name=${sys_block##*/}
    devno=$($BB cat "$sys_block/dev" 2>/dev/null)
    major=${devno%:*}
    minor=${devno#*:}
    if [ -z "$major" ] || [ -z "$minor" ]; then
        continue
    fi
    [ -b "/dev/$name" ] || $BB mknod "/dev/$name" b "$major" "$minor" 2>/dev/null
done

# Mount only the verified userdata partition.  The AirPlay payload and other
# optional assets live here, while persist/IDME remains untouched because it
# carries board identity, MAC addresses, and calibration data.  Do not
# auto-format or repair this partition from the initramfs: a failed mount is
# recoverable through ADB and must not turn boot into a destructive operation.
USERDATA=/dev/mmcblk0p16
USERDATA_SYS=/sys/class/block/mmcblk0p16
USERDATA_MOUNT=/data
userdata_mount()
{
    i=0
    while [ "$i" -lt 15 ] && [ ! -r "$USERDATA_SYS/dev" ]; do
        $BB sleep 1
        i=$((i + 1))
    done

    if [ ! -b "$USERDATA" ] ||
       ! $BB grep -qx 'PARTNAME=userdata' "$USERDATA_SYS/uevent" 2>/dev/null ||
       ! userdata_size_supported "$($BB cat "$USERDATA_SYS/size" 2>/dev/null)"; then
        log userdata-identity-rejected
        return 1
    fi

    $BB mkdir -p "$USERDATA_MOUNT"
    if $BB grep -q " $USERDATA_MOUNT " /proc/mounts 2>/dev/null; then
        log userdata-already-mounted
        return 0
    fi

    if $BB mount -t ext4 -o rw,nosuid,nodev,noatime "$USERDATA" "$USERDATA_MOUNT" \
       >/tmp/userdata-mount.log 2>&1; then
        log userdata-mounted
        return 0
    fi
    log userdata-mount-failed
    return 1
}
if userdata_mount; then
    if [ -x /usr/local/sbin/libreecho-data-cleanup ]; then
        if DATA_ROOT=/data /usr/local/sbin/libreecho-data-cleanup \
                >/tmp/data-cleanup.log 2>&1; then
            DATA_CLEANUP_OK=1
            log userdata-cleanup-ok
        else
            DATA_CLEANUP_OK=0
            log userdata-cleanup-contract-failed
        fi
    else
        DATA_CLEANUP_OK=0
        log userdata-cleanup-missing
    fi
else
    DATA_CLEANUP_OK=0
    log userdata-unavailable
fi
VENDOR_ASSETS_OK=0
if [ "${DATA_CLEANUP_OK:-0}" -eq 1 ] &&
        [ -x /usr/local/sbin/libreecho-vendor-import ] &&
        [ -x /sbin/wmt_configure ] &&
        [ -x /sbin/wmt_responder ] &&
        [ -x /sbin/wmt_bt_on ] &&
        [ -x /sbin/wmt_stock_compat ] &&
        [ -x /sbin/wmt_launcher ]; then
    if DATA_ROOT=/data /usr/local/sbin/libreecho-vendor-import \
            >/tmp/vendor-import.log 2>&1; then
        VENDOR_ASSETS_OK=1
        log vendor-assets-ready
    else
        log vendor-assets-unavailable
    fi
else
    log vendor-assets-import-skipped
fi
set_boot_hostname || true

if [ -x /etc/init.d/libreecho-ssh.init ]; then
    if /etc/init.d/libreecho-ssh.init start >/tmp/libreecho-ssh.init.log 2>&1; then
        log ssh-supervisor-started
    else
        log ssh-supervisor-start-failed
    fi
fi

expdb_devno=$($BB cat "$EXPDB_SYS/dev" 2>/dev/null)
expdb_major=${expdb_devno%:*}
expdb_minor=${expdb_devno#*:}
expected_rdev=
case "$expdb_devno" in
    *:*) expected_rdev=$($BB printf '%x:%x' "$expdb_major" "$expdb_minor") ;;
esac

IMAGE_PROFILE=$($BB cat /etc/libreecho/image-profile 2>/dev/null)
case "$IMAGE_PROFILE" in
    development)
        # Development images arm the next-reset fastboot escape. OTA images
        # must not do this because A/B retry and rollback require normal boots.
        marker_written=0
        marker_attempt=0
        while [ "$marker_written" -eq 0 ]; do
            marker_attempt=$((marker_attempt + 1))
            if [ -b "$EXPDB" ] && [ -n "$expected_rdev" ] &&
               [ "$($BB stat -c '%t:%T' "$EXPDB" 2>/dev/null)" = "$expected_rdev" ] &&
               $BB grep -qx 'PARTNAME=expdb' "$EXPDB_SYS/uevent" 2>/dev/null &&
               [ "$($BB cat "$EXPDB_SYS/size" 2>/dev/null)" = 20480 ]; then
                if printf FASTBOOT_PLEASE > "$EXPDB" 2>/tmp/expdb-marker.err; then
                    $BB sync
                    marker=$($BB dd if="$EXPDB" bs=15 count=1 2>/dev/null)
                    [ "$marker" = FASTBOOT_PLEASE ] && marker_written=1
                fi
            elif [ $((marker_attempt % 10)) -eq 1 ]; then
                log expdb-identity-rejected
            fi
            if [ "$marker_written" -eq 0 ]; then
                if [ $((marker_attempt % 10)) -eq 0 ]; then
                    log fastboot-please-retry
                fi
                $BB sleep 1
            fi
        done
        log fastboot-please-written
        ;;
    ota)
        log automatic-fastboot-marker-disabled
        ;;
    *)
        log image-profile-invalid
        IMAGE_PROFILE=invalid
        ;;
esac

# Independent recovery supervisor.  This loop is intentionally separate from
# runme_loop: a blocked experiment must never prevent an operator or host
# harness from requesting a controlled reboot into fastboot.
reboot_request_loop()
{
    while true; do
        if [ -f /tmp/reboot.request ]; then
            request=$($BB cat /tmp/reboot.request 2>/dev/null)
            $BB rm -f /tmp/reboot.request
            case "$request" in
                fastboot)
                    log reboot-request-fastboot-accepted
                    if printf FASTBOOT_PLEASE > "$EXPDB" 2>/tmp/reboot-marker.err; then
                        $BB sync
                        marker=$($BB dd if="$EXPDB" bs=15 count=1 2>/dev/null)
                        if [ "$marker" = FASTBOOT_PLEASE ]; then
                            log reboot-request-marker-verified
                            $BB reboot -f
                        else
                            log reboot-request-marker-readback-failed
                        fi
                    else
                        log reboot-request-marker-write-failed
                    fi
                    ;;
                reboot)
                    log reboot-request-reboot-accepted
                    $BB reboot -f
                    ;;
                *)
                    log reboot-request-rejected
                    ;;
            esac
        fi
        $BB sleep 1
    done
}
reboot_request_loop &
log reboot-supervisor-started

# busybox's halt/poweroff/reboot applets do their work by signalling PID 1 --
# they assume busybox init is there to catch it.  PID 1 here is this shell, so
# without these traps the signal is discarded and `reboot` exits 0 having done
# nothing at all, which reads as success.  Route each signal at the same forced
# transition the recovery supervisor above already performs.
signal_transition()
{
    log "reboot-signal-$1-accepted"
    $BB sync
    case "$1" in
        halt)     $BB halt -f ;;
        poweroff) $BB poweroff -f ;;
        *)        $BB reboot -f ;;
    esac
}
trap 'signal_transition reboot'   TERM
trap 'signal_transition reboot'   INT
trap 'signal_transition halt'     USR1
trap 'signal_transition poweroff' USR2
log reboot-signal-traps-installed

# Stable MediaTek connectivity aliases.  btif is dynamically allocated and is
# intentionally left to devtmpfs/ueventd.
[ -c /dev/wmtWifi ] || $BB mknod /dev/wmtWifi c 153 0 2>/dev/null
[ -c /dev/wmtdetect ] || $BB mknod /dev/wmtdetect c 154 0 2>/dev/null
[ -c /dev/stpwmt ] || $BB mknod /dev/stpwmt c 190 0 2>/dev/null
[ -e /dev/wmt ] || $BB ln -s stpwmt /dev/wmt 2>/dev/null
[ -c /dev/stpbt ] || $BB mknod /dev/stpbt c 192 0 2>/dev/null
$BB chmod 0666 /dev/wmtWifi /dev/wmtdetect /dev/stpwmt /dev/stpbt 2>/dev/null
log wmt-nodes-created

# The network stack is build-time opt-in, but activation remains an explicit
# operator request after ADB.  This preserves the USB diagnostic control plane
# across the historical WMT/WLAN failure boundary.
# No Wi-Fi MAC override on this hardware.
#
# The driver generates an address when nothing supplies one, and not the same
# one each boot, so the device takes a new DHCP lease after most restarts. idme
# records the address the board was built with, and applying it looked like the
# obvious fix -- but the driver refuses it:
#
#     ip link set dev wlan0 address fc:a1:83:70:79:33
#     ip: ioctl 0x8924 failed: Not supported
#
# SIOCSIFHWADDR is rejected with the link up or down, there is no NVRAM file or
# module parameter exposing it, and nothing in dmesg suggests the address is
# read from anywhere writable. Setting it would need firmware or driver work
# rather than a boot script, so there is nothing to run here.
#
# The web UI still reports the board's address beside the one in use, which is
# what makes the difference visible.

start_wifi_network_sequence()
{
    packaged_wifi=/etc/wifi/wpa_supplicant.conf
    persistent_wifi=/data/libreecho/config/wpa_supplicant.conf
    wifi_profile=
    if $BB grep -q ' /data ' /proc/mounts 2>/dev/null; then
        $BB mkdir -p /data/libreecho/config
        $BB chmod 0700 /data/libreecho /data/libreecho/config 2>/dev/null
        if [ -r "$persistent_wifi" ]; then
            $BB chmod 0600 "$persistent_wifi" 2>/dev/null
            wifi_profile=$persistent_wifi
            log wifi-persistent-profile-selected
        elif [ -r "$packaged_wifi" ]; then
            persistent_wifi_tmp=$persistent_wifi.tmp
            if $BB sed 's/^update_config=.*/update_config=1/' \
                "$packaged_wifi" > "$persistent_wifi_tmp" &&
               $BB chmod 0600 "$persistent_wifi_tmp" &&
               $BB mv "$persistent_wifi_tmp" "$persistent_wifi"; then
                log wifi-persistent-profile-created
                wifi_profile=$persistent_wifi
                log wifi-persistent-profile-selected
            else
                $BB rm -f "$persistent_wifi_tmp"
                log wifi-persistent-profile-create-failed
            fi
        fi
    fi
    if [ -z "$wifi_profile" ] && [ -r "$packaged_wifi" ]; then
        wifi_profile=$packaged_wifi
        log wifi-packaged-profile-selected
    fi
    [ -n "$wifi_profile" ] || { log wifi-profile-absent; return 2; }
    log wifi-profile-present
    # This is the proven manual choreography from session e8c21eb3bbae:
    # stock-compatible configure-only init, stale-launcher cleanup, exactly one
    # one-shot command responder, then one timed Wi-Fi function-on write.  Do
    # not substitute the stock wmt_loader here; that path exits 255 on this
    # image before creating wlan0.
    /sbin/wmt_stock_compat --device /dev/wmt --firmware-dir /lib/firmware \
        --no-function-on >/tmp/wifi-wmt-configure.log 2>&1 || {
        log wifi-stock-compat-failed
        return 1
    }
    stale=$($BB pidof wmt_launcher 2>/dev/null)
    if [ -n "$stale" ]; then
        $BB kill -9 $stale 2>/dev/null
        $BB sleep 1
    fi
    stale_after=$($BB pidof wmt_launcher 2>/dev/null)
    [ -z "$stale_after" ] || { log wifi-stale-launcher-remains; return 1; }
    /sbin/wmt_launcher --device /dev/wmt --ok --once \
        >/tmp/wifi-wmt-responder.log 2>&1 &
    responder_pid=$!
    $BB sleep 1
    responder_count=$($BB pidof wmt_launcher 2>/dev/null | $BB wc -w)
    [ "$responder_count" -eq 1 ] || {
        $BB kill -TERM "$responder_pid" 2>/dev/null
        wait "$responder_pid" 2>/dev/null
        log wifi-launcher-count-failed
        return 1
    }
    log wifi-launcher-ready
    $BB timeout 30 /bin/busybox sh -c "printf '1' > /dev/wmtWifi" \
        >/tmp/wifi-function-on.log 2>&1
    wifi_on_rc=$?
    log "wifi-function-on-rc:$wifi_on_rc"
    responder_wait=0
    while $BB kill -0 "$responder_pid" 2>/dev/null &&
          [ "$responder_wait" -lt 10 ]; do
        $BB sleep 1
        responder_wait=$((responder_wait + 1))
    done
    if $BB kill -0 "$responder_pid" 2>/dev/null; then
        $BB kill -TERM "$responder_pid" 2>/dev/null
        $BB sleep 1
        $BB kill -KILL "$responder_pid" 2>/dev/null
        wait "$responder_pid" 2>/dev/null
        log wifi-launcher-exit-timeout
        return 1
    fi
    wait "$responder_pid" 2>/dev/null
    responder_rc=$?
    log "wifi-launcher-rc:$responder_rc"
    [ "$responder_rc" -eq 0 ] || { log wifi-launcher-failed; return 1; }
    [ "$wifi_on_rc" -eq 0 ] || { log wifi-function-on-failed; return "$wifi_on_rc"; }
    i=0
    while [ "$i" -lt 30 ] && [ ! -e /sys/class/net/wlan0 ]; do
        $BB sleep 1
        i=$((i + 1))
    done
    [ -e /sys/class/net/wlan0 ] || { log wlan0-registration-timeout; return 1; }
    WIFI_CONF="$wifi_profile" /sbin/libreecho-wifi start \
        >/tmp/wifi-client.log 2>&1
    client_rc=$?
    log "wifi-client-rc:$client_rc"
    return "$client_rc"
}

start_wifi_network()
{
    if [ "${VENDOR_ASSETS_OK:-0}" -ne 1 ]; then
        printf 'LIBREECHO_WIFI_REJECTED=vendor-assets-unavailable\n' > /tmp/wifi.status
        log wifi-vendor-assets-unavailable
        return 4
    fi
    # The WMT firmware path is intentionally single-shot per boot.  mkdir is
    # the atomic claim for the operator-request path.
    if ! $BB mkdir /tmp/wifi.activation.claim 2>/dev/null; then
        log wifi-activation-duplicate-rejected
        return 3
    fi
    printf 'LIBREECHO_WIFI_STARTED\n' > /tmp/wifi.status
    start_wifi_network_sequence
    wifi_rc=$?
    printf 'LIBREECHO_WIFI_RC=%s\n' "$wifi_rc" > /tmp/wifi.status
    log "wifi-activation-complete:$wifi_rc"
    return "$wifi_rc"
}

# Preserve the golden manual activation path as a single-shot operator gate.
# The supervisor is launched only after FunctionFS/ADB is ready below.  A
# second request in the same boot is refused because retrying a failed WMT
# activation without a cold reset produced misleading firmware-ready failures.
wifi_request_loop()
{
    while true; do
        if [ -f /tmp/wifi.request ] && [ ! -e /tmp/wifi.request.active ]; then
            $BB mv /tmp/wifi.request /tmp/wifi.request.active
            wifi_request=$($BB sed -n '1p' /tmp/wifi.request.active 2>/dev/null)
            $BB rm -f /tmp/wifi.request.active
            case "$wifi_request" in
                start)
                    if [ -d /tmp/wifi.activation.claim ]; then
                        printf 'LIBREECHO_WIFI_REJECTED=already-attempted\n' > /tmp/wifi.status
                        log wifi-request-duplicate-rejected
                        continue
                    fi
                    log wifi-request-start-accepted
                    start_wifi_network
                    wifi_rc=$?
                    log "wifi-request-complete:$wifi_rc"
                    ;;
                *)
                    printf 'LIBREECHO_WIFI_REJECTED=invalid-request\n' > /tmp/wifi.status
                    log wifi-request-invalid-rejected
                    ;;
            esac
        fi
        $BB sleep 1
    done
}
# The recovery image's minimal userspace does not inherit Android's loopback
# address.  Bring up IPv4 loopback before manual services such as the web
# daemon bind to their safe 127.0.0.1 default.
if $BB ifconfig lo 127.0.0.1 up >/tmp/loopback-config.log 2>&1; then
    log loopback-configured
else
    log loopback-config-failed
fi

# Connectivity comes up on the boot path, not at the end of init: reachability
# (OTA, AirPlay, and the OTA health probes that need the network) must not
# depend on the service graph having started.  This is the single automatic
# activation.  Its conditions are unchanged from the original late call -- a
# profile-bearing image performs one bounded activation after the ADB/FunctionFS
# control plane is ready (HW61, matching the verified 3.18 baseline), and a
# diagnostic image keeps connectivity manual/single-shot.  The ADB control
# plane is already established above, so the FunctionFS condition is satisfied
# by construction here.  start_wifi_network keeps its single-shot claim, so a
# failed activation still refuses a second attempt in the same boot, and the
# request supervisor below remains available for the free-claim case.
if [ "${VENDOR_ASSETS_OK:-0}" -ne 1 ]; then
    log wifi-network-skipped-vendor-assets-unavailable
elif [ "$SERVICE_PROFILE" = diagnostic ]; then
    log wifi-network-policy-manual-single-shot
elif [ "${ffs_ready:-0}" -eq 1 ]; then
    start_wifi_network >>/tmp/wifi-boot.log 2>&1 &
    log wifi-network-worker-started-after-adb
    pmsg_marker wifi-boot-activation
else
    log wifi-network-skipped-adb-not-ready
fi

# Preserve v97's root command loop, but never let one experiment monopolize
# the control plane.  A request is atomically claimed as runme.active, then
# executed under a hard timeout with a separate cancellation poller.  The
# reboot supervisor above remains independent even while this child is stuck.
RUNME_TIMEOUT=${LIBREECHO_RUNME_TIMEOUT:-120}
runme_loop()
{
    while true; do
        if [ -f /run/libreecho-control/runme ] &&
                [ ! -e /run/libreecho-control/runme.active ]; then
            $BB mv /run/libreecho-control/runme /run/libreecho-control/runme.active
            $BB rm -f /run/libreecho-control/runme.cancel
            printf 'LIBREECHO_RUNME_STARTED\n' > /run/libreecho-control/runme.status
            $BB setsid $BB timeout -k 2 "$RUNME_TIMEOUT" /bin/busybox sh \
                /run/libreecho-control/runme.active > /run/libreecho-control/result 2>&1 &
            runme_pid=$!
            cancelled=0
            while $BB kill -0 "$runme_pid" 2>/dev/null; do
                if [ -f /run/libreecho-control/runme.cancel ]; then
                    cancelled=1
                    $BB rm -f /run/libreecho-control/runme.cancel
                    log runme-cancel-requested
                    $BB kill -TERM -- "-$runme_pid" 2>/dev/null
                    $BB sleep 1
                    $BB kill -KILL -- "-$runme_pid" 2>/dev/null
                    break
                fi
                $BB sleep 1
            done
            wait "$runme_pid" 2>/dev/null
            runme_rc=$?
            if [ "$cancelled" -eq 1 ]; then
                runme_rc=125
                printf 'LIBREECHO_RUNME_CANCELLED\n' >> /run/libreecho-control/result
                printf 'LIBREECHO_RUNME_CANCELLED\n' > /run/libreecho-control/runme.status
            elif [ "$runme_rc" -eq 124 ]; then
                $BB kill -KILL -- "-$runme_pid" 2>/dev/null
                printf 'LIBREECHO_RUNME_TIMEOUT=%s\n' "$RUNME_TIMEOUT" >> /run/libreecho-control/result
                printf 'LIBREECHO_RUNME_TIMEOUT=%s\n' "$RUNME_TIMEOUT" > /run/libreecho-control/runme.status
                log runme-timeout
            else
                printf 'LIBREECHO_RUNME_RC=%s\n' "$runme_rc" >> /run/libreecho-control/result
                printf 'LIBREECHO_RUNME_RC=%s\n' "$runme_rc" > /run/libreecho-control/runme.status
            fi
            $BB rm -f /run/libreecho-control/runme.active
        fi
        $BB sleep 1
    done
}
runme_loop &
log runme-loop-started

log init-ready-pid1-managed

# The boot path activates the network above.  This supervisor additionally lets
# ADB request an activation when the single-shot claim is still free, so an
# operator can retry after capturing the passive boot boundary.
wifi_request_loop &
log wifi-request-supervisor-started

# The UI control plane is part of the image contract.  Start each daemon in a
# fixed order once loopback exists; the init scripts remain idempotent and
# write their own PID files, so a later manual restart is safe.  Starting
# audiod only opens the adapter and never initiates playback.  micd starts
# with capture idle and opens the microphone endpoint only for an explicit
# stream request.
# Export the owner's timezone so every daemon renders local time.
#
# The image carries no /usr/share/zoneinfo and busybox ignores /etc/TZ, so the
# only mechanism that works here is the TZ environment variable holding a
# POSIX TZ string (verified on-device: TZ=CST6CDT,M3.2.0,M11.1.0 yields CDT).
# Inherited by the whole service graph because this runs before it starts.
apply_timezone()
{
    tz_config=/data/libreecho/config/web-config.json
    tz_value=
    if [ -r "$tz_config" ]; then
        tz_value=$($BB sed -n \
            's/.*"timezone"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "$tz_config" 2>/dev/null | $BB head -n 1)
    fi
    case "$tz_value" in
        # Only a plain POSIX TZ string; anything else falls back to UTC so a
        # malformed config cannot inject arbitrary environment content.
        ''|*[!A-Za-z0-9,.:+/-]*) tz_value=UTC ;;
    esac
    TZ=$tz_value
    export TZ
    log "timezone-applied:$tz_value"
}

start_persisted_feature_services()
{
    script=/usr/local/sbin/libreecho-reconcile-features
    if [ ! -x "$script" ]; then
        log feature-reconcile-helper-missing
        return 1
    fi
    "$script"
    rc=$?
    log "persisted-feature-reconcile:$rc"
    return "$rc"
}

# The shared mDNS responder is boot-contained Platform infrastructure owned by
# /etc/init.d/libreecho-mdnsd.init.  It is deliberately independent of feature
# policy and of any AirPlay payload mount: Home Assistant discovery must work
# when no AirPlay squashfs is installed.  Discovery degradation is reported but
# never blocks the management UI or startup-ready, which stay separate gates.
start_shared_discovery_runtime()
{
    case "$SERVICE_PROFILE" in
        production) ;;
        *)
            log shared-discovery-runtime-skipped-diagnostic-profile
            pmsg_marker mdns-skipped-diagnostic
            return 0
            ;;
    esac
    if [ ! -x /etc/init.d/libreecho-mdnsd.init ]; then
        log shared-discovery-runtime-unavailable
        pmsg_marker mdns-init-unavailable
        return 0
    fi
    if /etc/init.d/libreecho-mdnsd.init start >/tmp/libreecho-mdnsd.init.log 2>&1; then
        log shared-discovery-runtime-started
        pmsg_marker mdns-started
    else
        log shared-discovery-runtime-degraded
        pmsg_marker mdns-start-failed
    fi
    return 0
}

# Which slot is running. The bootloader on this family writes the suffix empty
# (`androidboot.slot_suffix=_`), so the kernel command line frequently does not
# say -- measured on the biscuit Dot, whose cmdline carries the key with no
# value. The boot control block is then the only thing that knows, which is why
# ota_health_confirm_worker already falls back to it after
# running-slot-not-reported. Both the local-install adoption and the candidate
# mount need the same answer, so they ask the same question.
running_slot_id()
{
    slot_cmdline=${LIBREECHO_CMDLINE_FILE:-/proc/cmdline}
    slot_bootctl=${LIBREECHO_BOOTCTL_TOOL:-/usr/local/sbin/libreecho-bootctl}
    slot=$($BB sed -n 's/.*androidboot.slot_suffix=_\([ab]\).*/\1/p' \
        "$slot_cmdline" 2>/dev/null | $BB head -n 1)
    if [ -z "$slot" ] && [ -x "$slot_bootctl" ]; then
        slot=$("$slot_bootctl" status 2>/dev/null |
            $BB sed -n 's/^selected_slot=//p' | $BB head -n 1)
    fi
    case "$slot" in
        a|b) printf '%s\n' "$slot" ;;
    esac
}

# A TWRP install stages a complete tree, writes both boot slots and leaves the
# release's OTA package on /data -- and stops there. Nothing that runs in
# recovery can prepare the feature transaction: prepare-boot belongs to this
# image, and the tree is only complete after the format. So the boot this image
# is running adopts it, once, under a fingerprint strict enough that nothing
# else can trigger it: the staged SIGNED manifest must name the exact boot image
# that is running, which is what binds a staged tree to the install that made
# it. An existing transaction, a non-OTA image profile, an unreadable manifest
# or a boot hash that does not match is left alone for a human with the log.
adopt_staged_local_install()
{
    # Environment overrides, the same way libreecho-feature-transaction
    # exposes its own: this decision lives on the boot path and cannot be reached
    # by any test that has to boot a device, so the paths it reads are named.
    install_root=${LIBREECHO_INSTALL_ROOT:-/data/libreecho/update}
    install_slot_a=${LIBREECHO_SLOT_A_DEVICE:-/dev/mmcblk0p10}
    install_slot_b=${LIBREECHO_SLOT_B_DEVICE:-/dev/mmcblk0p11}
    install_transaction=${LIBREECHO_TRANSACTION_TOOL:-/usr/local/sbin/libreecho-feature-transaction}
    [ "$IMAGE_PROFILE" = ota ] || return 0
    install_staging=$install_root/staging
    [ -r "$install_staging/manifest" ] || return 0
    [ -d "$install_staging/features" ] || return 0
    for install_live in feature-commit pending installed; do
        if [ -e "$install_root/$install_live" ]; then
            # A transaction already exists: this tree is not unattended work.
            log "local-install-transaction-present:$install_live"
            return 0
        fi
    done
    install_want=$($BB sed -n 's/^boot_sha256=//p' "$install_staging/manifest" 2>/dev/null |
        $BB head -n 1)
    case "$install_want" in
        ''|*[!0-9a-f]*) log local-install-manifest-unreadable; return 0 ;;
    esac
    [ "${#install_want}" -eq 64 ] || { log local-install-manifest-unreadable; return 0; }
    install_slot=$(running_slot_id)
    case "$install_slot" in
        a) install_device=$install_slot_a ;;
        b) install_device=$install_slot_b ;;
        *) log local-install-running-slot-unknown; return 0 ;;
    esac
    install_hash=$($BB sha256sum "$install_device" 2>/dev/null | $BB awk '{print $1}')
    [ -n "$install_hash" ] || { log local-install-running-hash-unavailable; return 0; }
    if [ "$install_hash" != "$install_want" ]; then
        # The staged tree describes some other image. Adopting it would commit
        # features against bytes this slot is not running.
        log "local-install-staged-tree-mismatch:$install_slot"
        return 0
    fi
    if [ ! -x "$install_transaction" ]; then
        log local-install-transaction-unavailable
        return 0
    fi
    log "local-install-adopting:$install_slot"
    pmsg_marker local-install-adopting
    # The transaction is prepared for the slot that is RUNNING, not for the
    # other one: a TWRP install writes both slots and boots one of them, so
    # `libreecho-update install` -- which models the OTA case and therefore
    # targets `inactive_slot` -- would prepare a candidate the booted slot is
    # not, and this boot would take the failed-candidate path. prepare-boot
    # takes its slot from this file, and preflight is the free-space check the
    # OTA path runs immediately before it.
    if ! $BB printf '%s\n' "$install_slot" > "$install_root/transaction-slot.tmp"; then
        log local-install-slot-write-failed
        return 0
    fi
    if ! $BB mv "$install_root/transaction-slot.tmp" "$install_root/transaction-slot"; then
        log local-install-slot-write-failed
        $BB rm -f "$install_root/transaction-slot.tmp" 2>/dev/null
        return 0
    fi
    if "$install_transaction" preflight "$install_staging/manifest" prewrite \
            > /tmp/local-install.log 2>&1 &&
       "$install_transaction" prepare-boot >> /tmp/local-install.log 2>&1; then
        log local-install-prepared
        pmsg_marker local-install-prepared
        return 0
    fi
    # Services still start. A staged tree that will not prepare is reported, not
    # turned into an appliance that cannot be reached without a serial console.
    log local-install-prepare-failed
    pmsg_marker local-install-preparation-failed
    return 0
}

# A fresh install has nothing committed yet, and the service graph is gated on
# the live feature tree: the reconciler reads
# $DATA_ROOT/libreecho/features/<feature>, which stays empty until the
# transaction commits. So the feature services are deferred, startup-ready is
# never written, and the commit -- which waits for startup-ready before
# confirming the slot -- never runs either. That deadlock is why a
# TWRP-installed unit only came up completely on its second boot.
#
# Complete the commit on the boot that installed it. The candidate tree was just
# validated for this running slot, and there is nothing to roll back to: this
# path is scoped to a device with no installed record and no committed evidence,
# so an upgrade, which has a base and a previous version worth falling back to,
# keeps the confirm-then-commit sequence it has today.
commit_fresh_install()
{
    install_root=${LIBREECHO_INSTALL_ROOT:-/data/libreecho/update}
    install_bootctl=${LIBREECHO_BOOTCTL_TOOL:-/usr/local/sbin/libreecho-bootctl}
    install_transaction_tool=${LIBREECHO_TRANSACTION_TOOL:-/usr/local/sbin/libreecho-feature-transaction}

    [ "$IMAGE_PROFILE" = ota ] || return 0
    [ -r "$install_root/pending" ] || return 0
    [ -r "$install_root/feature-commit" ] || return 0
    # Anything already committed means this is not a fresh install.
    [ -e "$install_root/installed" ] && return 0
    [ -e "$install_root/committed-manifest" ] && return 0
    [ -e "$install_root/committed-manifest.sig" ] && return 0
    [ -x "$install_transaction_tool" ] || return 0

    fresh_slot=$(running_slot_id)
    case "$fresh_slot" in
        a|b) ;;
        *) log fresh-commit-running-slot-unknown; return 0 ;;
    esac
    fresh_pending_slot=$($BB sed -n 's/^slot=//p' "$install_root/pending" 2>/dev/null | $BB head -n 1)
    [ "$fresh_pending_slot" = "$fresh_slot" ] || {
        # The prepared transaction belongs to another slot: this boot is the
        # fallback path, not the install it describes.
        log "fresh-commit-pending-slot-other:$fresh_slot"
        return 0
    }
    [ -x "$install_bootctl" ] || return 0
    # commit requires a confirmed slot and a boot-control readback, and on a
    # fresh install the confirmation would otherwise happen later in this boot,
    # after the commit has already been skipped.
    "$install_bootctl" confirm "$fresh_slot" >/dev/null 2>&1 || {
        log fresh-commit-bootctl-confirm-failed
        return 0
    }
    $BB mkdir -p "$install_root/staging" 2>/dev/null
    "$install_bootctl" status > "$install_root/staging/bootctl.readback" 2>/dev/null || {
        log fresh-commit-bootctl-readback-failed
        return 0
    }
    if ! "$install_transaction_tool" commit-after-confirm \
            > /tmp/fresh-install-commit.log 2>&1; then
        # Services still start: a staged set that will not commit is reported,
        # and the existing confirm/commit path still gets its chance later.
        log fresh-commit-rejected
        pmsg_marker fresh-commit-rejected
        return 0
    fi
    if ! "$install_transaction_tool" activate-committed \
            >> /tmp/fresh-install-commit.log 2>&1; then
        log fresh-commit-activation-rejected
        pmsg_marker fresh-commit-activation-rejected
        return 0
    fi
    log fresh-install-committed
    pmsg_marker fresh-install-committed
    return 0
}

activate_feature_transaction()
{
    adopt_staged_local_install
    transaction=/usr/local/sbin/libreecho-feature-transaction
    [ -x "$transaction" ] || return 0
    update=/data/libreecho/update
    journal=$update/feature-commit
    journal_phase=
    if [ -r "$journal" ]; then
        journal_phase=$($BB sed -n 's/^phase=//p' "$journal" 2>/dev/null)
    fi
    if [ "$journal_phase" = installed ]; then
        "$transaction" recover-installed || { log feature-transaction-cleanup-recovery-rejected; return 1; }
    elif [ "$journal_phase" = confirmed ]; then
        # A commit interrupted after the journal became 'confirmed' -- and after
        # one or more staged files were already moved -- must be resumed here.
        # The candidate activation path below still requires the pre-commit
        # staging files, so it would fail and leave services blocked even though
        # the BCB is confirmed. commit-after-confirm is idempotent and re-checks
        # the BCB itself.
        "$transaction" commit-after-confirm || { log feature-transaction-commit-resume-rejected; return 1; }
    fi
    if [ ! -r "$update/pending" ]; then
        "$transaction" activate-committed || { log feature-transaction-committed-rejected; return 1; }
        return 0
    fi
    schema=$($BB sed -n 's/^schema=//p' "$update/pending" 2>/dev/null)
    [ "$schema" = 2 ] || return 0
    pending_slot=$($BB sed -n 's/^slot=//p' "$update/pending" 2>/dev/null)
    running_slot=$(running_slot_id)
    [ "$running_slot" = "$pending_slot" ] || { log feature-transaction-fallback-canonical; return 0; }
    $BB mkdir -p "$update/staging" || { log feature-transaction-staging-failed; return 1; }
    if /usr/local/sbin/libreecho-bootctl status > "$update/staging/bootctl.readback" 2>/dev/null; then
        if ! activation_error=$("$transaction" activate-mounts 2>&1); then
            log feature-transaction-activation-rejected
            pmsg_marker feature-activation-rejected
            persist_failure_log feature-activation-rejected "$activation_error" >/dev/null 2>&1
            return 1
        fi
        log feature-transaction-candidate-mounted
        pmsg_marker feature-candidate-mounted
        commit_fresh_install
        return 0
    fi
    log feature-transaction-bcb-read-failed
    pmsg_marker feature-bcb-read-failed
    return 1
}

start_ui_services()
{
    [ -x /usr/local/sbin/libreecho-web ] || {
        log ui-services-not-installed
        return 0
    }
    if ! activate_feature_transaction; then
        log ui-services-blocked-by-feature-transaction
        return 1
    fi
    apply_timezone
    $BB mkdir -p /var/run /var/log /var/log/libreecho /run/libreecho
    if [ "$SERVICE_PROFILE" = production ] && [ "${DATA_CLEANUP_OK:-0}" -ne 1 ]; then
        log ui-services-blocked-by-data-contract
        return 1
    fi
    if [ "$SERVICE_PROFILE" = diagnostic ] || [ "$FEATURE_POLICY" = exclude ]; then
        services="logd timed web"
        if [ "$FEATURE_POLICY" = exclude ]; then
            log feature-services-excluded
        else
            log ui-connectivity-services-disabled-for-diagnostic-profile
        fi
    else
    ha_enabled=0
    config=/data/libreecho/config/web-config.json
    if [ -r "$config" ]; then
        integrations=$($BB sed -n \
            's/.*"integrations"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
            "$config" 2>/dev/null | $BB head -n 1)
        case "$integrations" in
            ''|*[!0-9]*) ;;
            *) [ $((integrations & 1)) -ne 0 ] && ha_enabled=1 ;;
        esac
    fi
    if [ "$FEATURE_POLICY" = preserve ] ||
            [ "$FEATURE_POLICY" = community-noncommercial ]; then
        if [ "$ha_enabled" -eq 1 ]; then
            log ui-home-assistant-mode-enabled
            services="logd networkd timed audiod micd waked ledd buttond btd timerd"
            services="$services airplayd radiod wyomingd web"
        else
            services="logd networkd timed audiod micd waked"
            services="$services ledd buttond btd timerd"
            services="$services airplayd radiod ttsd web"
        fi
        if [ "$FEATURE_POLICY" = community-noncommercial ]; then
            log ui-services-community-noncommercial-with-wakeword
        fi
    else
        if [ "$ha_enabled" -eq 1 ]; then
            services="logd networkd timed audiod micd waked ledd buttond btd timerd"
            services="$services airplayd radiod wyomingd web"
        else
            services="logd networkd timed audiod micd waked"
            services="$services ledd buttond btd timerd"
            services="$services airplayd radiod ttsd web"
        fi
        log ui-services-redistributable-without-wakeword
    fi
    fi
    # Deferred-contract snapshots are retained for the payload reconciler and
    # its host contract checks:
    # services="logd networkd timed audiod micd ledd buttond btd web"
    # services="logd networkd timed audiod micd ledd buttond btd wyomingd web"
    start_shared_discovery_runtime
    log feature-services-deferred-until-staged
    for service in $services; do
        script="/etc/init.d/libreecho-$service.init"
        if [ -x "$script" ]; then
            if [ "$service" = web ] && [ "$SERVICE_PROFILE" = production ]; then
                # The control plane is intentionally reachable on the LAN in
                # every production state, including first-run setup.  Binding
                # conditionally on the users file left the already-running
                # daemon on loopback after setup created the first account.
                web_listen=0.0.0.0:8080
                log ui-web-production-lan
                ARGS="--backend linux --config /data/libreecho/config/web-config.json --web-root /usr/local/share/libreecho/web --listen $web_listen" \
                    "$script" start >/tmp/libreecho-"$service".init.log 2>&1
            else
                "$script" start >/tmp/libreecho-"$service".init.log 2>&1
            fi
            rc=$?
            log "ui-service-start:$service:$rc"
            if [ "$service" = web ]; then
                if [ "$rc" -eq 0 ]; then pmsg_marker web-start-ok; else pmsg_marker web-start-failed; fi
            fi
        else
            log "ui-service-missing:$service"
        fi
    done
    start_persisted_feature_services
}
start_ui_services &
log ui-services-autostart-started

ota_health_confirm_worker()
{
    [ "$IMAGE_PROFILE" = ota ] || return 0

    # Publish the terminal status for a rollback that has actually completed.
    # Automatic finalization must leave a reader-visible record that the
    # rollback finished, otherwise `libreecho-update status` and the web API
    # keep reporting the failed candidate's last health check and a phantom
    # reboot after the previously confirmed slot is already running again.
    ota_rollback_publish_terminal()
    {
        rollback_failed_slot=$1
        {
            echo schema=1
            echo state=rolled-back
            echo progress=100
            echo "detail=$rollback_failed_slot"
        } > /data/libreecho/update/state.tmp &&
            $BB mv /data/libreecho/update/state.tmp \
                /data/libreecho/update/state || {
                log ota-rollback-state-publish-failed
                $BB rm -f /data/libreecho/update/state.tmp
                return 1
            }
        # The failed candidate's last act is to leave the check record at
        # `reboot-pending`.  That record is now false: the rollback completed
        # and the device is running the previously confirmed slot, so without
        # this the update check status stays frozen until the next scheduled
        # check.  Rewrite it only when the newest checked version is the one
        # that rolled back, so a record belonging to a different candidate is
        # never relabelled.
        rollback_version=$($BB sed -n 's/^version=//p' \
            /data/libreecho/update/rolled-back 2>/dev/null)
        if [ -n "$rollback_version" ] &&
           [ "$($BB sed -n 's/^status=//p' /data/libreecho/update/check-status 2>/dev/null)" = reboot-pending ] &&
           [ "$($BB sed -n 's/^latest_version=//p' /data/libreecho/update/check-status 2>/dev/null)" = "$rollback_version" ]; then
            $BB sed 's/^status=reboot-pending$/status=update-held-after-rollback/' \
                /data/libreecho/update/check-status \
                > /data/libreecho/update/check-status.tmp &&
                $BB mv /data/libreecho/update/check-status.tmp \
                    /data/libreecho/update/check-status || {
                    log ota-rollback-check-status-publish-failed
                    $BB rm -f /data/libreecho/update/check-status.tmp
                    return 1
                }
            log "ota-rollback-check-status-update-held-after-rollback:$rollback_version"
        fi
        $BB sync
    }

    # The recovery helper reports success by removing the transaction it
    # validated.  Confirm that post-condition on the filesystem before
    # claiming the rollback is finalized: a helper that exits early, or a
    # refusal that still returns zero, must never be turned into a terminal
    # status asserting that the live transaction is gone.
    ota_v2_fallback_confirmed()
    {
        for rollback_live in pending feature-commit; do
            [ ! -e "/data/libreecho/update/$rollback_live" ] || {
                log "ota-v2-fallback-live-evidence-remains:$rollback_live"
                return 1
            }
        done
        [ ! -e /data/libreecho/update/staging ] || {
            log ota-v2-fallback-staging-remains
            return 1
        }
        [ -r /data/libreecho/update/rolled-back ] || {
            log ota-v2-fallback-history-missing
            return 1
        }
        return 0
    }

    # The recovery helper validates the rollback history before it acts on it,
    # and only ever treats a bounded regular non-symlink as evidence, so the
    # resume that authorizes the same removals from that record applies the
    # same shape test before it reads a slot or a transaction id out of it.  A
    # path that is a symlink -- for example one pointing at a surviving live
    # record -- is never rollback evidence, let alone authorization to remove
    # the records it names.  The caller decides which refusal to log.
    ota_rollback_resume_history_bounded()
    {
        resume_history=/data/libreecho/update/rolled-back
        [ -e "$resume_history" ] || [ -L "$resume_history" ] || return 1
        [ -f "$resume_history" ] || return 1
        [ ! -L "$resume_history" ] || return 1
        resume_history_size=$($BB stat -c %s "$resume_history" 2>/dev/null)
        case "$resume_history_size" in
            ''|*[!0-9]*) return 1 ;;
        esac
        [ "$resume_history_size" -le 8192 ] || return 1
        return 0
    }

    # A lock this worker holds is tagged with the boot it was taken in.  The
    # install lock lives in persistent /data, and the update flow's own protocol
    # has no answer for a holder that never released it -- and this worker can
    # be that holder, because it runs on the boot after a power loss, which is
    # exactly when another loss can land between taking the lock and releasing
    # it.  An untagged lock (an installation, which never writes this tag) or
    # one taken by this boot is never reclaimed; only this worker's own tag
    # naming an earlier boot is.  The tag is required rather than best effort:
    # a lock that cannot be tagged could not be recovered after a power loss,
    # so it is given back instead of being held.
    ota_rollback_resume_tag_lock()
    {
        [ -n "$resume_boot_id" ] || return 1
        printf 'owner=rollback-resume\nboot_id=%s\n' "$resume_boot_id" \
            > "$resume_lock/owner" 2>/dev/null
    }

    ota_rollback_resume_install_lock()
    {
        resume_lock=/data/libreecho/update/install.lock
        if $BB mkdir "$resume_lock" 2>/dev/null; then
            if ota_rollback_resume_tag_lock; then
                return 0
            fi
            $BB rmdir "$resume_lock" 2>/dev/null
            log ota-rollback-resume-lock-untagged
            return 1
        fi
        # The lock is held.  Only this worker's own tag from an earlier boot is
        # recoverable; anything else -- the flow's own lock, or one this boot
        # took -- is an owner that has not finished.
        [ "$($BB sed -n 's/^owner=//p' "$resume_lock/owner" 2>/dev/null)" = rollback-resume ] || {
            log ota-rollback-resume-install-locked
            return 1
        }
        resume_held_boot=$($BB sed -n 's/^boot_id=//p' "$resume_lock/owner" 2>/dev/null)
        case "$resume_held_boot" in
            ''|"$resume_boot_id")
                log ota-rollback-resume-install-locked
                return 1
                ;;
        esac
        $BB rm -f "$resume_lock/owner" 2>/dev/null
        $BB rmdir "$resume_lock" 2>/dev/null || {
            log ota-rollback-resume-install-locked
            return 1
        }
        $BB mkdir "$resume_lock" 2>/dev/null || {
            log ota-rollback-resume-install-locked
            return 1
        }
        if ota_rollback_resume_tag_lock; then
            log ota-rollback-resume-lock-recovered
            return 0
        fi
        $BB rmdir "$resume_lock" 2>/dev/null
        log ota-rollback-resume-lock-untagged
        return 1
    }

    # Both resumed removals act inside the update root the update flow stages
    # into, so they are serialized with that flow under its own two locks, taken
    # in the order the flow takes them: the boot-local fetch lock it holds while
    # it downloads feature assets straight into the staging tree, then the
    # persistent install lock it holds while it writes the transaction.  It
    # releases the install lock before that download and re-takes it for the
    # install, so the fetch lock is what protects a tree being written, and a
    # fetch or installation in flight owns the tree until it finishes: this boot
    # leaves the records unpublished for the next boot to retry instead of
    # removing what it is writing.
    ota_rollback_resume_lock()
    {
        $BB mkdir -p /run/libreecho 2>/dev/null
        $BB mkdir /run/libreecho/fetch.lock 2>/dev/null || {
            log ota-rollback-resume-fetch-locked
            return 1
        }
        if ! ota_rollback_resume_install_lock; then
            $BB rmdir /run/libreecho/fetch.lock 2>/dev/null
            return 1
        fi
        return 0
    }

    ota_rollback_resume_unlock()
    {
        $BB rm -f /data/libreecho/update/install.lock/owner 2>/dev/null
        $BB rmdir /data/libreecho/update/install.lock 2>/dev/null
        $BB rmdir /run/libreecho/fetch.lock 2>/dev/null
    }

    # The recovery helper retires the transaction and only then removes its
    # staging tree, and it refuses to run again once the transaction is gone,
    # so an interruption between those two steps leaves a cleanup that no
    # other production path finishes: without it a later boot would report
    # neither a live transaction nor a finished rollback, on every boot.  A
    # replacement for the legacy single-slot updater and the recovery runner
    # both own the same tree, so the removal is validated the way the helper
    # validates it -- a staging tree that is a symlink, is not a directory, or
    # contains a symlink is left for recovery instead -- and it runs under the
    # locks its caller took, which is what keeps a tree staged by a concurrent
    # installation from being removed in this rollback's name.  Validation is
    # separate from the removal so that a tree which cannot be validated is
    # refused before anything else is read out of the update root.
    ota_rollback_resume_staging_validate()
    {
        resume_staging=/data/libreecho/update/staging
        [ -e "$resume_staging" ] || [ -L "$resume_staging" ] || return 0
        if [ -L "$resume_staging" ] ||
           [ ! -d "$resume_staging" ] ||
           [ -n "$($BB find "$resume_staging" -type l -print -quit 2>/dev/null)" ]; then
            log ota-rollback-resume-staging-unsafe
            return 1
        fi
        return 0
    }

    ota_rollback_resume_staging_cleanup()
    {
        resume_staging=/data/libreecho/update/staging
        [ -e "$resume_staging" ] || [ -L "$resume_staging" ] || return 0
        $BB rm -rf "$resume_staging" || {
            log ota-rollback-resume-staging-cleanup-failed
            return 1
        }
        $BB sync
        log ota-rollback-resume-staging-cleaned
        return 0
    }

    # The helper retires the live transaction with one `rm -f` of the pending
    # record and the feature commit, and it exits immediately once either is
    # gone -- `fallback` and `abort-before-activation` both require the pair --
    # so an interruption between those two unlinks leaves a one-sided record
    # that no other production path finishes.  The consequence is permanent
    # rather than cosmetic: the surviving feature commit is the durable v2
    # journal, so the update flow refuses to stage anything else, and the
    # resume below would never reach publication.  Only a record that carries
    # the transaction id of the finalized `rolled-back` history is retired,
    # and only while its other half is already gone: a complete pair is a live
    # transaction, whose own rollback branch owns those records.  The records
    # are only *checked* here -- nothing is removed until the rollback evidence
    # below has proven, from the helper's own contracts, which transaction this
    # residue is -- so a shaped-but-forged history record can never authorize
    # the removal of a record whose identity was taken from it.
    ota_rollback_resume_live_records_check()
    {
        resume_live_survivors=
        [ ! -e /data/libreecho/update/pending ] ||
            [ ! -e /data/libreecho/update/feature-commit ] || return 1
        for resume_live in pending feature-commit; do
            resume_live_path=/data/libreecho/update/$resume_live
            [ -e "$resume_live_path" ] || [ -L "$resume_live_path" ] || continue
            [ -f "$resume_live_path" ] && [ ! -L "$resume_live_path" ] || {
                log "ota-rollback-resume-live-record-unsafe:$resume_live"
                return 1
            }
            [ "$($BB sed -n 's/^transaction_id=//p' "$resume_live_path" 2>/dev/null)" = \
                "$resume_transaction" ] || {
                log "ota-rollback-resume-live-record-foreign:$resume_live"
                return 1
            }
            resume_live_survivors="$resume_live_survivors $resume_live"
        done
        return 0
    }

    ota_rollback_resume_live_records_remove()
    {
        for resume_live in $resume_live_survivors; do
            resume_live_path=/data/libreecho/update/$resume_live
            $BB rm -f "$resume_live_path" || {
                log "ota-rollback-resume-live-record-cleanup-failed:$resume_live"
                return 1
            }
            $BB sync
            log "ota-rollback-resume-live-record-cleaned:$resume_live"
        done
        return 0
    }

    # True while the update root still holds rollback residue: a one-sided live
    # record, or a staged tree.  Nothing but residue needs evidence -- requiring
    # it for a finalization that has nothing left to remove would strand the
    # publication this path exists to complete.
    ota_rollback_resume_residue()
    {
        for resume_residue in pending feature-commit; do
            [ -e "/data/libreecho/update/$resume_residue" ] ||
                [ -L "/data/libreecho/update/$resume_residue" ] || continue
            return 0
        done
        resume_residue=/data/libreecho/update/staging
        [ -e "$resume_residue" ] || [ -L "$resume_residue" ] || return 1
        return 0
    }

    # The only authorization this worker accepts for removing a surviving live
    # record or the staged tree is the packaged helper's read-only rollback
    # evidence: the signed staged manifest, the durable prepared journal, the
    # BCB the bootloader fell back from, and the untouched feature state.  The
    # `rolled-back` record is inert history -- unsigned, in userdata, and
    # replaceable by any writer -- so its shape and selected fields are never
    # treated as authorization, and the evidence must name the same transaction
    # and slot this boot's decision was taken against.  Anything unproven is
    # refused and left exactly as it was found, for recovery.
    ota_rollback_resume_rollback_evidence()
    {
        resume_evidence=$(/usr/local/sbin/libreecho-feature-transaction rollback-evidence 2>/dev/null) || {
            log ota-rollback-resume-rollback-evidence-unproven
            return 1
        }
        resume_evidence_transaction=$(printf '%s\n' "$resume_evidence" |
            $BB sed -n 's/^rollback-evidence transaction_id=\([^ ]*\) slot=.*/\1/p')
        resume_evidence_slot=$(printf '%s\n' "$resume_evidence" |
            $BB sed -n 's/^rollback-evidence transaction_id=[^ ]* slot=\([^ ]*\)$/\1/p')
        case "$resume_evidence_transaction:$resume_evidence_slot" in
            *:|:*) log ota-rollback-resume-rollback-evidence-unproven; return 1 ;;
        esac
        [ "$resume_evidence_transaction" = "$resume_transaction" ] &&
            [ "$resume_evidence_slot" = "$resume_slot" ] || {
            log "ota-rollback-resume-rollback-evidence-mismatch:$resume_evidence_transaction:$resume_evidence_slot"
            return 1
        }
        log "ota-rollback-resume-rollback-evidence-proven:$resume_transaction:$resume_slot"
        return 0
    }

    # Every input the locked removals and the publication act on is read once
    # more after the locks are taken, against the values this boot decided with:
    # a history or progress record that was replaced while the boot was deciding
    # must not be removed, published over, or used to authorize a removal.
    ota_rollback_resume_records_unchanged()
    {
        [ "$($BB sed -n 's/^slot=//p' "$resume_history" 2>/dev/null)" = \
            "$resume_slot" ] || {
            log ota-rollback-resume-history-changed
            return 1
        }
        [ "$($BB sed -n 's/^transaction_id=//p' "$resume_history" 2>/dev/null)" = \
            "$resume_transaction" ] || {
            log ota-rollback-resume-history-changed
            return 1
        }
        [ "$($BB sed -n 's/^schema=//p' "$resume_history" 2>/dev/null)" = \
            "$resume_schema" ] || {
            log ota-rollback-resume-history-changed
            return 1
        }
        [ "$($BB sed -n 's/^state=//p' /data/libreecho/update/state 2>/dev/null)" = \
            "$resume_state" ] || {
            log ota-rollback-resume-state-changed
            return 1
        }
        return 0
    }

    # The terminal publication writes `state.tmp` and `check-status.tmp`, the
    # same two staging paths a concurrent update check and install write, so a
    # publication that is not already inside the flow's locks takes them for the
    # same reason the cleanup does, in the flow's own order.  Whichever writer
    # starts first finishes before the other can begin; a lock that is already
    # held means a writer owns the update root until it finishes, so this boot
    # leaves the records to the next one instead of racing it.
    ota_rollback_publish_terminal_locked()
    {
        resume_boot_id=$($BB cat /proc/sys/kernel/random/boot_id 2>/dev/null)
        ota_rollback_resume_lock || return 1
        ota_rollback_publish_terminal "$1"
        resume_publish_rc=$?
        ota_rollback_resume_unlock
        return "$resume_publish_rc"
    }

    # A rollback retires the live transaction before its terminal records are
    # published, so a power loss -- or a failed write -- in between leaves a
    # device whose only remaining evidence is the finalized `rolled-back`
    # history record.  No later boot re-enters the rollback branch, because the
    # transaction that branch retires is already gone, so the interrupted
    # cleanup and publication are completed here on every boot instead of
    # waiting for an operator, until both records are written.  Fail closed: a
    # live transaction keeps its own recovery path, and nothing is published
    # unless the history record names the slot that actually rolled back.
    ota_rollback_resume_terminal()
    {
        resume_state=$($BB sed -n 's/^state=//p' /data/libreecho/update/state 2>/dev/null)
        case "$resume_state" in
            restarting)
                # The failed candidate's restart record: its terminal state was
                # never published.
                case "$($BB sed -n 's/^detail=//p' /data/libreecho/update/state 2>/dev/null)" in
                    health-confirm-failed:*) ;;
                    *) return 0 ;;
                esac
                ;;
            rolled-back)
                # The terminal state is in place, so only its check record can
                # still be the frozen `reboot-pending` one.  A check record for
                # any other candidate is left to the publisher, which refuses to
                # relabel it.
                [ "$($BB sed -n 's/^status=//p' /data/libreecho/update/check-status 2>/dev/null)" = reboot-pending ] ||
                    return 0
                ;;
            reboot-pending|boot-validating)
                # A candidate that crashes -- or loses power -- on its boots can
                # exhaust its attempts before this worker reaches its restart
                # record, so the last progress record the failed candidate left
                # is either the installer's `reboot-pending` (written before the
                # reboot into the candidate) or the `boot-validating` record this
                # worker writes before its health checks.  Both are the failed
                # candidate's own records, and the evidence that its transaction
                # was retired is the finalized history record below, not this
                # progress record -- which is exactly the state a completed
                # confirmation overwrites (`state=installed`).
                ;;
            *)
                # A healthy device, a first install, or a state this worker
                # never wrote: leave it alone.
                return 0
                ;;
        esac
        # The helper only ever acts on a history record it validated as a
        # bounded regular non-symlink, and this resume authorizes the same
        # removals from that record, so it validates it the same way before it
        # reads anything out of it: a path that is a symlink -- for example one
        # pointing at the surviving live record -- or that is not a bounded
        # regular file is never rollback evidence, let alone authorization to
        # remove what it names.
        if ! ota_rollback_resume_history_bounded; then
            if [ -e "$resume_history" ] || [ -L "$resume_history" ]; then
                log ota-rollback-resume-history-unsafe
            else
                log ota-rollback-resume-evidence-invalid
            fi
            return 0
        fi
        resume_slot=$($BB sed -n 's/^slot=//p' "$resume_history" 2>/dev/null)
        case "$resume_slot" in
            a|b) ;;
            *)
                log ota-rollback-resume-evidence-invalid
                return 0
                ;;
        esac
        # A rollback leaves the previously confirmed slot running, which is the
        # pairing the rollback branch itself acts on: it retires the transaction
        # only while the slot it staged is not the slot that booted.  A history
        # record naming the slot that is running is therefore retained evidence
        # of an earlier rollback -- or of a confirmation this device already
        # finished -- and never a publication for this boot to complete.
        [ "$resume_slot" != "$selected_slot" ] || {
            log ota-rollback-resume-history-slot-still-selected
            return 0
        }
        # Which transaction the finalized history names, so the one-sided live
        # record left by an interrupted retirement can be matched to it.
        resume_transaction=$($BB sed -n 's/^transaction_id=//p' "$resume_history" 2>/dev/null)
        resume_schema=$($BB sed -n 's/^schema=//p' "$resume_history" 2>/dev/null)
        if [ -n "$resume_transaction" ]; then
            # The retirement and the staging tree are the two helper steps an
            # interruption can cut short, and the helper will not resume
            # either, so the terminal records are only published once both are
            # finished -- or the boot retries.  Both steps remove something
            # from the update root a concurrent installation stages into, so
            # they run under that installation's own locks, and every input
            # they act on is validated again under the lock: a lock that is
            # already held, a history or progress record that was replaced
            # while this boot was deciding, a staged shape the helper would
            # refuse, or residue the packaged helper cannot prove is this
            # rollback, all leave the records unpublished for the next boot
            # instead of removing something this rollback does not own.  The
            # boot id is what makes a lock this worker left behind by an earlier
            # power loss recoverable instead of permanent.
            resume_boot_id=$($BB cat /proc/sys/kernel/random/boot_id 2>/dev/null)
            ota_rollback_resume_lock || return 0
            if ! ota_rollback_resume_history_bounded; then
                log ota-rollback-resume-history-unsafe
                ota_rollback_resume_unlock
                return 0
            fi
            if ! ota_rollback_resume_records_unchanged; then
                ota_rollback_resume_unlock
                return 0
            fi
            if ota_rollback_resume_residue; then
                if ! ota_rollback_resume_live_records_check ||
                   ! ota_rollback_resume_staging_validate ||
                   ! ota_rollback_resume_rollback_evidence; then
                    ota_rollback_resume_unlock
                    return 0
                fi
                if ! ota_rollback_resume_live_records_remove ||
                   ! ota_rollback_resume_staging_cleanup; then
                    ota_rollback_resume_unlock
                    return 0
                fi
            fi
            # Both locks are still held through the publication above: it writes
            # the same `state.tmp`/`check-status.tmp` pair a concurrent check
            # and install write, and the records it reads were revalidated under
            # this same hold, so no other writer can rename over them between
            # this boot's decision and the write.  Releasing here -- before the
            # write -- is the race this hold exists to close.
            if ota_rollback_publish_terminal "$resume_slot"; then
                log "ota-rollback-terminal-publication-resumed:$resume_slot"
            else
                log ota-rollback-terminal-publication-retry-queued
            fi
            ota_rollback_resume_unlock
            return 0
        else
            # A legacy schema-1 rollback retires its transaction by moving the
            # pending record itself, so the record that survives an
            # interruption carries no transaction id and has no durable v2
            # journal beside it: the moved record is the rollback evidence and
            # the publication below is the whole of the remaining step, so
            # neither v2 cleanup is run for it -- the schema-1 branch does not
            # run them either.  Anything else without a transaction id is not
            # this worker's rollback record, and a surviving live record is a
            # transaction whose own recovery path owns those records.
            [ "$resume_schema" = 1 ] || {
                log ota-rollback-resume-evidence-invalid
                return 0
            }
            for resume_live in pending feature-commit; do
                [ ! -e "/data/libreecho/update/$resume_live" ] || {
                    log "ota-rollback-resume-live-record-present:$resume_live"
                    return 0
                }
            done
            log ota-rollback-resume-legacy-publication
        fi
        # The legacy record removes nothing, so it has no cleanup to serialize,
        # but the publication itself is the same pair of staging paths and takes
        # the flow's locks for the write.
        if ota_rollback_publish_terminal_locked "$resume_slot"; then
            log "ota-rollback-terminal-publication-resumed:$resume_slot"
        else
            log ota-rollback-terminal-publication-retry-queued
        fi
        return 0
    }

    running_slot=$($BB sed -n \
        's/.*androidboot.slot_suffix=_\([ab]\).*/\1/p' /proc/cmdline)
    case "$running_slot" in
        a|b)
            log "running-slot:$running_slot"
            selected_slot=$(/usr/local/sbin/libreecho-bootctl status "$running_slot" 2>/dev/null |
                $BB sed -n 's/^selected_slot=//p')
            ;;
        *)
            log running-slot-not-reported
            selected_slot=$(/usr/local/sbin/libreecho-bootctl status 2>/dev/null |
                $BB sed -n 's/^selected_slot=//p')
            ;;
    esac

    # This boot may be the first one after an interrupted finalization, and
    # every later boot would skip the rollback branch, so finish it before this
    # boot decides what it is for.  It runs once the running slot is known, so
    # the finalized history record it finds can be checked against the slot that
    # actually booted.
    ota_rollback_resume_terminal

    if [ -r /data/libreecho/update/pending ]; then
        CONFIRM_MODE=ota
        log ota-health-confirm-pending
        pmsg_marker ota-health-pending
        pending_slot=$($BB sed -n 's/^slot=//p' /data/libreecho/update/pending)
    else
        # A first install is a candidate confirmation: only a production boot
        # opens that transaction and confirms it.  A diagnostic OTA boot runs
        # the rollback half above -- there is no pending transaction here, so
        # nothing is skipped -- and must not leave behind a first-install
        # record it will never confirm.
        [ "$SERVICE_PROFILE" = production ] || {
            log ota-health-confirmation-skipped-non-production-profile
            return 0
        }
        if [ ! -r "$FIRST_INSTALL_MARKER" ] ||
           [ "$($BB sed -n 's/^schema=//p' "$FIRST_INSTALL_MARKER")" != 1 ] ||
           [ "$($BB sed -n 's/^mode=//p' "$FIRST_INSTALL_MARKER")" != first-install ] ||
           [ "$($BB sed -n 's/^board=//p' "$FIRST_INSTALL_MARKER")" != radar_puffin ]; then
            log first-install-marker-absent-or-invalid
            return 0
        fi
        CONFIRM_MODE=first-boot
        case "$selected_slot" in
            a|b) ;;
            *)
                log "first-boot-slot-unknown:$selected_slot"
                return 0
                ;;
        esac
        if [ "$(/usr/local/sbin/libreecho-bootctl status 2>/dev/null |
            $BB sed -n "s/^slot_${selected_slot}_success=//p")" = 1 ]; then
            log "first-boot-slot-already-confirmed:$selected_slot"
            return 0
        fi
        if [ "$selected_slot" = a ]; then
            payload_device=/dev/mmcblk0p10
        else
            payload_device=/dev/mmcblk0p11
        fi
        payload_hash=$($BB sha256sum "$payload_device" 2>/dev/null |
            $BB awk '{print $1}')
        case "$payload_hash" in
            ''|*[!0-9a-f]*)
                log first-install-payload-hash-unavailable
                return 0
                ;;
        esac
        first_install_pending=/data/libreecho/update/first-install.pending
        if [ -r "$first_install_pending" ]; then
            recorded_slot=$($BB sed -n 's/^slot=//p' "$first_install_pending")
            recorded_hash=$($BB sed -n 's/^boot_sha256=//p' "$first_install_pending")
            if [ "$recorded_slot" != "$selected_slot" ] || [ "$recorded_hash" != "$payload_hash" ]; then
                log first-install-transaction-invalid
                return 0
            fi
        else
            {
                echo schema=1
                echo state=pending
                echo mode=first-install
                echo "slot=$selected_slot"
                echo "boot_sha256=$payload_hash"
            } > "$first_install_pending.tmp" &&
                $BB mv "$first_install_pending.tmp" "$first_install_pending" || {
                    log first-install-transaction-write-failed
                    return 0
                }
            $BB sync
            log "first-install-transaction-created:$selected_slot:$payload_hash"
        fi
        log "first-boot-confirm-pending:$selected_slot"
        pending_slot=$selected_slot
    fi
    case "$pending_slot:$selected_slot" in
        a:a|b:b) ;;
        a:b|b:a)
            if [ "$($BB sed -n 's/^schema=//p' /data/libreecho/update/pending 2>/dev/null)" = 2 ]; then
                if [ -r /data/libreecho/update/feature-commit ]; then
                    # The helper acts inside the update root a UI-triggered
                    # check or install stages into: it records its fallback
                    # history, retires the live pair, and only then removes the
                    # staged tree, while `libreecho-update-fetch` may be holding
                    # the boot-local fetch lock and downloading a replacement
                    # tree into that same `staging` path.  Its removals would
                    # therefore delete an active download, or leave a newly
                    # prepared transaction without its staged artifacts, so the
                    # whole sequence -- the bootctl readback written into
                    # staging, `fallback` itself, and the postcondition that
                    # validates it -- runs under the update flow's own two
                    # locks, taken in the order it takes them, and they are held
                    # through the terminal publication that follows, which
                    # writes the same `state.tmp`/`check-status.tmp` pair a
                    # concurrent writer renames.  A writer that already holds
                    # them owns the update root until it finishes, so this boot
                    # leaves the records to the next boot's resume instead of
                    # racing it.
                    resume_boot_id=$($BB cat /proc/sys/kernel/random/boot_id 2>/dev/null)
                    if ! ota_rollback_resume_lock; then
                        log ota-v2-fallback-preserved-for-recovery
                        return 0
                    fi
                    $BB mkdir -p /data/libreecho/update/staging
                    if /usr/local/sbin/libreecho-bootctl status > /data/libreecho/update/staging/bootctl.readback 2>/dev/null &&
                       /usr/local/sbin/libreecho-feature-transaction fallback &&
                       ota_v2_fallback_confirmed; then
                        # Both locks are still held across this write: the
                        # publication is inside the same hold as the helper and
                        # its postcondition, so no other writer can rename over
                        # either record between this boot's decision and it.
                        if ota_rollback_publish_terminal "$pending_slot"; then
                            log "ota-v2-fallback-cleaned:$pending_slot:$selected_slot"
                        else
                            log ota-rollback-terminal-publication-retry-queued
                        fi
                        # Released exactly once, on every path out of the hold.
                        ota_rollback_resume_unlock
                        return 0
                    fi
                    # The helper refused, or its postcondition did not hold:
                    # nothing was published, the records stay exactly as they
                    # were found for recovery, and the locks are given back.
                    ota_rollback_resume_unlock
                fi
                # The durable v2 journal is what makes a staged candidate
                # prepared and activatable evidence.  Without it this record is
                # the one-sided intent an interrupted intent publish leaves,
                # which the update flow rebuilds on a retry -- not rollback
                # evidence.  Retiring it as a rollback below would publish a
                # finalization that never happened while the staged tree still
                # holds the candidate, so fail closed and leave both records for
                # recovery instead.
                log ota-v2-fallback-preserved-for-recovery
                return 0
            fi
            # A schema-1 transaction has no journal to retire; the pending
            # record is itself the rollback evidence, so move it and publish
            # the same terminal status -- under the same locks, for the same
            # staged-path race.
            $BB mv /data/libreecho/update/pending \
                /data/libreecho/update/rolled-back
            if ota_rollback_publish_terminal_locked "$pending_slot"; then
                log "ota-rollback-complete:$pending_slot:$selected_slot"
            else
                log ota-rollback-terminal-publication-retry-queued
            fi
            return 0
            ;;
        *)
            log "ota-health-slot-state-invalid:$pending_slot:$selected_slot"
            return 0
            ;;
    esac
    # The exclusion policy disables candidate feature-health confirmation: an
    # `exclude` image carries no feature graph to validate.  Rollback detection
    # and finalization above are not feature health -- they retire a failed
    # candidate's transaction and publish the rollback's terminal status -- so
    # they must run for every supported policy.  Returning here instead of at
    # the top of the worker is what keeps the accepted `exclude:diagnostic`
    # combination installable: an earlier return skipped the fallback branch
    # and the resumed cleanup, leaving `pending`/`feature-commit`/staging live
    # forever, and `transaction_pending()` then rejects every later install.
    [ "$FEATURE_POLICY" != exclude ] || {
        log ota-health-feature-validation-skipped-by-exclusion-policy
        return 0
    }
    # Candidate confirmation -- the health-probe progress record, the probes,
    # the `confirm` call and the restart below -- is production-only.  The
    # launcher starts this worker on every OTA boot because the rollback
    # detection and finalization above run for every supported service profile,
    # and it stops here: a diagnostic slot is deliberately left pending and
    # unconfirmed for the operator to inspect and recover through the guarded
    # OTA flow.
    [ "$SERVICE_PROFILE" = production ] || {
        log ota-health-confirmation-skipped-non-production-profile
        return 0
    }
    if [ "$CONFIRM_MODE" = ota ]; then
        {
            echo schema=1
            echo state=boot-validating
            echo progress=95
            echo detail=health-checks
        } > /data/libreecho/update/state.tmp &&
            $BB mv /data/libreecho/update/state.tmp /data/libreecho/update/state
        $BB sync
    fi

    # True when this device has no local voice stack to wait for.
    #
    # Deliberately derived from the mounted feature set rather than from
    # configuration: the health worker starts before the web daemon, so any
    # check that reads a service-managed config file is racing service startup.
    # The feature mounts are established by this script itself, before the
    # worker runs, so they are a stable signal at probe time.
    #
    # If the stt/tts/assistant payloads are not mounted, libreecho-sttd,
    # libreecho-ttsd and libreecho-agentd cannot run and their sockets can
    # never appear -- so waiting for them only guarantees a rollback.  The
    # persisted config is consulted second, purely to log intent.
    voice_stack_absent()
    {
        # Test the mount, not the directory: the per-feature init scripts run
        # mkdir -p "$RUNTIME_ROOT" before attempting to mount the payload, so
        # the directory exists even when the mount never succeeded and the
        # daemon never started.
        for vs_feature in stt tts assistant; do
            if $BB grep -q " /run/libreecho/features/$vs_feature/root " \
                    /proc/mounts 2>/dev/null; then
                log "ota-health-voice-stack-present:$vs_feature"
                return 1
            fi
        done
        vp_config=/data/libreecho/config/web-config.json
        vp_mode=
        if [ -r "$vp_config" ]; then
            vp_mode=$($BB sed -n \
                's/.*"voice_pipeline_mode"[[:space:]]*:[[:space:]]*"\([a-z_-]*\)".*/\1/p' \
                "$vp_config" 2>/dev/null | $BB head -n 1)
        fi
        case "$vp_mode" in
            custom|home-assistant)
                log "ota-health-voice-stack-absent-remote:$vp_mode"
                return 0
                ;;
            local|'')
                log "ota-health-voice-stack-missing-local:${vp_mode:-unknown}"
                return 1
                ;;
            *)
                log "ota-health-voice-stack-mode-invalid:$vp_mode"
                return 1
                ;;
        esac
    }

    startup_ready_marker_valid()
    {
        [ -r "$STARTUP_READY" ] || return 1
        [ "$($BB sed -n 's/^schema=//p' "$STARTUP_READY" 2>/dev/null)" = 1 ] || return 1
        return 0
    }

    service_process_ready()
    {
        service=$1
        socket=$2
        script="/etc/init.d/libreecho-$service.init"
        pidfile="/var/run/libreecho-$service.pid"
        [ -x "$script" ] || return 1
        "$script" status >/dev/null 2>&1 || return 1
        [ -s "$pidfile" ] || return 1
        pid=$($BB sed -n '1p' "$pidfile" 2>/dev/null)
        case "$pid" in ''|*[!0-9]*) return 1 ;; esac
        $BB kill -0 "$pid" 2>/dev/null || return 1
        [ -S "$socket" ] || return 1
        $BB awk -v socket="$socket" \
            '$NF == socket { found=1 } END { exit found ? 0 : 1 }' \
            /proc/net/unix >/dev/null 2>&1 || return 1
        return 0
    }

    led_handoff_ready()
    {
        service_process_ready ledd /run/libreecho/led.sock || {
            log led-handoff-not-ready
            return 1
        }
        return 0
    }

    shared_discovery_ready()
    {
        # The service wrapper now probes the supervisor's STATUS/1 contract,
        # which is successful only when D-Bus, Avahi and the private bus socket
        # are live. Keep the explicit host-visible socket check as a second
        # independent assertion and use the actual chroot runtime path.
        [ -x /etc/init.d/libreecho-mdnsd.init ] || return 1
        /etc/init.d/libreecho-mdnsd.init status >/dev/null 2>&1 || return 1
        [ -S "$MDNS_RUNTIME_ROOT/run/dbus/system_bus_socket" ] || return 1
        return 0
    }

    home_assistant_integration_enabled()
    {
        config=/data/libreecho/config/web-config.json
        integrations=
        if [ -r "$config" ]; then
            integrations=$($BB sed -n \
                's/.*"integrations"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
                "$config" 2>/dev/null | $BB head -n 1)
        fi
        case "$integrations" in
            ''|*[!0-9]*) return 1 ;;
            *) [ $((integrations & 1)) -ne 0 ] ;;
        esac
    }

    ota_health_services_ready()
    {
        [ "$SERVICE_PROFILE" = production ] || return 0
        startup_ready_marker_valid || {
            log startup-ready-marker-missing
            return 1
        }
        for required_service in \
            "networkd /run/libreecho/network.sock" \
            "audiod /run/libreecho/audio.sock" \
            "micd /run/libreecho/mic.sock" \
            "btd /run/libreecho/bluetooth.sock"; do
            service_name=${required_service%% *}
            service_socket=${required_service#* }
            service_process_ready "$service_name" "$service_socket" || {
                log "ota-health-services-not-ready:$service_name"
                return 1
            }
        done
        health_config=/data/libreecho/config/web-config.json
        health_integrations=
        if [ -r "$health_config" ]; then
            health_integrations=$($BB sed -n \
                's/.*"integrations"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
                "$health_config" 2>/dev/null | $BB head -n 1)
        fi
        case "$health_integrations" in
            ''|*[!0-9]*)
                # An unreadable config keeps the historical fail-closed graph.
                health_airplay_enabled=1
                health_discovery_enabled=1
                ;;
            *)
                health_airplay_enabled=0
                health_discovery_enabled=0
                [ $((health_integrations & 16)) -ne 0 ] && health_airplay_enabled=1
                # Home Assistant discovery no longer derives its requirement
                # from the AirPlay audio bit: the boot-contained shared
                # responder provides discovery, so an HA-selected system with
                # no AirPlay payload must not be asked for airplay.sock or the
                # AirPlay squashfs.  A both-off system waits for no consumer
                # registration at all.
                [ $((health_integrations & 1)) -ne 0 ] && health_discovery_enabled=1
                [ "$health_airplay_enabled" -eq 1 ] && health_discovery_enabled=1
                ;;
        esac
        if [ "$health_airplay_enabled" -eq 1 ]; then
            service_process_ready airplayd /run/libreecho/airplay.sock || {
                log ota-health-services-not-ready:airplayd
                return 1
            }
        fi
        if [ "$health_discovery_enabled" -eq 1 ]; then
            shared_discovery_ready || {
                log ota-health-shared-discovery-not-ready
                pmsg_marker mdns-health-not-ready
                return 1
            }
        fi
        led_handoff_ready || return 1
        if home_assistant_integration_enabled; then
            wyoming_pidfile=/var/run/libreecho-wyomingd.pid
            [ -s "$wyoming_pidfile" ] || {
                log ota-health-services-not-ready:wyomingd
                return 1
            }
            wyoming_pid=$($BB sed -n '1p' "$wyoming_pidfile" 2>/dev/null)
            case "$wyoming_pid" in ''|*[!0-9]*) return 1 ;; esac
            $BB kill -0 "$wyoming_pid" 2>/dev/null || {
                log ota-health-services-not-ready:wyomingd
                return 1
            }
            $BB awk -v port=29CC \
                '$4 == "0A" && $2 ~ (":" port "$") { found=1 } END { exit found ? 0 : 1 }' \
                /proc/net/tcp 2>/dev/null || {
                    log ota-health-services-not-ready:wyomingd
                    return 1
                }
            return 0
        fi
        if [ -S /run/libreecho/stt.sock ] &&
           [ -S /run/libreecho/tts.sock ] &&
           [ -S /run/libreecho/agent.sock ]; then
            for required_service in \
                "sttd /run/libreecho/stt.sock" \
                "ttsd /run/libreecho/tts.sock" \
                "agentd /run/libreecho/agent.sock"; do
                service_name=${required_service%% *}
                service_socket=${required_service#* }
                service_process_ready "$service_name" "$service_socket" || {
                    log "ota-health-services-not-ready:$service_name"
                    return 1
                }
            done
            return 0
        fi

        # A payload-free diagnostic/preserve state can intentionally have no
        # selected local voice graph. The Home Assistant branch has already
        # returned above and therefore can never use this fallback.
        if voice_stack_absent; then
            return 0
        fi
        # A device whose voice pipeline is served by remote Wyoming endpoints
        # never mounts the local stt/tts/assistant features, so none of the
        # sockets above can exist and neither branch can ever pass.  Requiring
        # them would make every OTA on such a device fail confirmation and roll
        # back, even when the image is completely healthy.  Voice is not what
        # makes a slot recoverable -- /data, networking and the web/API plane
        # are, and those are already checked.
        if voice_stack_absent; then
            return 0
        fi
        log ota-health-services-not-ready:voice-sockets
        return 1
    }

    # Do not spend the bounded confirmation attempts on services that are still
    # in their normal boot sequence. The web init script publishes STARTUP_READY
    # only after the selected core graph is ready, so wait for that boundary
    # first. The previous fixed 45-second delay began consuming attempts while
    # 0.14 was still starting, which hardware evidence showed as three early
    # web-status failures before the daemon became healthy.
    attempt=0
    passed=0
    last_check=unknown
    startup_wait=0
    log ota-health-waiting-startup-ready
    pmsg_marker ota-waiting-startup-ready
    while ! startup_ready_marker_valid && [ "$startup_wait" -lt 180 ]; do
        $BB sleep 5
        startup_wait=$((startup_wait + 5))
    done
    if ! startup_ready_marker_valid; then
        last_check=startup-ready
        log ota-health-startup-ready-timeout
        pmsg_marker ota-startup-ready-timeout
    else
        log "ota-health-startup-ready:$startup_wait"
        pmsg_marker ota-startup-ready
        # Require the persistent filesystem, ADB control plane, web service,
        # and complete selected service graph to remain healthy across three
        # probes before making the slot permanent.
        while [ "$attempt" -lt 6 ] && [ "$passed" -lt 3 ]; do
            attempt=$((attempt + 1))
            if ! $BB grep -q ' /data ' /proc/mounts 2>/dev/null; then
                last_check=data-mount
            elif [ "${ffs_ready:-0}" -ne 1 ]; then
                last_check=ffs-ready
            elif ! /etc/init.d/libreecho-web.init status >/dev/null 2>&1; then
                last_check=web-status
            elif ! ota_health_services_ready; then
                last_check=services-ready
            else
                last_check=none
            fi
            if [ "$last_check" != none ]; then
                passed=0
                log "ota-health-probe-failed:$attempt:$last_check"
                pmsg_marker "ota-probe-failed-$last_check"
                $BB sleep 30
                continue
            fi
            passed=$((passed + 1))
            log "ota-health-probe-passed:$passed"
            pmsg_marker "ota-probe-passed-$passed"
            [ "$passed" -lt 3 ] && $BB sleep 15
        done
    fi

    if [ "$CONFIRM_MODE" = first-boot ]; then
        if [ "$passed" -eq 3 ] &&
           /usr/local/sbin/libreecho-bootctl confirm "$selected_slot" \
               >/tmp/first-boot-confirm.log 2>&1; then
            first_install_confirmed=/data/libreecho/update/first-install.confirmed.tmp
            if $BB sed 's/^state=pending$/state=confirmed/' \
                    /data/libreecho/update/first-install.pending > "$first_install_confirmed" &&
               $BB mv "$first_install_confirmed" \
                    /data/libreecho/update/first-install.confirmed; then
                $BB rm -f /data/libreecho/update/first-install.pending
                $BB sync
                log "first-boot-slot-confirmed:$selected_slot"
                pmsg_marker first-boot-confirmed
                return 0
            fi
            $BB rm -f "$first_install_confirmed"
            log first-install-confirmation-record-finalization-failed
            return 0
        fi
        # Never restart after a failed first boot: there is no previously
        # confirmed slot to fall back to, so a reboot could only repeat this
        # outcome and would burn the remaining try counter.
        log "first-boot-confirm-failed:$last_check"
        pmsg_marker "first-boot-confirm-failed-$last_check"
        return 0
    fi

    if [ "$passed" -eq 3 ] &&
       /usr/local/sbin/libreecho-update confirm >/tmp/ota-confirm.log 2>&1; then
        log ota-slot-confirmed
        pmsg_marker ota-slot-confirmed
        return 0
    fi
    log ota-health-confirm-failed-rebooting
    pmsg_marker "ota-confirm-failed-$last_check"
    failure_log=$(persist_failure_log ota-health-confirm-failed "$last_check" 2>/dev/null) || failure_log=
    # Issue #41: leave persistent evidence for why this worker restarted the
    # device.  The record lives on the persistent userdata filesystem (not
    # tmpfs), is written atomically and synced before the reboot, and is
    # surfaced by `libreecho-update status`.  This keeps a health-worker
    # restart distinguishable from a genuine hardware watchdog reset.
    {
        echo schema=1
        echo reason=ota-health-confirm-failed
        echo last_check=$last_check
        echo attempts=$attempt
        echo passed=$passed
        echo pending_slot=$pending_slot
        echo selected_slot=$selected_slot
        echo epoch=$(date -u +%s)
        echo "failure_log=${failure_log:-none}"
    } > /data/libreecho/update/restart-record.tmp &&
        $BB mv /data/libreecho/update/restart-record.tmp \
            /data/libreecho/update/restart-record
    {
        echo schema=1
        echo state=restarting
        echo progress=0
        echo detail=health-confirm-failed:$last_check
    } > /data/libreecho/update/state.tmp &&
        $BB mv /data/libreecho/update/state.tmp /data/libreecho/update/state
    $BB sync
    pmsg_marker ota-rebooting-after-health-failure
    $BB sleep 2
    $BB reboot -f
}
# The worker is launched for every OTA boot, not only a production one.  Its
# rollback half is not candidate health: retiring a failed candidate's
# transaction and publishing the rollback's terminal status must run on the
# boot after the bootloader fell back whatever the service profile is, or
# `pending`, `feature-commit` and the staged tree stay live and the update
# flow's `transaction_pending()` then rejects every later installation.  The
# candidate-confirmation half stays production-only inside the worker, so a
# diagnostic slot is still left pending and unconfirmed for the operator.
if [ "$IMAGE_PROFILE" = ota ]; then
    ota_health_confirm_worker &
    log ota-background-worker-started
else
    log ota-background-workers-disabled-for-non-ota-profile
fi

# Audio playback is always user-initiated.  In particular, boot must never
# touch the codec, amplifier, or TinyALSA playback device.  This is a hard
# policy rather than an optional marker so future images remain silent even if
# an old audio asset is accidentally present in an overlay or persistent store.
log audio-startup-disabled

# The single automatic connectivity activation runs on the boot path above.
# Nothing here starts the network, so a profile-bearing image cannot launch it
# twice; the diagnostic/manual policy is enforced at that one site.

# Android init remains PID 1.  Keep this service alive so the runme loop and
# recovery diagnostics survive optional driver failures.
# sleep in the background and wait for it: a trap only runs between commands,
# so a foreground sleep would sit on a signal for up to an hour before the
# handler fired.  wait is interruptible, so the transition is immediate.
while true; do
    $BB sleep 3600 &
    wait $!
done
