#!/bin/busybox sh
# Reconcile persisted feature payloads after installation has finished staging.
# PID1 invokes this during boot; the final setup process invokes it again after
# applying setup settings and Wi-Fi.  Each feature init script mounts its
# squashfs runtime before starting its daemon.

BB=${BB:-/bin/busybox}
ETC_ROOT=${FEATURE_RECONCILE_ETC_ROOT:-/etc}
DATA_ROOT=${FEATURE_RECONCILE_DATA_ROOT:-/data}
RUN_ROOT=${FEATURE_RECONCILE_RUN_ROOT:-/run}
VAR_RUN_ROOT=${FEATURE_RECONCILE_VAR_RUN_ROOT:-/var/run}
INIT_ROOT=${FEATURE_RECONCILE_INIT_ROOT:-/etc/init.d}
PROC_NET_UNIX=${FEATURE_RECONCILE_PROC_NET_UNIX:-/proc/net/unix}
LOG_FILE=${FEATURE_RECONCILE_LOG_FILE:-/tmp/init.log}
KMSG=${FEATURE_RECONCILE_KMSG:-/dev/kmsg}
CONSOLE=${FEATURE_RECONCILE_CONSOLE:-/dev/console}
LOCK=$RUN_ROOT/libreecho/reconcile-features.lock
LOCK_TIMEOUT_SECONDS=${FEATURE_RECONCILE_LOCK_TIMEOUT_SECONDS:-120}
READY_TIMEOUT_SECONDS=${FEATURE_RECONCILE_READY_TIMEOUT_SECONDS:-30}

log()
{
    msg="libreecho-feature-reconcile: $*"
    printf '%s\n' "$*" >> "$LOG_FILE"
    printf '<6>%s\n' "$msg" > "$KMSG" 2>/dev/null
    printf '%s\n' "$msg" > "$CONSOLE" 2>/dev/null
}

acquire_lock()
{
    elapsed=0
    while ! $BB mkdir "$LOCK" 2>/dev/null; do
        owner=$($BB cat "$LOCK/pid" 2>/dev/null)
        case "$owner" in
            ''|*[!0-9]*)
                # mkdir is atomic, but the owner file is written immediately
                # afterwards.  Do not remove a lock during that small window.
                if [ "$elapsed" -ge "$LOCK_TIMEOUT_SECONDS" ]; then
                    log feature-reconcile-lock-owner-missing
                    $BB rm -rf "$LOCK" 2>/dev/null || return 1
                else
                    $BB sleep 1
                    elapsed=$((elapsed + 1))
                fi
                continue
                ;;
            *)
                if $BB kill -0 "$owner" 2>/dev/null; then
                    if [ "$elapsed" -ge "$LOCK_TIMEOUT_SECONDS" ]; then
                        log "feature-reconcile-lock-timeout:$owner"
                        return 1
                    fi
                    $BB sleep 1
                    elapsed=$((elapsed + 1))
                    continue
                fi
                ;;
        esac
        $BB rm -rf "$LOCK" 2>/dev/null || {
            log feature-reconcile-lock-remove-failed
            return 1
        }
    done
    printf '%s\n' "$$" > "$LOCK/pid" || {
        $BB rm -rf "$LOCK"
        log feature-reconcile-lock-owner-write-failed
        return 1
    }
    return 0
}

release_lock()
{
    $BB rm -rf "$LOCK" 2>/dev/null
}

read_policy()
{
    SERVICE_PROFILE_VALUE=$($BB cat "$ETC_ROOT/libreecho/service-profile" 2>/dev/null)
    SERVICE_PROFILE=diagnostic
    case "$SERVICE_PROFILE_VALUE" in
        production) SERVICE_PROFILE=production ;;
    esac

    FEATURE_POLICY_VALUE=$($BB cat "$ETC_ROOT/libreecho/feature-policy" 2>/dev/null)
    FEATURE_POLICY=exclude
    case "$FEATURE_POLICY_VALUE" in
        preserve|redistributable|community-noncommercial|exclude)
            FEATURE_POLICY=$FEATURE_POLICY_VALUE
            ;;
    esac
}

select_topology()
{
    ha_enabled=0
    config=$DATA_ROOT/libreecho/config/web-config.json
    if [ -r "$config" ]; then
        integrations=$($BB sed -n \
            's/^[[:space:]]*"integrations"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*$/\1/p' \
            "$config" 2>/dev/null | $BB head -n 1)
        case "$integrations" in
            ''|*[!0-9]*) ;;
            *) [ $((integrations & 1)) -ne 0 ] && ha_enabled=1 ;;
        esac
    fi

    if [ "$ha_enabled" -eq 1 ]; then
        case "$FEATURE_POLICY" in
            preserve|community-noncommercial)
                persisted_features="wakeword airplay2"
                ;;
            *)
                persisted_features=airplay2
                ;;
        esac
    else
        case "$FEATURE_POLICY" in
            preserve|community-noncommercial)
                persisted_features="wakeword stt airplay2 tts assistant"
                ;;
            *)
                persisted_features="stt airplay2 tts assistant"
                ;;
        esac
    fi
}

feature_service_ready()
{
    service=$1
    socket=$2
    script=$INIT_ROOT/libreecho-$service.init
    pidfile=$VAR_RUN_ROOT/libreecho-$service.pid
    [ -x "$script" ] || return 1
    "$script" status >/dev/null 2>&1 || return 1
    [ -s "$pidfile" ] || return 1
    pid=$($BB sed -n '1p' "$pidfile" 2>/dev/null)
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    $BB kill -0 "$pid" 2>/dev/null || return 1
    [ -S "$socket" ] || return 1
    $BB awk -v socket="$socket" \
        '$NF == socket { found=1 } END { exit found ? 0 : 1 }' \
        "$PROC_NET_UNIX" >/dev/null 2>&1 || return 1
    return 0
}

airplay_explicitly_disabled()
{
    config=$DATA_ROOT/libreecho/config/web-config.json
    [ -r "$config" ] || return 1
    integrations=$($BB sed -n \
        's/.*"integrations"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
        "$config" 2>/dev/null | $BB sed -n '1p')
    case "$integrations" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ $((integrations & 16)) -eq 0 ]
}

stop_disabled_airplay()
{
    service=airplayd
    script=$INIT_ROOT/libreecho-$service.init
    pidfile=$VAR_RUN_ROOT/libreecho-$service.pid
    socket=$RUN_ROOT/libreecho/airplay.sock
    [ -x "$script" ] || {
        log feature-reconcile-service-missing:airplayd
        return 1
    }
    "$script" stop >/tmp/libreecho-airplayd.reconcile.log 2>&1 || {
        log feature-reconcile-service-stop-failed:airplayd
        return 1
    }
    if "$script" status >/dev/null 2>&1 || [ -e "$pidfile" ] || [ -S "$socket" ]; then
        log feature-reconcile-service-still-running:airplayd
        return 1
    fi
    log feature-reconcile-service-disabled:airplayd
    return 0
}

start_feature()
{
    feature=$1
    case "$feature" in
        airplay2) service=airplayd; socket=$RUN_ROOT/libreecho/airplay.sock ;;
        stt) service=sttd; socket=$RUN_ROOT/libreecho/stt.sock ;;
        tts) service=ttsd; socket=$RUN_ROOT/libreecho/tts.sock ;;
        assistant) service=agentd; socket=$RUN_ROOT/libreecho/agent.sock ;;
        wakeword) service=waked; socket=$RUN_ROOT/libreecho/wakeword.sock ;;
        *) log "feature-reconcile-unknown-feature:$feature"; return 1 ;;
    esac
    if [ "$feature" = airplay2 ] && airplay_explicitly_disabled; then
        log feature-reconcile-airplay-disabled
        stop_disabled_airplay
        return $?
    fi

    payload=$DATA_ROOT/libreecho/features/$feature/payload.squashfs
    if [ ! -f "$payload" ]; then
        log "feature-reconcile-payload-missing:$feature"
        return 1
    fi
    feature_root=${payload%/payload.squashfs}
    if [ -d "$feature_root/staging" ]; then
        log "feature-reconcile-staging-present:$feature"
        return 1
    fi

    script=$INIT_ROOT/libreecho-$service.init
    if [ ! -x "$script" ]; then
        log "feature-reconcile-service-missing:$service"
        return 1
    fi
    "$script" start >/tmp/libreecho-"$service".reconcile.log 2>&1
    rc=$?
    if [ "$rc" -ne 0 ]; then
        log "feature-reconcile-service-start-failed:$service:$rc"
        return 1
    fi

    ready_count=0
    while [ "$ready_count" -lt "$READY_TIMEOUT_SECONDS" ]; do
        feature_service_ready "$service" "$socket" && {
            log "feature-reconcile-service-ready:$service"
            return 0
        }
        $BB sleep 1
        ready_count=$((ready_count + 1))
    done
    if feature_service_ready "$service" "$socket"; then
        log "feature-reconcile-service-ready:$service"
        return 0
    fi
    log "feature-reconcile-service-not-ready:$service"
    return 1
}

reconcile()
{
    read_policy
    if [ "$SERVICE_PROFILE" != production ] || [ "$FEATURE_POLICY" = exclude ]; then
        log "feature-reconcile-skipped:$SERVICE_PROFILE:$FEATURE_POLICY"
        return 0
    fi
    select_topology
    failed=0
    for feature in $persisted_features; do
        start_feature "$feature" || failed=1
    done
    if [ "$failed" -ne 0 ]; then
        log feature-services-reconcile-failed
        return "$failed"
    fi
    log feature-services-reconciled
    return 0
}

$BB mkdir -p "$RUN_ROOT/libreecho"
acquire_lock || exit 1
reconcile
rc=$?
release_lock
exit "$rc"
